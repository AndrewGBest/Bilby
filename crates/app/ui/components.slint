import { Theme } from "theme.slint";
import { AppCard, OptionRow, LibraryRow, Store } from "types.slint";

export component AppIcon inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <image> icon;
    in property <length> size: 44px;
    property <bool> has-picture: icon.width > 0;
    width: size;
    height: size;
    border-radius: size * 0.26;
    clip: true;
    // Until (or unless) a picture arrives: the app's initials on its own colour.
    background: has-picture ? Theme.surface-2 : @linear-gradient(135deg, tint.brighter(25%) 0%, tint.darker(35%) 100%);
    if !has-picture : Text {
        text: initials;
        color: white;
        font-size: size * 0.4;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if has-picture : Image {
        source: icon;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.text-dim;
    in property <length> font-size: 11px;
    height: font-size * 2;
    border-radius: self.height / 2;
    background: tone.with-alpha(0.14);
    HorizontalLayout {
        padding-left: root.font-size * 0.8;
        padding-right: root.font-size * 0.8;
        Text {
            text: root.text;
            color: tone;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A chip that can be pressed: category filters, recent searches.
export component ChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: 16px;
    background: selected ? Theme.accent : ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: selected ? 0px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    animate background { duration: 100ms; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: selected ? Theme.on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    // 0 to 1 while the button's own action is under way: it fills like a progress bar.
    in property <float> progress: -1;
    callback clicked;
    height: font-size * 2.9;
    border-radius: 10px;
    clip: root.progress >= 0;
    // Pressing gives a little, as a real button does.
    transform-scale: ta.pressed && root.enabled ? 0.96 : 1;
    animate transform-scale { duration: Theme.quick; easing: ease-out; }
    if root.progress >= 0 : Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0.03, 1.0);
        height: parent.height;
        background: Theme.accent.with-alpha(0.32);
        animate width { duration: Theme.smooth; easing: ease-out; }
    }
    background: !enabled ? Theme.surface-2 : primary ? (ta.pressed ? Theme.accent.darker(15%) : ta.has-hover ? Theme.accent.brighter(8%) : Theme.accent) : (ta.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: fs.has-focus ? 2px : primary ? 0px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    animate background { duration: Theme.quick; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: root.font-size * 1.4;
        padding-right: root.font-size * 1.4;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-dim : root.primary ? Theme.on-accent : root.danger ? Theme.bad : Theme.text;
            font-size: root.font-size;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// An activity bar for work of unknown length.
export component Busy inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.surface-2;
    clip: true;
    property <float> t: mod(animation-tick() / 1.4s, 1.0);
    Rectangle {
        x: parent.width * (t * 1.4 - 0.4);
        width: parent.width * 0.4;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

// How far along a download or an update is. When the amount is not known (Flatpak
// does not say), a band travels across instead of a bar filling.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    property <bool> unknown: root.value <= 0.01;
    property <float> t: Theme.reduce-motion ? 0.3 : mod(animation-tick() / 1.3s, 1.0);
    height: 6px;
    border-radius: 3px;
    background: Theme.surface-2;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: round(root.value * 100) + "%";
    fill := Rectangle {
        x: root.unknown ? parent.width * (root.t * 1.4 - 0.4) : 0;
        width: root.unknown ? parent.width * 0.4 : parent.width * clamp(root.value, 0.02, 1.0);
        border-radius: 3px;
        background: Theme.accent;
        clip: true;
        animate width { duration: Theme.smooth; easing: ease-out; }
        // A soft highlight passing over the bar says "still working" between steps.
        if !root.unknown && !Theme.reduce-motion : Rectangle {
            x: fill.width * (root.t * 1.5 - 0.25);
            width: 48px;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
        }
    }
}

// The moment something finishes: a tick that pops in. A failure gets a plain mark.
export component DoneMark inherits Rectangle {
    in property <bool> ok: true;
    property <bool> ready: false;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: root.ok ? Theme.ok : Theme.bad;
    transform-scale: root.ready ? 1 : 0.3;
    opacity: root.ready ? 1 : 0;
    accessible-role: none;
    animate transform-scale { duration: Theme.slow; easing: ease-out-back; }
    animate opacity { duration: Theme.quick; }
    Timer {
        interval: 20ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
    Text { text: root.ok ? "✓" : "!"; color: Theme.bg; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
}

// A page that eases in when it is shown: it fades up a few pixels, the way screens
// arrive on a phone. Leaving is immediate, so nothing lingers.
export component Appear inherits Rectangle {
    in property <bool> shown;
    visible: root.shown;
    inner := Rectangle {
        y: 12px;
        width: parent.width;
        height: parent.height;
        opacity: 0;
        @children
    }
    states [
        on when root.shown: {
            inner.opacity: 1;
            inner.y: 0px;
            in {
                animate inner.opacity, inner.y { duration: Theme.smooth; easing: ease-out; }
            }
        }
    ]
}

// The same for something that only exists while it is shown.
export component FadeIn inherits Rectangle {
    property <bool> ready: false;
    opacity: root.ready ? 1 : 0;
    animate opacity { duration: Theme.smooth; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.accent : Theme.surface-2;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }
    animate background { duration: 120ms; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggled(!root.checked); }
        }
    }
    Rectangle {
        x: checked ? parent.width - self.width - 3px : 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: checked ? Theme.on-accent : Theme.text-dim;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search apps";
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function grab-focus() {
        input.focus();
        input.select-all();
    }
    height: 42px;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.stroke;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/search.svg");
                colorize: Theme.text-dim;
                width: 18px;
                height: 18px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if input.text == "" : Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                accessible-label: "Search";
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
        if input.text != "" : Rectangle {
            width: 28px;
            accessible-role: button;
            accessible-label: "Clear search";
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    input.text = "";
                    root.edited("");
                    input.focus();
                }
            }
            Text { text: "✕"; color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Card used in the desktop grid.
export component AppTile inherits Rectangle {
    in property <AppCard> app;
    callback clicked;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.focus : ta.has-hover ? Theme.accent.with-alpha(0.5) : Theme.stroke;
    accessible-role: button;
    accessible-label: app.name;
    accessible-description: app.summary;
    accessible-action-default => { root.clicked(); }
    transform-scale: ta.pressed ? 0.985 : ta.has-hover ? 1.012 : 1;
    animate background, border-color { duration: Theme.quick; }
    animate transform-scale { duration: Theme.quick; easing: ease-out; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: app.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                Text { text: app.author; color: Theme.text-dim; font-size: 12px; overflow: elide; }
            }
        }
        // The description takes whatever room is left and is cut to fit it: a long one
        // must not push the button out of the tile.
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            // One line's height, to show whole lines only.
            line := Text { text: "X"; font-size: 13px; visible: false; }
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(1, floor(parent.height / line.preferred-height)) * line.preferred-height;
                clip: true;
                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    text: app.summary;
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if app.installed && !app.has-update : Chip { text: "Installed"; tone: Theme.accent; }
                    // The score, and how many people gave one: the second is the popularity.
                    if app.rating != "" : Chip { text: "★ " + app.rating + "  ·  " + app.rating-count; }
                    if app.rating == "" && app.headline != "" : Chip { text: app.headline; }
                    if app.rating == "" && app.headline == "" && app.price != "" : Chip { text: app.price; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // As in any store: get it straight from the list.
            if !app.installed || app.has-update : Button {
                font-size: 12px;
                min-width: 76px;
                text: app.has-update ? "Update" : "Install";
                primary: app.has-update;
                accessible-label: (app.has-update ? "Update " : "Install ") + app.name + " now";
                clicked => { Store.quick-install(app.id); }
            }
        }
    }
}

// Row used in the mobile lists.
export component AppRow inherits Rectangle {
    in property <AppCard> app;
    callback clicked;
    height: 76px;
    background: ta.pressed ? Theme.surface-2 : transparent;
    accessible-role: button;
    accessible-label: app.name;
    accessible-description: app.summary;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 48px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: app.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
            Text { text: app.summary; color: Theme.text-dim; font-size: 13px; overflow: elide; }
            Text {
                text: (app.has-update ? "Update available · " : app.installed ? "Installed · " : "") + (app.rating != "" ? "★ " + app.rating + " (" + app.rating-count + ") · " : app.headline != "" ? app.headline + " · " : "") + (app.author != "" ? app.author : app.source);
                color: app.has-update || app.installed ? Theme.accent : Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }
        }
        if !app.installed || app.has-update : VerticalLayout {
            alignment: center;
            Button {
                font-size: 12px;
                width: 72px;
                text: app.has-update ? "Update" : "Install";
                primary: app.has-update;
                accessible-label: (app.has-update ? "Update " : "Install ") + app.name + " now";
                clicked => { Store.quick-install(app.id); }
            }
        }
    }
}

// A terminal command with a copy button.
component CommandBox inherits Rectangle {
    in property <string> command;
    property <bool> copied;
    height: max(34px, cmd.preferred-height + 14px);
    border-radius: 8px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.stroke;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        Text { text: "$"; color: Theme.text-dim; font-family: "monospace"; font-size: 12px; vertical-alignment: center; }
        cmd := TextInput {
            horizontal-stretch: 1;
            text: root.command;
            read-only: true;
            color: Theme.text;
            font-family: "monospace";
            font-size: 12px;
            wrap: char-wrap;
            single-line: false;
            vertical-alignment: center;
            accessible-label: "Command";
        }
        Rectangle {
            width: 54px;
            accessible-role: button;
            accessible-label: "Copy command";
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    cmd.select-all();
                    cmd.copy();
                    cmd.clear-selection();
                    root.copied = true;
                }
            }
            Text {
                text: root.copied ? "Copied" : "Copy";
                color: root.copied ? Theme.ok : Theme.accent;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// One installable file on the details page.
export component OptionCard inherits Rectangle {
    in property <OptionRow> option;
    in property <int> index;
    in property <bool> recommended;
    in property <bool> compact;
    // Only the essentials: what it is, that it is checked, and the button. File name,
    // size, command and steps appear when the page's details are opened.
    in property <bool> plain;
    property <bool> busy: Store.install-state == 1;
    property <bool> mine: Store.install-index == index && Store.install-state != 0;
    property <bool> show-steps: false;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: recommended ? Theme.accent.with-alpha(0.55) : Theme.stroke;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        // What kind of file it is matters to some people; that it fits
                        // this device matters to everyone.
                        text: plain ? (option.native ? "Made for this device" : "Works on this device") : option.label;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if recommended && !compact && !plain : Chip { text: "Best for this device"; tone: Theme.accent; }
                    if !option.native && !compact && !plain : Chip { text: "Compatible"; tone: Theme.warn; }
                }
                if plain && option.size != "" : Text { text: option.size + " download"; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                if !plain : Text {
                    text: option.size != "" ? option.file + "  ·  " + option.size : option.file;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: mine && busy ? "Cancel" : recommended && Store.installed-version != "" && Store.installed-version != Store.app.version ? "Update" : recommended && Store.installed-version != "" && option.verb == "Install" ? "Reinstall" : option.verb;
                    primary: recommended && !(mine && busy);
                    enabled: !busy || mine;
                    accessible-label: (mine && busy ? "Cancel" : option.verb) + " " + option.label;
                    clicked => {
                        if (mine && busy) {
                            Store.cancel-install();
                        } else {
                            Store.install(index);
                        }
                    }
                }
            }
        }
        if recommended && compact && !plain : HorizontalLayout {
            alignment: start;
            Chip { text: "Best for this device"; tone: Theme.accent; }
        }
        if option.note != "" : Text { text: option.note; color: Theme.warn; font-size: 12px; wrap: word-wrap; }
        if option.command != "" && (!plain || Store.is-package) : CommandBox { command: option.command; }
        if option.verified : HorizontalLayout {
            spacing: 5px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image { source: @image-url("icons/shield.svg"); colorize: Theme.ok; width: 13px; height: 13px; }
            }
            Text {
                text: plain ? "The download is checked before it is installed" : "Checksum is checked after download";
                color: Theme.ok;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !plain : HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 18px;
                width: steps-label.preferred-width;
                accessible-role: button;
                accessible-label: "What happens when I install " + option.label;
                accessible-expandable: true;
                accessible-expanded: root.show-steps;
                accessible-action-default => { root.show-steps = !root.show-steps; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-steps = !root.show-steps; }
                }
                steps-label := Text {
                    text: root.show-steps ? "Hide steps" : "What will happen?";
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        if root.show-steps && !plain : VerticalLayout {
            spacing: 3px;
            for step[n] in option.steps : Text {
                text: (n + 1) + ".  " + step;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        if mine && busy : ProgressBar { value: Store.install-progress; }
        if mine && !busy : HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                DoneMark { ok: Store.install-state != 3; }
            }
            Text {
                horizontal-stretch: 1;
                text: Store.install-message;
                color: Store.install-state == 3 ? Theme.bad : Theme.ok;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
                accessible-role: text;
            }
        }
    }
}

// A friendly "nothing here" block with an optional action.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <bool> error;
    callback acted;
    alignment: center;
    spacing: 10px;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Image {
            source: @image-url("icons/empty.svg");
            colorize: error ? Theme.bad : Theme.text-dim;
            width: 40px;
            height: 40px;
        }
    }
    Text { text: title; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
    Text { text: body; color: Theme.text-dim; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
    if action != "" : HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        Button { text: action; primary: false; clicked => { root.acted(); } }
    }
}

// A one-line nudge on Discover when the library has updates waiting.
export component UpdatesBanner inherits Rectangle {
    height: 44px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.accent.with-alpha(0.13);
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: "Show updates";
    accessible-action-default => { Store.page = 2; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Store.page = 2;
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Store.page = 2; }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: Store.updates-count == 1 ? "1 app in your library has an update" : Store.updates-count + " apps in your library have updates";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text { text: "View"; color: Theme.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; }
    }
}

// Shown once, on first run: what the store does, and what it does not promise.
export component Welcome inherits Rectangle {
    in property <bool> compact;
    border-radius: 14px;
    background: Theme.accent.with-alpha(0.1);
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.35);
    VerticalLayout {
        padding: compact ? 14px : 20px;
        spacing: 8px;
        Text { text: "Welcome to Bilby"; color: Theme.text; font-size: 17px; font-weight: 700; }
        Text {
            text: "•  You are seeing apps for " + Store.platform-title + ". Anything that cannot be installed on this device is hidden.";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: "•  Apps come straight from their authors' release pages. Nobody reviews them, so only install software you trust.";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: "•  There is no account and no server of ours. Your library and settings stay in a file on this device.";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Button { text: "Got it"; clicked => { Store.dismiss-welcome(); } }
        }
    }
}

// Under a search: show everything, or only what one source gave.
export component SourceFilter inherits Flickable {
    height: 36px;
    viewport-width: chips.preferred-width;
    HorizontalLayout {
        alignment: start;
        chips := HorizontalLayout {
            spacing: 8px;
            ChoiceChip { text: "All"; selected: Store.source-filter == ""; clicked => { Store.filter-results(""); } }
            for source in Store.result-sources : ChoiceChip {
                text: source.label + "  " + source.count;
                selected: Store.source-filter == source.id;
                clicked => { Store.filter-results(source.id); }
            }
        }
    }
}

// Asked once, when a controller is attached but nothing says this is a TV.
export component TvQuestion inherits Rectangle {
    in property <bool> compact;
    border-radius: 14px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        padding: compact ? 14px : 20px;
        spacing: 8px;
        Text { text: "Are you using this on a TV?"; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
        Text {
            text: "A game controller is connected. Bilby has a layout with large text for the sofa, driven with the arrow keys of a remote or keyboard. You can change this later in Settings.";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            padding-top: 4px;
            Button { text: "Use the TV layout"; clicked => { Store.answer-tv(true); } }
            Button { text: "Keep this layout"; primary: false; clicked => { Store.answer-tv(false); } }
        }
    }
}

// The details page body, shared by the desktop and mobile shells.
// One fact in the row under an app's name: a value and what it is.
component StatCell inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    spacing: 2px;
    accessible-role: text;
    accessible-label: root.value + " " + root.caption;
    Text { text: root.value; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
    Text { text: root.caption; color: Theme.text-dim; font-size: 11px; overflow: elide; }
}

// The average, how many people gave it, and a bar for each number of stars.
component RatingSummary inherits HorizontalLayout {
    spacing: 20px;
    alignment: start;
    accessible-role: text;
    accessible-label: Store.app.rating + " out of 5, from " + Store.app.rating-count;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text { text: Store.app.rating; color: Theme.text; font-size: 40px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "out of 5"; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
        Text { text: Store.app.rating-count; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        for share[i] in Store.app.rating-spread : HorizontalLayout {
            spacing: 8px;
            Text { width: 26px; text: (5 - i) + " ★"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 180px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.stroke;
                    Rectangle {
                        x: 0;
                        width: parent.width * share;
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.warn;
                        animate width { duration: Theme.slow; easing: ease-out; }
                    }
                }
            }
            Text { width: 34px; text: round(share * 100) + "%"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
        }
    }
}

// A line of the Information table.
component InfoRow inherits Rectangle {
    in property <string> name;
    in property <string> value;
    height: max(34px, v.preferred-height + 14px);
    accessible-role: text;
    accessible-label: root.name + ": " + root.value;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
    Text { x: 0; width: 130px; text: root.name; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
    v := Text {
        x: 140px;
        width: parent.width - 140px;
        text: root.value;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Long text shown as its first few lines, with the rest one press away.
component Clamped inherits VerticalLayout {
    in property <string> text;
    in property <length> limit: 104px;
    in property <string> what;
    // Changes when the page shows something else, which folds the text again.
    in property <string> key;
    property <bool> open: false;
    changed key => { root.open = false; }
    spacing: 4px;
    Rectangle {
        clip: true;
        height: root.open ? t.preferred-height : min(t.preferred-height, root.limit);
        t := Text {
            x: 0;
            y: 0;
            width: parent.width;
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        // Fade the last line out, so a cut reads as "there is more" on any font.
        if !root.open && t.preferred-height > root.limit : Rectangle {
            y: parent.height - 26px;
            height: 26px;
            background: @linear-gradient(180deg, Theme.bg.with-alpha(0) 0%, Theme.bg 100%);
        }
    }
    // Always there (zero-high when not needed), so the layout's width never depends on
    // how tall the text turned out to be.
    Rectangle {
        property <bool> needed: t.preferred-height > root.limit;
        height: self.needed ? 28px : 0px;
        visible: self.needed;
        accessible-role: button;
        accessible-label: (root.open ? "Show less of " : "Show all of ") + root.what;
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => { root.open = !root.open; }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
        Text {
            x: 0;
            text: root.open ? "Show less" : "Read more";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// What changed in the release being shown.
component WhatsNew inherits Rectangle {
    height: body.preferred-height;
    body := VerticalLayout {
        width: parent.width;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: Store.is-website ? "About this website" : Store.is-package ? "About this package" : "What's new";
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
            }
            Text {
                text: Store.app.version != "" && !Store.is-package ? Store.app.version + (Store.release-age != "" ? "  ·  " + Store.release-age : "") : Store.release-age;
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Clamped { text: Store.notes; limit: 70px; what: "what is new"; key: Store.app.id + Store.app.version; }
    }
}

// An app's page. Laid out the way the big stores do it, because that is what people
// already know: name and one button at the top, a row of key facts, what it is, what is
// new, and a table of everything else at the bottom.
export component DetailsBody inherits Rectangle {
    in property <bool> compact;
    property <bool> show-hidden: false;
    // Every version and every file, including the ones for other devices: one press
    // away, right under the main button.
    property <bool> more: false;
    property <string> shown-id: Store.app.id;
    changed shown-id => {
        root.more = false;
        root.show-hidden = false;
    }
    property <length> pad: compact ? 16px : 32px;
    property <bool> has-option: Store.options.length > 0;
    property <OptionRow> best: Store.options[0];
    property <bool> busy: Store.install-state == 1;
    property <bool> mine: Store.install-index == 0 && Store.install-state != 0;
    // "installed" alone means the system has it but did not say which version.
    property <bool> is-update: Store.installed-version != "" && Store.installed-version != "installed" && Store.app.version != "" && Store.installed-version != Store.app.version;
    property <bool> open-instead: Store.can-open && !is-update && !(mine && busy);
    property <string> action: mine && busy ? "Cancel" : open-instead ? "Open" : is-update ? "Update" : Store.installed-version != "" && best.verb == "Install" ? "Reinstall" : best.verb;
    function act() {
        if (mine && busy) {
            Store.cancel-install();
        } else if (open-instead) {
            Store.launch();
        } else {
            Store.install(0);
        }
    }
    Flickable {
        VerticalLayout {
            padding: pad;
            padding-bottom: pad + 24px;
            spacing: 18px;
            alignment: start;

            HorizontalLayout {
                spacing: compact ? 14px : 20px;
                AppIcon { initials: Store.app.initials; tint: Store.app.tint; icon: Store.app.icon; size: compact ? 64px : 88px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: Store.app.name; color: Theme.text; font-size: compact ? 24px : 30px; font-weight: 700; overflow: elide; }
                    Text { text: Store.app.author + (Store.app.verified ? "  ✓ verified" : ""); color: Theme.text-dim; font-size: 14px; overflow: elide; }
                }
                if !compact : VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            width: 44px;
                            text: Store.is-favourite ? "★" : "☆";
                            primary: false;
                            accessible-label: Store.is-favourite ? "Remove from favourites" : "Add to favourites";
                            clicked => { Store.toggle-favourite(); }
                        }
                        if root.has-option : Button {
                            min-width: 150px;
                            font-size: 15px;
                            text: root.action;
                            progress: root.mine && root.busy ? Store.install-progress : -1;
                            primary: !(root.mine && root.busy);
                            enabled: !root.busy || root.mine;
                            accessible-label: (root.mine && root.busy ? "Cancel" : root.open-instead ? "Open" : root.best.verb) + " " + (root.open-instead ? Store.app.name : root.best.label);
                            clicked => { root.act(); }
                        }
                    }
                }
            }
            if compact : HorizontalLayout {
                spacing: 8px;
                if root.has-option : Button {
                    horizontal-stretch: 1;
                    font-size: 15px;
                    text: root.action;
                    progress: root.mine && root.busy ? Store.install-progress : -1;
                    primary: !(root.mine && root.busy);
                    enabled: !root.busy || root.mine;
                    accessible-label: (root.mine && root.busy ? "Cancel" : root.open-instead ? "Open" : root.best.verb) + " " + (root.open-instead ? Store.app.name : root.best.label);
                    clicked => { root.act(); }
                }
                Button {
                    width: root.has-option ? 48px : self.preferred-width;
                    horizontal-stretch: root.has-option ? 0 : 1;
                    text: root.has-option ? (Store.is-favourite ? "★" : "☆") : (Store.is-favourite ? "★ In your favourites" : "☆ Add to favourites");
                    primary: false;
                    accessible-label: Store.is-favourite ? "Remove from favourites" : "Add to favourites";
                    clicked => { Store.toggle-favourite(); }
                }
            }
            // Always within reach of the main button, never competing with it.
            if root.has-option || Store.hidden.length > 0 || Store.versions.length > 1 : HorizontalLayout {
                alignment: compact ? center : end;
                Rectangle {
                    height: 26px;
                    width: more-label.preferred-width;
                    accessible-role: button;
                    accessible-label: "Other versions and files";
                    accessible-expandable: true;
                    accessible-expanded: root.more;
                    accessible-action-default => { root.more = !root.more; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more = !root.more; }
                    }
                    more-label := Text {
                        text: root.more ? "Hide other versions and files  ▴" : "Other versions and files  ▾";
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            if root.more && Store.versions.length > 1 : Flickable {
                height: 32px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Version"; color: Theme.text-dim; font-size: 12px; font-weight: 700; }
                    }
                    for version[i] in Store.versions : ChoiceChip {
                        text: version;
                        selected: i == Store.selected-version;
                        accessible-label: "Version " + version;
                        clicked => { Store.select-version(i); }
                    }
                }
            }



            if root.more && root.has-option : VerticalLayout {
                spacing: 10px;
                Text { text: "Every way to install on " + Store.platform-title; color: Theme.text-dim; font-size: 12px; font-weight: 700; }
                for option[i] in Store.options : OptionCard {
                    option: option;
                    index: i;
                    recommended: i == 0;
                    compact: root.compact;
                }
            }

            if root.more && Store.hidden.length > 0 : VerticalLayout {
                spacing: 8px;
                Rectangle {
                    height: 32px;
                    accessible-role: button;
                    accessible-label: "Files that won't work on this device";
                    accessible-expandable: true;
                    accessible-expanded: root.show-hidden;
                    accessible-action-default => { root.show-hidden = !root.show-hidden; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-hidden = !root.show-hidden; }
                    }
                    Text {
                        x: 0;
                        text: (root.show-hidden ? "Hide " : "Show ") + Store.hidden.length + (Store.hidden.length == 1 ? " file" : " files") + " for other devices";
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                if root.show-hidden : VerticalLayout {
                    spacing: 6px;
                    for row[i] in Store.hidden : HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text { text: row.file; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                            Text { text: row.reason; color: Theme.text-dim.with-alpha(0.7); font-size: 11px; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                property <bool> mine: Store.install-state == 1 && Store.install-index == 1000 + i;
                                font-size: 12px;
                                text: self.mine ? "Cancel" : compact ? "Download" : "Download anyway";
                                primary: false;
                                enabled: Store.install-state != 1 || self.mine;
                                accessible-label: (self.mine ? "Cancel downloading " : "Download anyway: ") + row.file;
                                clicked => {
                                    if (self.mine) {
                                        Store.cancel-install();
                                    } else {
                                        Store.download-hidden(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.mine && root.busy : ProgressBar { value: Store.install-progress; }
            if root.mine && !root.busy && !root.more : HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: start;
                    DoneMark { ok: Store.install-state != 3; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: Store.install-message;
                    color: Store.install-state == 3 ? Theme.bad : Theme.ok;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    accessible-role: text;
                }
            }

            if Store.app.summary != "" : Text {
                text: Store.app.summary;
                color: Theme.text;
                font-size: 15px;
                wrap: word-wrap;
            }

            // The facts people look for first, as the big stores show them.
            if root.has-option || Store.app.popularity != "" || Store.app.rating != "" || Store.app.downloads != "" : HorizontalLayout {
                spacing: compact ? 16px : 36px;
                alignment: start;
                if Store.app.rating != "" : StatCell { value: "★ " + Store.app.rating; caption: Store.app.rating-count; }
                if Store.app.price != "" : StatCell { value: Store.app.price; caption: "on " + Store.app.source; }
                if Store.app.downloads != "" : StatCell { value: Store.app.downloads; caption: Store.app.downloads-note; }
                if Store.app.popularity != "" && !(compact && Store.app.downloads != "") : StatCell { value: Store.app.popularity; caption: "on " + Store.app.source; }
                if root.has-option && root.best.size != "" : StatCell { value: root.best.size; caption: "download"; }
                // On a phone the row holds three facts; the date is under "What's new" too.
                if Store.release-age != "" && !(compact && Store.app.rating != "" && (Store.app.downloads != "" || Store.app.popularity != "")) : StatCell { value: Store.release-age; caption: "last updated"; }
                if Store.license != "" && !compact : StatCell { value: Store.license; caption: "licence"; }
            }

            if root.has-option : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/shield.svg"); colorize: Theme.ok; width: 14px; height: 14px; }
                }
                Text {
                    text: (root.best.native ? "Made for this device" : "Works on this device") + (root.best.verified ? "  ·  the download is checked before it is installed" : "");
                    color: Theme.ok;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            // Pictures first, as in any store: they say more than the description.
            if Store.screenshots.length > 0 : Flickable {
                height: compact ? 180px : 240px;
                content-width: shots.preferred-width;
                shots := HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    for shot[i] in Store.screenshots : Rectangle {
                        height: compact ? 180px : 240px;
                        width: self.height * shot.width / max(1, shot.height);
                        border-radius: 10px;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        Image {
                            source: shot;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            accessible-role: image;
                            accessible-label: "Picture " + (i + 1) + " of " + Store.app.name;
                        }
                    }
                }
            }

            if root.has-option && root.best.note != "" : Text { text: root.best.note; color: Theme.warn; font-size: 12px; wrap: word-wrap; }

            if Store.installed-version != "" : Rectangle {
                height: max(40px, banner.preferred-height + 20px);
                border-radius: 10px;
                background: Theme.accent.with-alpha(0.12);
                banner := Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    wrap: word-wrap;
                    text: Store.installed-version == "installed" ? "Installed" : Store.installed-version == Store.app.version || Store.app.version == "" ? "Installed  ·  " + Store.installed-version : "Update available  ·  you have " + Store.installed-version + ", latest is " + Store.app.version;
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    
                }
            }

            if Store.details-loading : VerticalLayout {
                spacing: 10px;
                Text { text: "Checking releases against this device…"; color: Theme.text-dim; font-size: 14px; }
                Busy { }
            }
            if Store.details-error != "" : EmptyState {
                error: true;
                title: "Couldn't load this app";
                body: Store.details-error;
                action: "Try again";
                acted => { Store.retry-details(); }
            }
            if Store.warning != "" : Text { text: Store.warning; color: Theme.warn; font-size: 13px; wrap: word-wrap; }

            if Store.unavailable != "" : Rectangle {
                height: un.preferred-height + 28px;
                border-radius: 12px;
                background: Theme.warn.with-alpha(0.1);
                un := Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: Store.unavailable;
                    color: Theme.warn;
                    font-size: 14px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }


            // Someone who already has the app wants to know what changed, as in any store.
            if Store.notes != "" && Store.installed-version != "" : WhatsNew { }

            if Store.about != "" : VerticalLayout {
                spacing: 8px;
                Text { text: "About"; color: Theme.text; font-size: 17px; font-weight: 700; }
                Clamped { text: Store.about; what: "the description"; key: Store.app.id; }
            }

            // Someone who has not installed it reads what it is first.
            if Store.notes != "" && Store.installed-version == "" : WhatsNew { }

            // What people who use it wrote. Only apps a ratings service knows have any.
            if Store.reviews.length > 0 || Store.app.rating-spread.length > 0 : VerticalLayout {
                spacing: 10px;
                Text { text: Store.reviews.length > 0 ? "Ratings and reviews" : "Ratings"; color: Theme.text; font-size: 17px; font-weight: 700; }
                // The score with how the stars are spread, as the big stores show it: an
                // average says little until you see how many people it is an average of.
                if Store.app.rating-spread.length > 0 : RatingSummary { }
                if Store.app.rating-spread.length == 0 && Store.app.rating != "" : Text {
                    text: "★ " + Store.app.rating + "  ·  " + Store.app.rating-count;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                for review[i] in Store.reviews : Rectangle {
                    border-radius: 12px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    height: body.preferred-height;
                    accessible-role: text;
                    accessible-label: "Review " + (i + 1) + ": " + review.title;
                    body := VerticalLayout {
                        width: parent.width;
                        padding: 14px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: review.stars; color: Theme.warn; font-size: 13px; vertical-alignment: center; }
                            Text {
                                horizontal-stretch: 1;
                                text: review.title;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        if review.text != "" : Text { text: review.text; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                        if review.meta != "" : Text { text: review.meta; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                    }
                }
                Text {
                    text: Store.reviews.length > 0 ? "Reviews are written by other people and come from the ratings service the GNOME and KDE app stores use." : "Ratings come from the ratings service the GNOME and KDE app stores use.";
                    color: Theme.text-dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Everything else, where the stores put it: a plain table at the bottom.
            if root.has-option || Store.license != "" || Store.app.source != "" : VerticalLayout {
                spacing: 0px;
                Text { text: "Information"; color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                if Store.app.source != "" : InfoRow { name: "From"; value: Store.app.source; }
                if Store.app.author != "" && Store.app.author != Store.app.source : InfoRow { name: "Made by"; value: Store.app.author + (Store.app.verified ? " (confirmed by " + Store.app.source + ")" : ""); }
                if Store.app.price != "" : InfoRow { name: "Price"; value: Store.app.price + " on " + Store.app.source; }
                if Store.app.downloads != "" : InfoRow { name: "Downloads"; value: Store.app.downloads + " " + Store.app.downloads-note; }
                if Store.app.popularity != "" : InfoRow { name: "Popularity"; value: Store.app.popularity + " on " + Store.app.source; }
                if Store.app.version != "" : InfoRow { name: "Version"; value: Store.app.version; }
                if Store.release-date != "" : InfoRow { name: "Released"; value: Store.release-date; }
                if Store.license != "" : InfoRow { name: "Licence"; value: Store.license; }
                if root.has-option : InfoRow { name: "Works on"; value: Store.platform-title; }
                if root.has-option : InfoRow { name: "Kind of file"; value: root.best.label; }
                if root.has-option && root.best.size != "" : InfoRow { name: "Download size"; value: root.best.size; }
            }

            if !compact : HorizontalLayout {
                spacing: 10px;
                alignment: start;
                if Store.homepage != "" : Button {
                    text: "Project page";
                    primary: false;
                    clicked => { Store.open-url(Store.homepage); }
                }
            }

            // Side by side they are wider than a small phone.
            if compact && Store.homepage != "" : Button {
                text: "Project page";
                primary: false;
                clicked => { Store.open-url(Store.homepage); }
            }

        }
    }
}

component LibraryItem inherits Rectangle {
    in property <LibraryRow> entry;
    in property <bool> compact;
    property <bool> confirm: false;
    property <bool> updating: Store.updating-id == entry.card.id;
    // One update at a time; the others wait their turn.
    property <bool> can-act: Store.updating-id == "" || updating;
    function act() {
        if (entry.status != 3) {
            Store.open(entry.card.id);
        } else if (updating) {
            Store.cancel-install();
        } else {
            Store.update-app(entry.card.id);
        }
    }
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: entry.status == 3 ? Theme.accent.with-alpha(0.55) : Theme.stroke;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                AppIcon { initials: entry.card.initials; tint: entry.card.tint; icon: entry.card.icon; size: 44px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text { text: entry.card.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: updating ? "Updating…" : entry.detail; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                if entry.status != 0 : Text {
                    text: entry.status-text;
                    color: entry.status == 3 ? Theme.accent : entry.status == 4 ? Theme.warn : entry.status == 2 ? Theme.ok : Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            if !compact : HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: entry.status != 3 ? "Details" : updating ? "Cancel" : "Update";
                        primary: entry.status == 3 && !updating;
                        enabled: root.can-act;
                        accessible-label: (entry.status != 3 ? "Details of " : updating ? "Cancel updating " : "Update ") + entry.card.name;
                        clicked => { root.act(); }
                    }
                }
                if entry.status == 3 && !updating : VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Skip";
                        primary: false;
                        accessible-label: "Skip this update of " + entry.card.name;
                        clicked => { Store.skip-update(entry.card.id); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: root.confirm ? "Really remove?" : "Remove";
                        primary: false;
                        danger: true;
                        accessible-label: (root.confirm ? "Confirm removing " : "Remove ") + entry.card.name;
                        clicked => {
                            if (root.confirm) {
                                Store.remove-from-library(entry.card.id);
                            }
                            root.confirm = !root.confirm;
                        }
                    }
                }
            }
        }
        if compact : HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                text: entry.status != 3 ? "Details" : updating ? "Cancel" : "Update";
                primary: entry.status == 3 && !updating;
                enabled: root.can-act;
                accessible-label: (entry.status != 3 ? "Details of " : updating ? "Cancel updating " : "Update ") + entry.card.name;
                clicked => { root.act(); }
            }
            Button {
                horizontal-stretch: 1;
                text: root.confirm ? "Really remove?" : "Remove";
                primary: false;
                danger: true;
                accessible-label: (root.confirm ? "Confirm removing " : "Remove ") + entry.card.name;
                clicked => {
                    if (root.confirm) {
                        Store.remove-from-library(entry.card.id);
                    }
                    root.confirm = !root.confirm;
                }
            }
        }
        // Three buttons do not fit side by side on a narrow phone.
        if compact && entry.status == 3 && !updating : Button {
            text: "Skip this version";
            primary: false;
            accessible-label: "Skip this update of " + entry.card.name;
            clicked => { Store.skip-update(entry.card.id); }
        }
        if updating : ProgressBar { value: Store.install-progress; }
        if root.confirm : Text {
            text: entry.store-managed ? "This deletes the app's file from your Applications folder." : "This only forgets the app here. To uninstall it, use your system's software manager.";
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// ---- this device -------------------------------------------------------------------

// The colour that goes with the system's state: calm when fine, loud when not.
component SystemHeadline inherits Text {
    text: Store.system-headline;
    color: Store.system-state == 2 && !Store.system-restart ? Theme.ok : Store.system-state == 5 ? Theme.bad : Store.system-state == 3 || Store.system-restart ? Theme.warn : Theme.text;
    font-weight: 700;
    overflow: elide;
}

// In the library: the operating system, as one more thing that can be up to date or not.
export component SystemCard inherits Rectangle {
    in property <bool> compact;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    height: box.preferred-height;
    box := VerticalLayout {
        width: parent.width;
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: Store.system-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                SystemHeadline { font-size: 13px; }
            }
            if !compact && Store.system-state == 3 : VerticalLayout {
                alignment: center;
                Button { text: "Update system"; clicked => { Store.system-update(); } }
            }
            if !compact : VerticalLayout {
                alignment: center;
                Button { text: "System details"; primary: false; clicked => { Store.system-from = 2; Store.page = 4; } }
            }
        }
        if compact && Store.system-state == 3 : Button { text: "Update system"; clicked => { Store.system-update(); } }
        if compact : Button { text: "System details"; primary: false; clicked => { Store.system-from = 2; Store.page = 4; } }
    }
}

export component SystemBody inherits Rectangle {
    in property <bool> compact;
    property <bool> all-updates: false;
    property <bool> show-log: false;
    property <int> shown: root.all-updates ? Store.system-updates.length : min(Store.system-updates.length, 8);
    Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 16px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                Text { text: Store.system-name; color: Theme.text; font-size: compact ? 22px : 28px; font-weight: 700; wrap: word-wrap; }
                Text { text: Store.system-tagline; color: Theme.text-dim; font-size: 13px; overflow: elide; }
            }

            // The answer at a glance, and the one thing to do about it.
            Rectangle {
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.stroke;
                height: status.preferred-height;
                status := VerticalLayout {
                    width: parent.width;
                    padding: 16px;
                    spacing: 12px;
                    if Store.system-supported : SystemHeadline { font-size: compact ? 18px : 22px; accessible-role: text; }
                    if Store.system-detail != "" : Text { text: Store.system-detail; color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                    if Store.system-restart : Text {
                        text: "Restart this device to finish: something that was updated is still running in its old version.";
                        color: Theme.warn;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if Store.system-note != "" : Text { text: Store.system-note; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    if Store.system-state == 1 || Store.system-state == 4 : Busy { }
                    if Store.system-state == 4 : Text {
                        text: "You may be asked for your password. Keep the device on until this finishes.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if !compact : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if Store.system-state == 3 : Button { text: "Update now"; clicked => { Store.system-update(); } }
                        if Store.system-supported : Button {
                            text: "Check again";
                            primary: false;
                            enabled: Store.system-state != 1 && Store.system-state != 4;
                            clicked => { Store.system-check(); }
                        }
                        if Store.system-handoff != "" : Button { text: Store.system-handoff; primary: false; clicked => { Store.system-handoff-open(); } }
                    }
                    if compact && Store.system-state == 3 : Button { text: "Update now"; clicked => { Store.system-update(); } }
                    if compact && Store.system-supported : Button {
                        text: "Check again";
                        primary: false;
                        enabled: Store.system-state != 1 && Store.system-state != 4;
                        clicked => { Store.system-check(); }
                    }
                    if compact && Store.system-handoff != "" : Button { text: Store.system-handoff; primary: false; clicked => { Store.system-handoff-open(); } }
                }
            }

            // What is waiting. The first few are enough for most people.
            if Store.system-updates.length > 0 : VerticalLayout {
                spacing: 0px;
                Text { text: "Waiting to be installed"; color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                for update[i] in Store.system-updates : Rectangle {
                    visible: i < root.shown;
                    height: i < root.shown ? 34px : 0px;
                    accessible-role: text;
                    accessible-label: update.name + ": " + update.change;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { horizontal-stretch: 1; text: update.name; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; }
                        Text { text: update.change; color: Theme.text-dim; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
                if Store.system-updates.length > 8 : HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    Button {
                        text: root.all-updates ? "Show fewer" : "Show all " + Store.system-updates.length;
                        primary: false;
                        clicked => { root.all-updates = !root.all-updates; }
                    }
                }
            }

            // What the updater printed, for whoever wants it.
            if Store.system-log != "" : VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.show-log ? "Hide what the updater said" : "Show what the updater said";
                        primary: false;
                        clicked => { root.show-log = !root.show-log; }
                    }
                }
                if root.show-log : Rectangle {
                    border-radius: 10px;
                    background: Theme.surface;
                    height: log.preferred-height + 24px;
                    log := Text { x: 12px; y: 12px; width: parent.width - 24px; text: Store.system-log; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Text { text: "Information"; color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                for fact in Store.system-facts : InfoRow { name: fact.name; value: fact.value; }
                InfoRow { name: "Bilby"; value: Store.app-version; }
            }
        }
    }
}

export component LibraryBody inherits Rectangle {
    in property <bool> compact;
    if Store.library.length == 0 && Store.favourites.length == 0 && !Store.system-supported : EmptyState {
        title: "Your library is empty";
        body: "Apps you install from the store show up here, and the store can tell you when they have a new release. Favourites are kept here too.";
        action: "Browse apps";
        acted => { Store.page = 0; }
    }
    if Store.library.length > 0 || Store.favourites.length > 0 || Store.system-supported : Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 12px;
            alignment: start;
            // The system itself comes first: it is the update that matters most.
            if Store.system-supported : SystemCard { compact: root.compact; }
            if Store.library.length == 0 && Store.favourites.length == 0 : Text {
                text: "Apps you install from the store show up here, and the store can tell you when they have a new release.";
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
            if Store.library.length == 0 && Store.favourites.length == 0 : HorizontalLayout {
                alignment: start;
                Button { text: "Browse apps"; primary: false; clicked => { Store.page = 0; } }
            }
            if Store.library.length > 0 : HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: Store.checking-updates ? "Checking for updates…" : Store.updates-count == 0 ? (Store.last-checked != "" ? "Everything is up to date" : Store.library.length + (Store.library.length == 1 ? " app" : " apps")) : Store.updates-count == 1 ? "1 update available" : Store.updates-count + " updates available";
                        color: Theme.text;
                        font-size: compact ? 16px : 20px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if Store.last-checked != "" : Text {
                        text: "Last checked " + Store.last-checked;
                        color: Theme.text-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                // On a phone the buttons get their own rows below.
                if !compact && Store.updates-count > 1 : VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Update all";
                        enabled: Store.updating-id == "";
                        clicked => { Store.update-all(); }
                    }
                }
                if !compact : VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Check for updates";
                        primary: false;
                        enabled: !Store.checking-updates && Store.updating-id == "";
                        clicked => { Store.check-updates(); }
                    }
                }
            }
            if compact && Store.updates-count > 1 : Button {
                text: "Update all";
                enabled: Store.updating-id == "";
                clicked => { Store.update-all(); }
            }
            if compact && Store.library.length > 0 : Button {
                text: "Check for updates";
                primary: false;
                enabled: !Store.checking-updates && Store.updating-id == "";
                clicked => { Store.check-updates(); }
            }
            if Store.checking-updates : Busy { }
            for item in Store.library : LibraryItem { entry: item; compact: root.compact; }
            if Store.favourites.length > 0 : Text {
                text: "Favourites";
                color: Theme.text;
                font-size: compact ? 16px : 20px;
                font-weight: 700;
            }
            if Store.favourites.length > 0 : Rectangle {
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;
                VerticalLayout {
                    for app in Store.favourites : AppRow {
                        app: app;
                        clicked => { Store.open(app.id); }
                    }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> title;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; }
        @children
    }
}

// Settings, including what the store detected about this device.
export component SettingsBody inherits Rectangle {
    in property <bool> compact;
    property <bool> token-saved: false;
    Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 14px;
            alignment: start;

            SettingsCard {
                title: "This device  ·  " + Store.platform-title;
                Text {
                    text: "The store only lists apps with a file that can be installed here. This is what it detected.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                for fact in Store.facts : HorizontalLayout {
                    spacing: 12px;
                    Text { width: compact ? 110px : 170px; text: fact.name; color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                    Text { horizontal-stretch: 1; text: fact.value; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "System details and updates"; primary: false; clicked => { Store.system-from = 3; Store.page = 4; } }
                }
            }

            if Store.can-register : SettingsCard {
                title: "App menu";
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Bilby adds itself to this device's list of apps the first time it runs, so it can be started like any other app. If you move its file, start it once from the new place.";
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show Bilby in the app menu";
                            checked: Store.in-menu;
                            toggled(on) => { Store.set-in-menu(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Where apps come from";
                Text {
                    text: "Switch off any place you do not want apps from. It is then left out of searches and the home page; an app from it can still be opened by its link.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                for source in Store.sources : HorizontalLayout {
                    spacing: 12px;
                    Text { horizontal-stretch: 1; text: source.label; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show apps from " + source.label;
                            checked: source.on;
                            toggled(on) => { Store.set-source(source.id, on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Layout";
                Text {
                    text: "The TV layout has large text and is driven with the arrow keys of a remote or keyboard. To come back from it, open This TV at the top of its screen.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ChoiceChip { text: "Automatic"; selected: Store.interface-mode == 0; clicked => { Store.set-interface(0); } }
                    ChoiceChip { text: "Desktop"; selected: Store.interface-mode == 1; clicked => { Store.set-interface(1); } }
                    ChoiceChip { text: "TV"; selected: Store.interface-mode == 2; clicked => { Store.set-interface(2); } }
                }
            }

            SettingsCard {
                title: "Appearance";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ChoiceChip { text: "Match system"; selected: Store.theme-mode == 0; clicked => { Store.set-theme(0); } }
                    ChoiceChip { text: "Light"; selected: Store.theme-mode == 1; clicked => { Store.set-theme(1); } }
                    ChoiceChip { text: "Dark"; selected: Store.theme-mode == 2; clicked => { Store.set-theme(2); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Reduce motion: pages and buttons change at once instead of moving.";
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Reduce motion";
                            checked: Theme.reduce-motion;
                            toggled(on) => { Store.set-reduce-motion(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Releases";
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "Include pre-releases"; color: Theme.text; font-size: 14px; }
                        Text {
                            text: "Offer betas and release candidates as soon as they are published. They may be unstable.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Include pre-releases";
                            checked: Store.include-prereleases;
                            toggled(on) => { Store.set-prereleases(on); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "Show ratings and reviews"; color: Theme.text; font-size: 14px; }
                        Text {
                            text: "They come from the service the GNOME and KDE app stores use (odrs.gnome.org). Star ratings arrive as one file a day for every app. Written reviews are asked for when you open the page of an app that has them, which tells that service which app it was. Nothing that identifies you is sent.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Show ratings and reviews";
                            checked: Store.show-ratings;
                            toggled(on) => { Store.set-ratings(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Updates";
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: "Check for updates when the store opens"; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                        Text {
                            text: "Uses one request per app in your library. Turn it off if GitHub's allowance is tight; you can still check from the Library page.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Check for updates when the store opens";
                            checked: Store.check-updates-on-start;
                            toggled(on) => { Store.set-check-on-start(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "GitHub access";
                Text {
                    text: Store.has-token ? "You are signed in. GitHub allows 5,000 requests an hour." : "Everything works without signing in, but GitHub then allows only 60 requests an hour for your whole network, which a few searches can use up. Signing in raises that to 5,000. Bilby asks for no access to your account.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if !Store.has-token && Store.signin-state == 0 : HorizontalLayout {
                    alignment: start;
                    Button { text: "Sign in with GitHub"; clicked => { Store.github-signin(); } }
                }
                if Store.signin-state == 1 : Busy { }
                // The code to type at GitHub, large enough to read across a room.
                if Store.signin-state == 2 : Rectangle {
                    border-radius: 12px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.5);
                    height: code-box.preferred-height;
                    code-box := VerticalLayout {
                        width: parent.width;
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "On this or any other device, open github.com/login/device and enter this code:";
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: Store.signin-code;
                            color: Theme.text;
                            font-size: 30px;
                            font-weight: 800;
                            letter-spacing: 3px;
                            accessible-role: text;
                            accessible-label: "Sign-in code " + Store.signin-code;
                        }
                        Busy { }
                        Text { text: "Waiting for you to enter it. This page updates by itself."; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: "Open that page"; clicked => { Store.open-url("https://github.com/login/device"); } }
                            Button { text: "Cancel"; primary: false; accessible-label: "Cancel signing in"; clicked => { Store.github-cancel(); } }
                        }
                    }
                }
                Text {
                    text: "Or paste a personal access token (one with no scopes is enough):";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if Store.quota-text != "" : Text {
                    text: Store.quota-text;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.bg;
                        border-width: token.has-focus ? 2px : 1px;
                        border-color: token.has-focus ? Theme.accent : Theme.stroke;
                        if token.text == "" : Text {
                            x: 12px;
                            text: Store.has-token ? "Paste a new token to replace it" : "Paste a token";
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        token := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 100%;
                            color: Theme.text;
                            font-size: 13px;
                            single-line: true;
                            input-type: password;
                            vertical-alignment: center;
                            accessible-label: "GitHub token";
                            edited => { root.token-saved = false; }
                            accepted => {
                                Store.save-token(self.text);
                                self.text = "";
                                root.token-saved = true;
                            }
                        }
                    }
                    Button {
                        text: root.token-saved ? "Saved" : "Save";
                        primary: false;
                        enabled: token.text != "";
                        accessible-label: "Save token";
                        clicked => {
                            Store.save-token(token.text);
                            token.text = "";
                            root.token-saved = true;
                        }
                    }
                    if Store.has-token : Button {
                        text: "Sign out";
                        primary: false;
                        danger: true;
                        accessible-label: "Sign out of GitHub";
                        clicked => {
                            Store.save-token("");
                            root.token-saved = false;
                        }
                    }
                }
            }

            SettingsCard {
                title: "Storage";
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: compact ? 110px : 170px; text: "Downloads go to"; color: Theme.text-dim; font-size: 13px; }
                    Text { horizontal-stretch: 1; text: Store.downloads-dir; color: Theme.text; font-size: 13px; wrap: char-wrap; }
                }
                // Side by side where there is room, stacked on a phone.
                if !compact : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Open folder"; primary: false; accessible-label: "Open downloads folder"; clicked => { Store.open-downloads(); } }
                    Button { text: "Clear cached catalog data"; primary: false; clicked => { Store.clear-cache(); } }
                    if Store.recent.length > 0 : Button { text: "Clear search history"; primary: false; clicked => { Store.clear-recent(); } }
                }
                if compact : VerticalLayout {
                    spacing: 8px;
                    Button { text: "Open folder"; primary: false; accessible-label: "Open downloads folder"; clicked => { Store.open-downloads(); } }
                    Button { text: "Clear cached catalog data"; primary: false; clicked => { Store.clear-cache(); } }
                    if Store.recent.length > 0 : Button { text: "Clear search history"; primary: false; clicked => { Store.clear-recent(); } }
                }
            }

            SettingsCard {
                title: "About";
                if Store.store-update != "" : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Bilby " + Store.store-update + " is available. You have " + Store.app-version + ".";
                            color: Theme.accent;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    Button {
                        text: "View update";
                        accessible-label: "View the store's update";
                        clicked => { Store.view-store-update(); }
                    }
                }
                Text {
                    text: "Bilby " + Store.app-version + ". Everything runs on this device: there is no account and no server of ours. The store talks directly to GitHub and the AUR, and keeps your library and settings in a file on this device.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Apps come straight from their authors and are not reviewed by anyone. Install software you trust. Made with Slint.";
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Store.demo : Text {
                    text: "Demo mode: the catalog is fictional and nothing is fetched from the network.";
                    color: Theme.warn;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Short feedback that goes away by itself. Fills its parent; only the pill is drawn.
export component Toast inherits Rectangle {
    in property <length> bottom: 24px;
    property <bool> shown: Store.toast != "";
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - root.bottom + (root.shown ? 0px : 14px);
        width: min(root.width - 32px, label.preferred-width + 60px);
        height: 44px;
        border-radius: 22px;
        background: Theme.text;
        opacity: root.shown ? 1 : 0;
        visible: self.opacity > 0;
        accessible-role: text;
        accessible-label: Store.toast;
        animate opacity { duration: Theme.smooth; }
        animate y { duration: Theme.smooth; easing: ease-out; }
        TouchArea {
            clicked => { Store.dismiss-toast(); }
        }
        label := Text {
            x: 20px;
            width: parent.width - 40px;
            text: Store.toast;
            color: Store.toast-is-error ? (Theme.dark ? #b3261e : #ffb4ab) : Theme.bg;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
