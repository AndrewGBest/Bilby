import { Theme } from "theme.slint";
import { AppCard, OptionRow, LibraryRow, Store, VersionChoice } from "types.slint";

export component AppIcon inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <image> icon;
    in property <length> size: 44px;
    property <bool> has-picture: icon.width > 0;
    width: size;
    height: size;
    border-radius: size * 0.26;
    clip: true;
    // Until (or unless) a picture arrives: the app's initials on its own colour.
    background: has-picture ? Theme.surface-2 : @linear-gradient(135deg, tint.brighter(25%) 0%, tint.darker(35%) 100%);
    if !has-picture : Text {
        text: initials;
        color: white;
        font-size: size * 0.4;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if has-picture : Image {
        source: icon;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.text-dim;
    in property <length> font-size: 11px;
    height: font-size * 2;
    border-radius: self.height / 2;
    background: tone.with-alpha(0.14);
    HorizontalLayout {
        padding-left: root.font-size * 0.8;
        padding-right: root.font-size * 0.8;
        Text {
            text: root.text;
            color: tone;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A chip that can be pressed: category filters, recent searches.
// One app out of several for the same service, chosen from a list that drops down.
// Closed, it says which service and which app; open, each app has a line saying what
// kind of thing it is and whether the service's owner made it.
// One app in a service's family: its name, what kind of version it is, and whose.
component FamilyRow inherits Rectangle {
    in property <VersionChoice> choice;
    callback clicked;
    height: 56px;
    border-radius: 10px;
    background: ta.has-hover || fs.has-focus ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: button;
    accessible-label: choice.name + (choice.official ? "" : @tr(", unofficial"));
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: choice.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: choice.note; color: Theme.text-dim; font-size: 12px; overflow: elide; }
        }
        Text {
            text: choice.official ? @tr("Official") : @tr("Unofficial");
            color: choice.official ? Theme.accent : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The other ways to use the service an app belongs to, each its own line.
export component FamilyPanel inherits VerticalLayout {
    in property <string> service;
    in property <[VersionChoice]> others;
    callback chosen(string);
    spacing: 8px;
    Text {
        text: @tr("Other ways to use {}", service);
        color: Theme.text-dim;
        font-size: 13px;
        font-weight: 600;
    }
    for other in others : FamilyRow {
        choice: other;
        clicked => { root.chosen(other.id); }
    }
}

export component ChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: 16px;
    background: selected ? Theme.accent : ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: selected ? 0px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    animate background { duration: 100ms; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Store.play(1);
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: selected ? Theme.on-accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    // 0 to 1 while the button's own action is under way: it fills like a progress bar.
    in property <float> progress: -1;
    // A picture in place of words, for a button that has none (the favourite star).
    in property <image> icon;
    in property <color> icon-color: Theme.text;
    callback clicked;
    height: font-size * 2.9;
    border-radius: 10px;
    clip: root.progress >= 0;
    // Pressing gives a little, as a real button does.
    transform-scale: ta.pressed && root.enabled ? 0.96 : 1;
    animate transform-scale { duration: Theme.quick; easing: ease-out; }
    if root.progress >= 0 : Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0.03, 1.0);
        height: parent.height;
        background: Theme.accent.with-alpha(0.32);
        animate width { duration: Theme.smooth; easing: ease-out; }
    }
    background: !enabled ? Theme.surface-2 : primary ? (ta.pressed ? Theme.accent.darker(15%) : ta.has-hover ? Theme.accent.brighter(8%) : Theme.accent) : (ta.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: fs.has-focus ? 2px : primary ? 0px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    animate background { duration: Theme.quick; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                Store.play(1);
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: root.font-size * 1.4;
        padding-right: root.font-size * 1.4;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-dim : root.primary ? Theme.on-accent : root.danger ? Theme.bad : Theme.text;
            font-size: root.font-size;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.text == "" && root.icon.width > 0 : Image {
        source: root.icon;
        colorize: root.icon-color;
        width: root.font-size * 1.45;
        height: root.font-size * 1.45;
    }
}

// An activity bar for work of unknown length.
export component Busy inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.surface-2;
    clip: true;
    property <float> t: mod(animation-tick() / 1.4s, 1.0);
    Rectangle {
        x: parent.width * (t * 1.4 - 0.4);
        width: parent.width * 0.4;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

// How far along a download or an update is. When the amount is not known (Flatpak
// does not say), a band travels across instead of a bar filling.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    property <bool> unknown: root.value <= 0.01;
    property <float> t: Theme.reduce-motion ? 0.3 : mod(animation-tick() / 1.3s, 1.0);
    height: 6px;
    border-radius: 3px;
    background: Theme.surface-2;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: round(root.value * 100) + "%";
    fill := Rectangle {
        x: root.unknown ? parent.width * (root.t * 1.4 - 0.4) : 0;
        width: root.unknown ? parent.width * 0.4 : parent.width * clamp(root.value, 0.02, 1.0);
        border-radius: 3px;
        background: Theme.accent;
        clip: true;
        animate width { duration: Theme.smooth; easing: ease-out; }
        // A soft highlight passing over the bar says "still working" between steps.
        if !root.unknown && !Theme.reduce-motion : Rectangle {
            x: fill.width * (root.t * 1.5 - 0.25);
            width: 48px;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff55 50%, #ffffff00 100%);
        }
    }
}

// The moment something finishes: a tick that pops in. A failure gets a plain mark.
export component DoneMark inherits Rectangle {
    in property <bool> ok: true;
    property <bool> ready: false;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: root.ok ? Theme.ok : Theme.bad;
    transform-scale: root.ready ? 1 : 0.3;
    opacity: root.ready ? 1 : 0;
    accessible-role: none;
    animate transform-scale { duration: Theme.slow; easing: ease-out-back; }
    animate opacity { duration: Theme.quick; }
    Timer {
        interval: 20ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
    Text { text: root.ok ? "✓" : "!"; color: Theme.bg; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
}

// A page that eases in when it is shown: it fades up a few pixels, the way screens
// arrive on a phone. Leaving is immediate, so nothing lingers.
export component Appear inherits Rectangle {
    in property <bool> shown;
    visible: root.shown;
    inner := Rectangle {
        y: 12px;
        width: parent.width;
        height: parent.height;
        opacity: 0;
        @children
    }
    states [
        on when root.shown: {
            inner.opacity: 1;
            inner.y: 0px;
            in {
                animate inner.opacity, inner.y { duration: Theme.smooth; easing: ease-out; }
            }
        }
    ]
}

// The same for something that only exists while it is shown.
export component FadeIn inherits Rectangle {
    property <bool> ready: false;
    opacity: root.ready ? 1 : 0;
    animate opacity { duration: Theme.smooth; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.ready;
        triggered => { root.ready = true; }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.accent : Theme.surface-2;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.stroke;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }
    animate background { duration: 120ms; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Store.play(3);
                root.toggled(!root.checked);
            }
        }
    }
    Rectangle {
        x: checked ? parent.width - self.width - 3px : 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: checked ? Theme.on-accent : Theme.text-dim;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: @tr("Search apps");
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function grab-focus() {
        input.focus();
        input.select-all();
    }
    height: 42px;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.stroke;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/search.svg");
                colorize: Theme.text-dim;
                width: 18px;
                height: 18px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if input.text == "" : Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                accessible-label: @tr("Search");
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
        if input.text != "" : Rectangle {
            width: 28px;
            accessible-role: button;
            accessible-label: @tr("Clear search");
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    input.text = "";
                    root.edited("");
                    input.focus();
                }
            }
            Text { text: "✕"; color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Card used in the desktop grid.
export component AppTile inherits Rectangle {
    in property <AppCard> app;
    callback clicked;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.focus : ta.has-hover ? Theme.accent.with-alpha(0.5) : Theme.stroke;
    accessible-role: button;
    accessible-label: app.name;
    accessible-description: app.summary;
    accessible-action-default => { root.clicked(); }
    transform-scale: ta.pressed ? 0.985 : ta.has-hover ? 1.012 : 1;
    animate background, border-color { duration: Theme.quick; }
    animate transform-scale { duration: Theme.quick; easing: ease-out; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Store.play(1);
                root.clicked();
            }
        }
    }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: app.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                Text { text: app.author; color: Theme.text-dim; font-size: 12px; overflow: elide; }
            }
        }
        // The description takes whatever room is left and is cut to fit it: a long one
        // must not push the button out of the tile.
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            // One line's height, to show whole lines only.
            line := Text { text: "X"; font-size: 13px; visible: false; }
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(1, floor(parent.height / line.preferred-height)) * line.preferred-height;
                clip: true;
                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    text: app.summary;
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    if app.installed && !app.has-update : Chip { text: @tr("Installed"); tone: Theme.accent; }
                    // The score, and how many people gave one: the second is the popularity.
                    if app.rating != "" : Chip { text: "★ " + app.rating + "  ·  " + app.rating-count; }
                    if app.rating == "" && app.headline != "" : Chip { text: app.headline; }
                    if app.rating == "" && app.headline == "" && app.price != "" : Chip { text: app.price; }
                    if app.more-sources > 0 : Chip { text: @tr("{} sources", app.more-sources + 1); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // As in any store: get it straight from the list.
            if !app.installed || app.has-update : Button {
                font-size: 12px;
                min-width: 76px;
                // A website is added, not installed: nothing is downloaded.
                text: app.has-update ? @tr("Update") : app.source == @tr("Web apps") ? @tr("Add") : @tr("Install");
                primary: app.has-update;
                accessible-label: (app.has-update ? @tr("Update {} now", app.name) : @tr("Install {} now", app.name));
                clicked => { Store.quick-install(app.id); }
            }
        }
    }
}

// Row used in the mobile lists.
export component AppRow inherits Rectangle {
    in property <AppCard> app;
    callback clicked;
    height: 76px;
    background: ta.pressed ? Theme.surface-2 : transparent;
    accessible-role: button;
    accessible-label: app.name;
    accessible-description: app.summary;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 48px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: app.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
            Text { text: app.summary; color: Theme.text-dim; font-size: 13px; overflow: elide; }
            Text {
                text: (app.has-update ? @tr("Update available") + " · " : app.installed ? @tr("Installed") + " · " : "") + (app.rating != "" ? "★ " + app.rating + " (" + app.rating-count + ") · " : app.headline != "" ? app.headline + " · " : "") + (app.author != "" ? app.author : app.source);
                color: app.has-update || app.installed ? Theme.accent : Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
            }
        }
        if !app.installed || app.has-update : VerticalLayout {
            alignment: center;
            Button {
                font-size: 12px;
                width: 72px;
                // A website is added, not installed: nothing is downloaded.
                text: app.has-update ? @tr("Update") : app.source == @tr("Web apps") ? @tr("Add") : @tr("Install");
                primary: app.has-update;
                accessible-label: (app.has-update ? @tr("Update {} now", app.name) : @tr("Install {} now", app.name));
                clicked => { Store.quick-install(app.id); }
            }
        }
    }
}

// A terminal command with a copy button.
component CommandBox inherits Rectangle {
    in property <string> command;
    property <bool> copied;
    height: max(34px, cmd.preferred-height + 14px);
    border-radius: 8px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.stroke;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        Text { text: "$"; color: Theme.text-dim; font-family: "monospace"; font-size: 12px; vertical-alignment: center; }
        cmd := TextInput {
            horizontal-stretch: 1;
            text: root.command;
            read-only: true;
            color: Theme.text;
            font-family: "monospace";
            font-size: 12px;
            wrap: char-wrap;
            single-line: false;
            vertical-alignment: center;
            accessible-label: @tr("Command");
        }
        Rectangle {
            width: 54px;
            accessible-role: button;
            accessible-label: @tr("Copy command");
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    cmd.select-all();
                    cmd.copy();
                    cmd.clear-selection();
                    root.copied = true;
                }
            }
            Text {
                text: root.copied ? @tr("Copied") : @tr("Copy");
                color: root.copied ? Theme.ok : Theme.accent;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// One installable file on the details page.
export component OptionCard inherits Rectangle {
    in property <OptionRow> option;
    in property <int> index;
    in property <bool> recommended;
    in property <bool> compact;
    // Only the essentials: what it is, that it is checked, and the button. File name,
    // size, command and steps appear when the page's details are opened.
    in property <bool> plain;
    property <bool> busy: Store.install-state == 1;
    property <bool> mine: Store.install-index == index && Store.install-state != 0;
    property <bool> show-steps: false;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: recommended ? Theme.accent.with-alpha(0.55) : Theme.stroke;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        // What kind of file it is matters to some people; that it fits
                        // this device matters to everyone.
                        text: plain ? (option.native ? @tr("Runs on this device") : @tr("Should run on this device")) : option.label;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if recommended && !compact && !plain : Chip { text: @tr("Best for this device"); tone: Theme.accent; }
                    if !option.native && !compact && !plain : Chip { text: @tr("Compatible"); tone: Theme.warn; }
                }
                if plain && option.size != "" : Text { text: @tr("{} download", option.size); color: Theme.text-dim; font-size: 12px; overflow: elide; }
                if !plain : Text {
                    text: option.size != "" ? option.file + "  ·  " + option.size : option.file;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: mine && busy ? @tr("Cancel") : recommended && Store.installed-version != "" && Store.installed-version != Store.app.version ? @tr("Update") : recommended && Store.installed-version != "" && option.verb == @tr("Install") ? @tr("Reinstall") : option.verb;
                    primary: recommended && !(mine && busy);
                    enabled: !busy || mine;
                    accessible-label: (mine && busy ? @tr("Cancel") : option.verb) + " " + option.label;
                    clicked => {
                        if (mine && busy) {
                            Store.cancel-install();
                        } else {
                            Store.install(index);
                        }
                    }
                }
            }
        }
        if recommended && compact && !plain : HorizontalLayout {
            alignment: start;
            Chip { text: @tr("Best for this device"); tone: Theme.accent; }
        }
        if option.note != "" : Text { text: option.note; color: Theme.warn; font-size: 12px; wrap: word-wrap; }
        if option.command != "" && (!plain || Store.is-package) : CommandBox { command: option.command; }
        if option.verified : HorizontalLayout {
            spacing: 5px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image { source: @image-url("icons/shield.svg"); colorize: Theme.ok; width: 13px; height: 13px; }
            }
            Text {
                text: plain ? @tr("Bilby checks the download is the genuine file before installing it") : @tr("Checked against the publisher's SHA-256 after download");
                color: Theme.ok;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !plain : HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 18px;
                width: steps-label.preferred-width;
                accessible-role: button;
                accessible-label: @tr("What happens when I install {}", option.label);
                accessible-expandable: true;
                accessible-expanded: root.show-steps;
                accessible-action-default => { root.show-steps = !root.show-steps; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-steps = !root.show-steps; }
                }
                steps-label := Text {
                    text: root.show-steps ? @tr("Hide steps") : @tr("What will happen?");
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        if root.show-steps && !plain : VerticalLayout {
            spacing: 3px;
            for step[n] in option.steps : Text {
                text: (n + 1) + ".  " + step;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        if mine && busy : ProgressBar { value: Store.install-progress; }
        if mine && !busy : HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                DoneMark { ok: Store.install-state != 3; }
            }
            Text {
                horizontal-stretch: 1;
                text: Store.install-message;
                color: Store.install-state == 3 ? Theme.bad : Theme.ok;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
                accessible-role: text;
            }
        }
    }
}

// A friendly "nothing here" block with an optional action.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <bool> error;
    callback acted;
    alignment: center;
    spacing: 10px;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Image {
            source: @image-url("icons/empty.svg");
            colorize: error ? Theme.bad : Theme.text-dim;
            width: 40px;
            height: 40px;
        }
    }
    Text { text: title; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
    Text { text: body; color: Theme.text-dim; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
    if action != "" : HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        Button { text: action; primary: false; clicked => { root.acted(); } }
    }
}

// A one-line nudge on Discover when the library has updates waiting.
export component UpdatesBanner inherits Rectangle {
    height: 44px;
    border-radius: 12px;
    background: ta.has-hover ? Theme.accent.with-alpha(0.2) : Theme.accent.with-alpha(0.13);
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: @tr("Show updates");
    accessible-action-default => { Store.page = 2; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Store.page = 2;
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Store.page = 2; }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: @tr("{n} app in your library has an update" | "{n} apps in your library have updates" % Store.updates-count);
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text { text: @tr("View"); color: Theme.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; }
    }
}

// Shown once, on first run: what the store does, and what it does not promise.
export component Welcome inherits Rectangle {
    in property <bool> compact;
    border-radius: 14px;
    background: Theme.accent.with-alpha(0.1);
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.35);
    VerticalLayout {
        padding: compact ? 14px : 20px;
        spacing: 8px;
        Text { text: @tr("Welcome to Bilby"); color: Theme.text; font-size: 17px; font-weight: 700; }
        Text {
            text: "•  " + @tr("You are seeing apps for {}. Anything that cannot be installed on this device is hidden.", Store.platform-title);
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: @tr("•  Apps come from many places: package managers, other stores and developers' own release pages. Bilby does not review them, so only install software you trust.");
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: @tr("•  There is no account and no server of ours. Your library and settings stay in a file on this device.");
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Button { text: @tr("Got it"); clicked => { Store.dismiss-welcome(); } }
        }
    }
}

// Under a search: show everything, or only what one source gave.
export component SourceFilter inherits Flickable {
    height: 36px;
    content-width: chips.preferred-width;
    HorizontalLayout {
        alignment: start;
        chips := HorizontalLayout {
            spacing: 8px;
            ChoiceChip { text: @tr("All"); selected: Store.source-filter == ""; clicked => { Store.filter-results(""); } }
            for source in Store.result-sources : ChoiceChip {
                text: source.label + "  " + source.count;
                selected: Store.source-filter == source.id;
                clicked => { Store.filter-results(source.id); }
            }
        }
    }
}

// Asked once, when a controller is attached but nothing says this is a TV.
export component TvQuestion inherits Rectangle {
    in property <bool> compact;
    border-radius: 14px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        padding: compact ? 14px : 20px;
        spacing: 8px;
        Text { text: @tr("Are you using this on a TV?"); color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
        Text {
            text: @tr("A game controller is connected. Bilby has a layout with large text for the sofa, driven with the arrow keys of a remote or keyboard. You can change this later in Settings.");
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            padding-top: 4px;
            Button { text: @tr("Use the TV layout"); clicked => { Store.answer-tv(true); } }
            Button { text: @tr("Keep this layout"); primary: false; clicked => { Store.answer-tv(false); } }
        }
    }
}

// The details page body, shared by the desktop and mobile shells.
// One fact in the row under an app's name: a value and what it is.
component StatCell inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    spacing: 2px;
    accessible-role: text;
    accessible-label: root.value + " " + root.caption;
    Text { text: root.value; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
    Text { text: root.caption; color: Theme.text-dim; font-size: 11px; overflow: elide; }
}

// The average, how many people gave it, and a bar for each number of stars.
component RatingSummary inherits HorizontalLayout {
    spacing: 20px;
    alignment: start;
    accessible-role: text;
    accessible-label: @tr("{0} out of 5, from {1}", Store.app.rating, Store.app.rating-count);
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text { text: Store.app.rating; color: Theme.text; font-size: 40px; font-weight: 700; horizontal-alignment: center; }
        Text { text: @tr("out of 5"); color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
        Text { text: Store.app.rating-count; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        for share[i] in Store.app.rating-spread : HorizontalLayout {
            spacing: 8px;
            Text { width: 26px; text: (5 - i) + " ★"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; horizontal-alignment: right; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 180px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.stroke;
                    Rectangle {
                        x: 0;
                        width: parent.width * share;
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.warn;
                        animate width { duration: Theme.slow; easing: ease-out; }
                    }
                }
            }
            Text { width: 34px; text: round(share * 100) + "%"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
        }
    }
}

// A line of the Information table.
component InfoRow inherits Rectangle {
    in property <string> name;
    in property <string> value;
    height: max(34px, v.preferred-height + 14px);
    accessible-role: text;
    accessible-label: root.name + ": " + root.value;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
    Text { x: 0; width: 130px; text: root.name; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
    v := Text {
        x: 140px;
        width: parent.width - 140px;
        text: root.value;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Long text shown as its first few lines, with the rest one press away.
component Clamped inherits VerticalLayout {
    in property <string> text;
    in property <length> limit: 104px;
    in property <string> what;
    // Changes when the page shows something else, which folds the text again.
    in property <string> key;
    property <bool> open: false;
    changed key => { root.open = false; }
    spacing: 4px;
    Rectangle {
        clip: true;
        height: root.open ? t.preferred-height : min(t.preferred-height, root.limit);
        t := Text {
            x: 0;
            y: 0;
            width: parent.width;
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        // Fade the last line out, so a cut reads as "there is more" on any font.
        if !root.open && t.preferred-height > root.limit : Rectangle {
            y: parent.height - 26px;
            height: 26px;
            background: @linear-gradient(180deg, Theme.bg.with-alpha(0) 0%, Theme.bg 100%);
        }
    }
    // Always there (zero-high when not needed), so the layout's width never depends on
    // how tall the text turned out to be.
    Rectangle {
        property <bool> needed: t.preferred-height > root.limit;
        height: self.needed ? 28px : 0px;
        visible: self.needed;
        accessible-role: button;
        accessible-label: (root.open ? @tr("Show less of {}", root.what) : @tr("Show all of {}", root.what));
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => { root.open = !root.open; }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
        Text {
            x: 0;
            text: root.open ? @tr("Show less") : @tr("Read more");
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// What changed in the release being shown.
component WhatsNew inherits Rectangle {
    height: body.preferred-height;
    body := VerticalLayout {
        width: parent.width;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: Store.is-website ? @tr("About this website") : Store.is-package ? @tr("About this package") : @tr("What's new");
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
            }
            Text {
                text: Store.app.version != "" && !Store.is-package ? Store.app.version + (Store.release-age != "" ? "  ·  " + Store.release-age : "") : Store.release-age;
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Clamped { text: Store.notes; limit: 70px; what: @tr("what is new"); key: Store.app.id + Store.app.version; }
    }
}

// An app's page. Laid out the way the big stores do it, because that is what people
// already know: name and one button at the top, a row of key facts, what it is, what is
// new, and a table of everything else at the bottom.
export component DetailsBody inherits Rectangle {
    in property <bool> compact;
    property <bool> show-hidden: false;
    // Every version and every file, including the ones for other devices: one press
    // away, right under the main button.
    property <bool> more: false;
    property <string> shown-id: Store.app.id;
    changed shown-id => {
        root.more = false;
        root.show-hidden = false;
    }
    property <length> pad: compact ? 16px : 32px;
    property <bool> has-option: Store.options.length > 0;
    property <OptionRow> best: Store.options[0];
    property <bool> busy: Store.install-state == 1;
    property <bool> mine: Store.install-index == 0 && Store.install-state != 0;
    // "installed" alone means the system has it but did not say which version.
    property <bool> is-update: Store.installed-version != "" && Store.installed-version != "installed" && Store.app.version != "" && Store.installed-version != Store.app.version;
    property <bool> open-instead: Store.can-open && !is-update && !(mine && busy);
    property <string> action: mine && busy ? @tr("Cancel") : open-instead ? @tr("Open") : is-update ? @tr("Update") : Store.installed-version != "" && best.verb == @tr("Install") ? @tr("Reinstall") : best.verb;
    function act() {
        if (mine && busy) {
            Store.cancel-install();
        } else if (open-instead) {
            Store.launch();
        } else {
            Store.install(0);
        }
    }
    Flickable {
        VerticalLayout {
            padding: pad;
            padding-bottom: pad + 24px;
            spacing: 18px;
            alignment: start;

            HorizontalLayout {
                spacing: compact ? 14px : 20px;
                AppIcon { initials: Store.app.initials; tint: Store.app.tint; icon: Store.app.icon; size: compact ? 64px : 88px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: Store.app.name; color: Theme.text; font-size: compact ? 24px : 30px; font-weight: 700; overflow: elide; }
                    Text { text: Store.app.author + (Store.app.verified ? "  ✓ " + @tr("verified") : ""); color: Theme.text-dim; font-size: 14px; overflow: elide; }
                }
                if !compact : VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            width: 44px;
                            text: "";
                            icon: Store.is-favourite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
                            icon-color: Store.is-favourite ? Theme.warn : Theme.text;
                            primary: false;
                            accessible-label: Store.is-favourite ? @tr("Remove from favourites") : @tr("Add to favourites");
                            clicked => { Store.toggle-favourite(); }
                        }
                        if root.has-option : Button {
                            min-width: 150px;
                            font-size: 15px;
                            text: root.action;
                            progress: root.mine && root.busy ? Store.install-progress : -1;
                            primary: !(root.mine && root.busy);
                            enabled: !root.busy || root.mine;
                            accessible-label: (root.mine && root.busy ? @tr("Cancel") : root.open-instead ? @tr("Open") : root.best.verb) + " " + (root.open-instead ? Store.app.name : root.best.label);
                            clicked => { root.act(); }
                        }
                    }
                }
            }
            if compact : HorizontalLayout {
                spacing: 8px;
                if root.has-option : Button {
                    horizontal-stretch: 1;
                    font-size: 15px;
                    text: root.action;
                    progress: root.mine && root.busy ? Store.install-progress : -1;
                    primary: !(root.mine && root.busy);
                    enabled: !root.busy || root.mine;
                    accessible-label: (root.mine && root.busy ? @tr("Cancel") : root.open-instead ? @tr("Open") : root.best.verb) + " " + (root.open-instead ? Store.app.name : root.best.label);
                    clicked => { root.act(); }
                }
                Button {
                    width: root.has-option ? 48px : self.preferred-width;
                    horizontal-stretch: root.has-option ? 0 : 1;
                    text: root.has-option ? "" : (Store.is-favourite ? @tr("In your favourites") : @tr("Add to favourites"));
                    icon: Store.is-favourite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
                    icon-color: Store.is-favourite ? Theme.warn : Theme.text;
                    primary: false;
                    accessible-label: Store.is-favourite ? @tr("Remove from favourites") : @tr("Add to favourites");
                    clicked => { Store.toggle-favourite(); }
                }
            }
            // A service with several apps: which one this is, as a list to choose from.
            if Store.app-family.length > 0 : FamilyPanel {
                service: Store.app-family-name;
                others: Store.app-family;
                chosen(id) => { Store.open(id); }
            }
            // Which source the button installs from, right beside it, and the others to
            // switch to. Only when there is a choice.
            if Store.app-sources.length > 1 : HorizontalLayout {
                alignment: compact ? center : end;
                spacing: 8px;
                Text { text: @tr("From"); color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                for source in Store.app-sources : ChoiceChip {
                    text: source.label;
                    selected: source.on;
                    accessible-label: source.on ? @tr("Installing from {}", source.label) : @tr("Switch to {}", source.label);
                    clicked => {
                        if (!source.on) {
                            Store.open(source.id);
                        }
                    }
                }
            }
            // Always within reach of the main button, never competing with it.
            if (root.has-option || Store.hidden.length > 0 || Store.versions.length > 1) && !Store.is-website : HorizontalLayout {
                alignment: compact ? center : end;
                Rectangle {
                    height: 26px;
                    width: more-label.preferred-width;
                    accessible-role: button;
                    accessible-label: @tr("Other versions and files");
                    accessible-expandable: true;
                    accessible-expanded: root.more;
                    accessible-action-default => { root.more = !root.more; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.more = !root.more; }
                    }
                    more-label := Text {
                        text: root.more ? @tr("Hide other versions and files") + "  ▴" : @tr("Other versions and files") + "  ▾";
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            if root.more && Store.versions.length > 1 : Flickable {
                height: 32px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text { text: @tr("Version"); color: Theme.text-dim; font-size: 12px; font-weight: 700; }
                    }
                    for version[i] in Store.versions : ChoiceChip {
                        text: version;
                        selected: i == Store.selected-version;
                        accessible-label: @tr("Version {}", version);
                        clicked => { Store.select-version(i); }
                    }
                }
            }



            if root.more && root.has-option : VerticalLayout {
                spacing: 10px;
                Text { text: @tr("Every way to install on {}", Store.platform-title); color: Theme.text-dim; font-size: 12px; font-weight: 700; }
                for option[i] in Store.options : OptionCard {
                    option: option;
                    index: i;
                    recommended: i == 0;
                    compact: root.compact;
                }
            }

            if root.more && Store.hidden.length > 0 : VerticalLayout {
                spacing: 8px;
                Rectangle {
                    height: 32px;
                    accessible-role: button;
                    accessible-label: @tr("Files that won't work on this device");
                    accessible-expandable: true;
                    accessible-expanded: root.show-hidden;
                    accessible-action-default => { root.show-hidden = !root.show-hidden; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-hidden = !root.show-hidden; }
                    }
                    Text {
                        x: 0;
                        text: (root.show-hidden ? @tr("Hide {n} file for other devices" | "Hide {n} files for other devices" % Store.hidden.length) : @tr("Show {n} file for other devices" | "Show {n} files for other devices" % Store.hidden.length));
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                if root.show-hidden : VerticalLayout {
                    spacing: 6px;
                    for row[i] in Store.hidden : HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text { text: row.file; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                            Text { text: row.reason; color: Theme.text-dim.with-alpha(0.7); font-size: 11px; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                property <bool> mine: Store.install-state == 1 && Store.install-index == 1000 + i;
                                font-size: 12px;
                                text: self.mine ? @tr("Cancel") : compact ? @tr("Download") : @tr("Download anyway");
                                primary: false;
                                enabled: Store.install-state != 1 || self.mine;
                                accessible-label: (self.mine ? @tr("Cancel downloading {}", row.file) : @tr("Download anyway: {}", row.file));
                                clicked => {
                                    if (self.mine) {
                                        Store.cancel-install();
                                    } else {
                                        Store.download-hidden(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.mine && root.busy : ProgressBar { value: Store.install-progress; }
            if root.mine && !root.busy && !root.more : HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: start;
                    DoneMark { ok: Store.install-state != 3; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: Store.install-message;
                    color: Store.install-state == 3 ? Theme.bad : Theme.ok;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    accessible-role: text;
                }
            }

            if Store.app.summary != "" : Text {
                text: Store.app.summary;
                color: Theme.text;
                font-size: 15px;
                wrap: word-wrap;
            }

            // The facts people look for first, as the big stores show them.
            if root.has-option || Store.app.popularity != "" || Store.app.rating != "" || Store.app.downloads != "" : HorizontalLayout {
                spacing: compact ? 16px : 36px;
                alignment: start;
                if Store.app.rating != "" : StatCell { value: "★ " + Store.app.rating; caption: Store.app.rating-count; }
                if Store.app.price != "" : StatCell { value: Store.app.price; caption: @tr("on {}", Store.app.source); }
                if Store.app.downloads != "" : StatCell { value: Store.app.downloads; caption: Store.app.downloads-note; }
                if Store.app.popularity != "" && !(compact && Store.app.downloads != "") : StatCell { value: Store.app.popularity; caption: @tr("on {}", Store.app.source); }
                if root.has-option && root.best.size != "" : StatCell { value: root.best.size; caption: @tr("download"); }
                // On a phone the row holds three facts; the date is under "What's new" too.
                if Store.release-age != "" && !(compact && Store.app.rating != "" && (Store.app.downloads != "" || Store.app.popularity != "")) : StatCell { value: Store.release-age; caption: @tr("last updated"); }
                if Store.license != "" && !compact : StatCell { value: Store.license; caption: @tr("licence"); }
            }

            if root.has-option : HorizontalLayout {
                spacing: 6px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/shield.svg"); colorize: Theme.ok; width: 14px; height: 14px; }
                }
                Text {
                    text: (root.best.native ? @tr("Runs on this device") : @tr("Should run on this device")) + (root.best.verified ? "  ·  " + @tr("Bilby checks the download is the genuine file") : "");
                    color: Theme.ok;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            // Pictures first, as in any store: they say more than the description.
            if Store.screenshots.length > 0 : Flickable {
                height: compact ? 180px : 240px;
                content-width: shots.preferred-width;
                shots := HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    for shot[i] in Store.screenshots : Rectangle {
                        height: compact ? 180px : 240px;
                        width: self.height * shot.width / max(1, shot.height);
                        border-radius: 10px;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        Image {
                            source: shot;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                            accessible-role: image;
                            accessible-label: @tr("Picture {0} of {1}", i + 1, Store.app.name);
                        }
                    }
                }
            }

            if root.has-option && root.best.note != "" : Text { text: root.best.note; color: Theme.warn; font-size: 12px; wrap: word-wrap; }

            if Store.installed-version != "" : Rectangle {
                height: max(40px, banner.preferred-height + 20px);
                border-radius: 10px;
                background: Theme.accent.with-alpha(0.12);
                banner := Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    wrap: word-wrap;
                    text: Store.installed-version == "installed" ? @tr("Installed") : Store.installed-version == Store.app.version || Store.app.version == "" ? @tr("Installed  ·  {}", Store.installed-version) : @tr("Update available  ·  you have {0}, latest is {1}", Store.installed-version, Store.app.version);
                    color: Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    
                }
            }

            if Store.details-loading : VerticalLayout {
                spacing: 10px;
                Text { text: @tr("Checking releases against this device…"); color: Theme.text-dim; font-size: 14px; }
                Busy { }
            }
            if Store.details-error != "" : EmptyState {
                error: true;
                title: @tr("Couldn't load this app");
                body: Store.details-error;
                action: @tr("Try again");
                acted => { Store.retry-details(); }
            }
            if Store.warning != "" : Text { text: Store.warning; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
            if Store.need-note != "" : Text { text: Store.need-note; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
            // Something else is needed first, and this store can install it.
            if Store.helper-id != "" : HorizontalLayout {
                alignment: start;
                Button { text: Store.helper-label; clicked => { Store.open(Store.helper-id); } }
            }

            if Store.unavailable != "" : Rectangle {
                height: un.preferred-height + 28px;
                border-radius: 12px;
                background: Theme.warn.with-alpha(0.1);
                un := Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: Store.unavailable;
                    color: Theme.warn;
                    font-size: 14px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }


            // Someone who already has the app wants to know what changed, as in any store.
            if Store.notes != "" && Store.installed-version != "" : WhatsNew { }

            if Store.about != "" : VerticalLayout {
                spacing: 8px;
                Text { text: @tr("About"); color: Theme.text; font-size: 17px; font-weight: 700; }
                Clamped { text: Store.about; what: @tr("the description"); key: Store.app.id; }
            }

            // Someone who has not installed it reads what it is first.
            if Store.notes != "" && Store.installed-version == "" : WhatsNew { }

            // What people who use it wrote. Only apps a ratings service knows have any.
            if Store.reviews.length > 0 || Store.app.rating-spread.length > 0 : VerticalLayout {
                spacing: 10px;
                Text { text: Store.reviews.length > 0 ? @tr("Ratings and reviews") : @tr("Ratings"); color: Theme.text; font-size: 17px; font-weight: 700; }
                // The score with how the stars are spread, as the big stores show it: an
                // average says little until you see how many people it is an average of.
                if Store.app.rating-spread.length > 0 : RatingSummary { }
                if Store.app.rating-spread.length == 0 && Store.app.rating != "" : Text {
                    text: "★ " + Store.app.rating + "  ·  " + Store.app.rating-count;
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                for review[i] in Store.reviews : Rectangle {
                    border-radius: 12px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    height: body.preferred-height;
                    accessible-role: text;
                    accessible-label: @tr("Review {0}: {1}", i + 1, review.title);
                    body := VerticalLayout {
                        width: parent.width;
                        padding: 14px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: review.stars; color: Theme.warn; font-size: 13px; vertical-alignment: center; }
                            Text {
                                horizontal-stretch: 1;
                                text: review.title;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        if review.text != "" : Text { text: review.text; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                        if review.meta != "" : Text { text: review.meta; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                    }
                }
                Text {
                    text: Store.reviews.length > 0 ? @tr("Reviews are written by other people and come from the ratings service the GNOME and KDE app stores use.") : @tr("Ratings come from the ratings service the GNOME and KDE app stores use.");
                    color: Theme.text-dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            // Everything else, where the stores put it: a plain table at the bottom.
            if root.has-option || Store.license != "" || Store.app.source != "" : VerticalLayout {
                spacing: 0px;
                Text { text: @tr("Information"); color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                if Store.app.source != "" : InfoRow { name: @tr("From"); value: Store.app.source; }
                if Store.app.author != "" && Store.app.author != Store.app.source : InfoRow { name: @tr("Made by"); value: Store.app.author + (Store.app.verified ? " " + @tr("(confirmed by {})", Store.app.source) : ""); }
                if Store.app.price != "" : InfoRow { name: @tr("Price"); value: @tr("{0} on {1}", Store.app.price, Store.app.source); }
                if Store.app.downloads != "" : InfoRow { name: @tr("Downloads"); value: Store.app.downloads + " " + Store.app.downloads-note; }
                if Store.app.popularity != "" : InfoRow { name: @tr("Popularity"); value: @tr("{0} on {1}", Store.app.popularity, Store.app.source); }
                if Store.app.version != "" : InfoRow { name: @tr("Version"); value: Store.app.version; }
                if Store.release-date != "" : InfoRow { name: @tr("Released"); value: Store.release-date; }
                if Store.license != "" : InfoRow { name: @tr("Licence"); value: Store.license; }
                if root.has-option : InfoRow { name: @tr("Works on"); value: Store.platform-title; }
                if root.has-option : InfoRow { name: @tr("Kind of file"); value: root.best.label; }
                if root.has-option && root.best.size != "" : InfoRow { name: @tr("Download size"); value: root.best.size; }
            }

            if !compact : HorizontalLayout {
                spacing: 10px;
                alignment: start;
                if Store.homepage != "" : Button {
                    text: @tr("Project page");
                    primary: false;
                    clicked => { Store.open-url(Store.homepage); }
                }
            }

            // Side by side they are wider than a small phone.
            if compact && Store.homepage != "" : Button {
                text: @tr("Project page");
                primary: false;
                clicked => { Store.open-url(Store.homepage); }
            }

        }
    }
}

component LibraryItem inherits Rectangle {
    in property <LibraryRow> entry;
    in property <bool> compact;
    property <bool> confirm: false;
    property <bool> updating: Store.updating-id == entry.card.id;
    // One update at a time; the others wait their turn.
    property <bool> can-act: Store.updating-id == "" || updating;
    function act() {
        if (entry.status != 3) {
            Store.open(entry.card.id);
        } else if (updating) {
            Store.cancel-install();
        } else {
            Store.update-app(entry.card.id);
        }
    }
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: entry.status == 3 ? Theme.accent.with-alpha(0.55) : Theme.stroke;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                AppIcon { initials: entry.card.initials; tint: entry.card.tint; icon: entry.card.icon; size: 44px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text { text: entry.card.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                Text { text: updating ? @tr("Updating…") : entry.detail; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                if entry.status != 0 : Text {
                    text: entry.status-text;
                    color: entry.status == 3 ? Theme.accent : entry.status == 4 ? Theme.warn : entry.status == 2 ? Theme.ok : Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            if !compact : HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: entry.status != 3 ? @tr("Details") : updating ? @tr("Cancel") : @tr("Update");
                        primary: entry.status == 3 && !updating;
                        enabled: root.can-act;
                        accessible-label: (entry.status != 3 ? @tr("Details of {}", entry.card.name) : updating ? @tr("Cancel updating {}", entry.card.name) : @tr("Update {}", entry.card.name));
                        clicked => { root.act(); }
                    }
                }
                if entry.status == 3 && !updating : VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Skip");
                        primary: false;
                        accessible-label: @tr("Skip this update of {}", entry.card.name);
                        clicked => { Store.skip-update(entry.card.id); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: root.confirm ? @tr("Really remove?") : @tr("Remove");
                        primary: false;
                        danger: true;
                        accessible-label: (root.confirm ? @tr("Confirm removing {}", entry.card.name) : @tr("Remove {}", entry.card.name));
                        clicked => {
                            if (root.confirm) {
                                Store.remove-from-library(entry.card.id);
                            }
                            root.confirm = !root.confirm;
                        }
                    }
                }
            }
        }
        if compact : HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                text: entry.status != 3 ? @tr("Details") : updating ? @tr("Cancel") : @tr("Update");
                primary: entry.status == 3 && !updating;
                enabled: root.can-act;
                accessible-label: (entry.status != 3 ? @tr("Details of {}", entry.card.name) : updating ? @tr("Cancel updating {}", entry.card.name) : @tr("Update {}", entry.card.name));
                clicked => { root.act(); }
            }
            Button {
                horizontal-stretch: 1;
                text: root.confirm ? @tr("Really remove?") : @tr("Remove");
                primary: false;
                danger: true;
                accessible-label: (root.confirm ? @tr("Confirm removing {}", entry.card.name) : @tr("Remove {}", entry.card.name));
                clicked => {
                    if (root.confirm) {
                        Store.remove-from-library(entry.card.id);
                    }
                    root.confirm = !root.confirm;
                }
            }
        }
        // Three buttons do not fit side by side on a narrow phone.
        if compact && entry.status == 3 && !updating : Button {
            text: @tr("Skip this version");
            primary: false;
            accessible-label: @tr("Skip this update of {}", entry.card.name);
            clicked => { Store.skip-update(entry.card.id); }
        }
        if updating : ProgressBar { value: Store.install-progress; }
        if root.confirm : Text {
            text: entry.store-managed ? @tr("This deletes the app's file from your Applications folder.") : @tr("This only forgets the app here. To uninstall it, use your system's software manager.");
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// ---- this device -------------------------------------------------------------------

// The colour that goes with the system's state: calm when fine, loud when not.
component SystemHeadline inherits Text {
    text: Store.system-headline;
    color: Store.system-state == 2 && !Store.system-restart ? Theme.ok : Store.system-state == 5 ? Theme.bad : Store.system-state == 3 || Store.system-restart ? Theme.warn : Theme.text;
    font-weight: 700;
    overflow: elide;
}

// In the library: the operating system, as one more thing that can be up to date or not.
export component SystemCard inherits Rectangle {
    in property <bool> compact;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    height: box.preferred-height;
    box := VerticalLayout {
        width: parent.width;
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: Store.system-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                SystemHeadline { font-size: 13px; }
            }
            if !compact && Store.system-state == 3 : VerticalLayout {
                alignment: center;
                Button { text: @tr("Update system"); clicked => { Store.system-update(); } }
            }
            if !compact : VerticalLayout {
                alignment: center;
                Button { text: @tr("System details"); primary: false; clicked => { Store.system-from = 2; Store.page = 4; } }
            }
        }
        if compact && Store.system-state == 3 : Button { text: @tr("Update system"); clicked => { Store.system-update(); } }
        if compact : Button { text: @tr("System details"); primary: false; clicked => { Store.system-from = 2; Store.page = 4; } }
    }
}

export component SystemBody inherits Rectangle {
    in property <bool> compact;
    property <bool> all-updates: false;
    property <bool> show-log: false;
    property <int> shown: root.all-updates ? Store.system-updates.length : min(Store.system-updates.length, 8);
    Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 16px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                Text { text: Store.system-name; color: Theme.text; font-size: compact ? 22px : 28px; font-weight: 700; wrap: word-wrap; }
                Text { text: Store.system-tagline; color: Theme.text-dim; font-size: 13px; overflow: elide; }
            }

            // The answer at a glance, and the one thing to do about it.
            Rectangle {
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.stroke;
                height: status.preferred-height;
                status := VerticalLayout {
                    width: parent.width;
                    padding: 16px;
                    spacing: 12px;
                    if Store.system-supported : SystemHeadline { font-size: compact ? 18px : 22px; accessible-role: text; }
                    if Store.system-detail != "" : Text { text: Store.system-detail; color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                    if Store.system-restart : Text {
                        text: @tr("Restart this device to finish: something that was updated is still running in its old version.");
                        color: Theme.warn;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if Store.system-note != "" : Text { text: Store.system-note; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    if Store.system-state == 1 : Busy { }
                    if Store.system-state == 4 : VerticalLayout {
                        spacing: 6px;
                        ProgressBar { value: Store.system-progress; }
                        Text {
                            text: (Store.system-progress <= 0.01 ? "" : round(Store.system-progress * 100) + "%" + (Store.system-step != "" ? "  ·  " : "")) + Store.system-step;
                            color: Theme.text-dim;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    if Store.system-state == 4 : Text {
                        text: @tr("You may be asked for your password. Keep the device on until this finishes.");
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if !compact : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if Store.system-state == 3 : Button { text: @tr("Update now"); clicked => { Store.system-update(); } }
                        if Store.system-restart && Store.system-state != 3 && Store.system-state != 4 : Button { text: @tr("Restart now"); clicked => { Store.system-restart-now(); } }
                        if Store.system-supported : Button {
                            text: @tr("Check again");
                            primary: false;
                            enabled: Store.system-state != 1 && Store.system-state != 4;
                            clicked => { Store.system-check(); }
                        }
                        if Store.system-handoff != "" : Button { text: Store.system-handoff; primary: false; clicked => { Store.system-handoff-open(); } }
                    }
                    if compact && Store.system-state == 3 : Button { text: @tr("Update now"); clicked => { Store.system-update(); } }
                    if compact && Store.system-restart && Store.system-state != 3 && Store.system-state != 4 : Button { text: @tr("Restart now"); clicked => { Store.system-restart-now(); } }
                    if compact && Store.system-supported : Button {
                        text: @tr("Check again");
                        primary: false;
                        enabled: Store.system-state != 1 && Store.system-state != 4;
                        clicked => { Store.system-check(); }
                    }
                    if compact && Store.system-handoff != "" : Button { text: Store.system-handoff; primary: false; clicked => { Store.system-handoff-open(); } }
                }
            }

            // What is waiting. The first few are enough for most people.
            if Store.system-updates.length > 0 : VerticalLayout {
                spacing: 0px;
                Text { text: @tr("Waiting to be installed"); color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                for update[i] in Store.system-updates : Rectangle {
                    visible: i < root.shown;
                    height: i < root.shown ? 34px : 0px;
                    accessible-role: text;
                    accessible-label: update.name + ": " + update.change;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text { horizontal-stretch: 1; text: update.name; color: Theme.text; font-size: 13px; overflow: elide; vertical-alignment: center; }
                        Text { text: update.change; color: Theme.text-dim; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
                if Store.system-updates.length > 8 : HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    Button {
                        text: root.all-updates ? @tr("Show fewer") : @tr("Show all {}", Store.system-updates.length);
                        primary: false;
                        clicked => { root.all-updates = !root.all-updates; }
                    }
                }
            }

            // What the updater printed, for whoever wants it.
            if Store.system-log != "" : VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.show-log ? @tr("Hide what the updater said") : @tr("Show what the updater said");
                        primary: false;
                        clicked => { root.show-log = !root.show-log; }
                    }
                }
                if root.show-log : Rectangle {
                    border-radius: 10px;
                    background: Theme.surface;
                    height: log.preferred-height + 24px;
                    log := Text { x: 12px; y: 12px; width: parent.width - 24px; text: Store.system-log; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Text { text: @tr("Information"); color: Theme.text; font-size: 17px; font-weight: 700; }
                Rectangle { height: 6px; }
                for fact in Store.system-facts : InfoRow { name: fact.name; value: fact.value; }
                InfoRow { name: "Bilby"; value: Store.app-version; }
            }
        }
    }
}

export component LibraryBody inherits Rectangle {
    in property <bool> compact;
    if Store.library.length == 0 && Store.favourites.length == 0 && !Store.system-supported : EmptyState {
        title: @tr("Your library is empty");
        body: @tr("Apps you install from the store show up here, and the store can tell you when they have a new release. Favourites are kept here too.");
        action: @tr("Browse apps");
        acted => { Store.page = 0; }
    }
    if Store.library.length > 0 || Store.favourites.length > 0 || Store.system-supported : Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 12px;
            alignment: start;
            // The system itself comes first: it is the update that matters most.
            if Store.system-supported : SystemCard { compact: root.compact; }
            if Store.library.length == 0 && Store.favourites.length == 0 : Text {
                text: @tr("Apps you install from the store show up here, and the store can tell you when they have a new release.");
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
            if Store.library.length == 0 && Store.favourites.length == 0 : HorizontalLayout {
                alignment: start;
                Button { text: @tr("Browse apps"); primary: false; clicked => { Store.page = 0; } }
            }
            if Store.library.length > 0 : HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: Store.checking-updates ? @tr("Checking for updates…") : Store.updates-count == 0 ? (Store.last-checked != "" ? @tr("Everything is up to date") : @tr("{n} app" | "{n} apps" % Store.library.length)) : @tr("{n} update available" | "{n} updates available" % Store.updates-count);
                        color: Theme.text;
                        font-size: compact ? 16px : 20px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if Store.last-checked != "" : Text {
                        text: @tr("Last checked {}", Store.last-checked);
                        color: Theme.text-dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                // On a phone the buttons get their own rows below.
                if !compact && Store.updates-count > 1 : VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Update all");
                        enabled: Store.updating-id == "";
                        clicked => { Store.update-all(); }
                    }
                }
                if !compact : VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Check for updates");
                        primary: false;
                        enabled: !Store.checking-updates && Store.updating-id == "";
                        clicked => { Store.check-updates(); }
                    }
                }
            }
            if compact && Store.updates-count > 1 : Button {
                text: @tr("Update all");
                enabled: Store.updating-id == "";
                clicked => { Store.update-all(); }
            }
            if compact && Store.library.length > 0 : Button {
                text: @tr("Check for updates");
                primary: false;
                enabled: !Store.checking-updates && Store.updating-id == "";
                clicked => { Store.check-updates(); }
            }
            if Store.checking-updates : Busy { }
            for item in Store.library : LibraryItem { entry: item; compact: root.compact; }
            if Store.favourites.length > 0 : Text {
                text: @tr("Favourites");
                color: Theme.text;
                font-size: compact ? 16px : 20px;
                font-weight: 700;
            }
            if Store.favourites.length > 0 : Rectangle {
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;
                VerticalLayout {
                    for app in Store.favourites : AppRow {
                        app: app;
                        clicked => { Store.open(app.id); }
                    }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> title;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 700; }
        @children
    }
}

// Settings, including what the store detected about this device.
export component SettingsBody inherits Rectangle {
    in property <bool> compact;
    property <bool> token-saved: false;
    Flickable {
        VerticalLayout {
            padding: compact ? 16px : 32px;
            padding-top: compact ? 8px : 14px;
            spacing: 14px;
            alignment: start;

            SettingsCard {
                title: @tr("This device  ·  {}", Store.platform-title);
                Text {
                    text: @tr("The store only lists apps with a file that can be installed here. This is what it detected.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                for fact in Store.facts : HorizontalLayout {
                    spacing: 12px;
                    Text { width: compact ? 110px : 170px; text: fact.name; color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                    Text { horizontal-stretch: 1; text: fact.value; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("System details and updates"); primary: false; clicked => { Store.system-from = 3; Store.page = 4; } }
                }
            }

            if Store.can-register : SettingsCard {
                title: @tr("App menu");
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Bilby adds itself to this device's list of apps the first time it runs, so it can be started like any other app. If you move its file, start it once from the new place.");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Show Bilby in the app menu");
                            checked: Store.in-menu;
                            toggled(on) => { Store.set-in-menu(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Where apps come from");
                Text {
                    text: @tr("Switch off any place you do not want apps from. It is then left out of searches and the home page; an app from it can still be opened by its link.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                for source in Store.sources : HorizontalLayout {
                    spacing: 12px;
                    Text { horizontal-stretch: 1; text: source.label; color: Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Show apps from {}", source.label);
                            checked: source.on;
                            toggled(on) => { Store.set-source(source.id, on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Your own sources");
                Text {
                    text: @tr("Apps can also come from a list on your own server or storage: a small file saying what the apps are and where their files live. Add its address and its apps are searched, shown on the home page and installed like any others. Nobody but its owner vouches for what is on such a list, so add only ones you trust.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                for own in Store.own-sources : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text { text: own.label; color: Theme.text; font-size: 14px; overflow: elide; }
                        Text { text: own.id; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button { text: @tr("Remove"); primary: false; accessible-label: @tr("Remove the source {}", own.label); clicked => { Store.remove-own-source(own.id); } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: own-input.has-focus ? Theme.focus : Theme.stroke;
                        own-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            color: Theme.text;
                            font-size: 13px;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-label: @tr("Address of a list of apps");
                            accepted => {
                                Store.add-own-source(self.text);
                                self.text = "";
                            }
                        }
                        if own-input.text == "" : Text { x: 10px; text: "https://your-server/apps.json"; color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
                    }
                    Button {
                        text: @tr("Add");
                        accessible-label: @tr("Add this source");
                        clicked => {
                            Store.add-own-source(own-input.text);
                            own-input.text = "";
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Recommendations");
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Recommend the apps everyone knows"); color: Theme.text; font-size: 14px; }
                        Text {
                            text: @tr("Bilby keeps a short list, chosen by people, of the apps and websites nearly everyone looks for: a browser, a video player, the big names. On, the home page starts with them in the version for this device, and they are placed a little higher in a search. Off, you get only what the sources' own figures say.");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Recommend the apps everyone knows"); checked: Store.show-essentials; toggled(on) => { Store.set-essentials(on); } }
                    }
                }
            }

            SettingsCard {
                title: @tr("Family and adult content");
                Text {
                    text: @tr("Some games, apps and websites are meant for adults. They are kept apart: in a search they have a section of their own, each one covered until you choose it, and you are asked to confirm you are an adult before one opens.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Family mode"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("Nothing for adults is shown anywhere, not even covered, and none of it can be opened.") + " " + (Store.has-pin ? @tr("Switching it off needs the PIN.") : @tr("Set a PIN below so that it cannot simply be switched off.")); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Family mode"); checked: Store.family-mode; toggled(on) => { Store.set-family-mode(on); } }
                    }
                }
                if !Store.family-mode : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Adult content on the home page"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("Off, adult things are only ever found by searching. On, they may also appear on the home page, covered like everywhere else."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Adult content on the home page"); checked: Store.adult-on-home; toggled(on) => { Store.set-adult-on-home(on); } }
                    }
                }
                if !Store.family-mode : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Show adult content uncovered"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("For those who want no cover at all: adult things are shown as they are, among everything else, and open without a question."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Show adult content uncovered"); checked: Store.adult-uncovered; toggled(on) => { Store.set-adult-uncovered(on); } }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: Store.has-pin ? @tr("A PIN is set") : @tr("PIN"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("Four digits. With a PIN set, it is asked for to change anything in this card and to open adult content, in place of the question about being an adult."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: Store.has-pin ? @tr("Change PIN") : @tr("Set a PIN"); primary: !Store.has-pin; clicked => { Store.set-pin(); } }
                            if Store.has-pin : Button { text: @tr("Remove PIN"); primary: false; clicked => { Store.remove-pin(); } }
                        }
                    }
                }
                if Store.has-pin : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Ask for the PIN to install or remove apps"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("So that nothing is added to or taken off this device without it."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Ask for the PIN to install or remove apps"); checked: Store.pin-for-installs; toggled(on) => { Store.set-pin-for-installs(on); } }
                    }
                }
                Text {
                    text: @tr("Bilby goes by what its sources say: Steam's adult-only marks, an app's own age rating, and its list of well-known adult sites. A site it has never heard of is not recognised, and most sources say nothing about age at all.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            SettingsCard {
                title: @tr("Layout");
                Text {
                    text: @tr("The TV layout has large text and is driven with the arrow keys of a remote or keyboard. To come back from it, open This TV at the top of its screen.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ChoiceChip { text: @tr("Automatic"); selected: Store.interface-mode == 0; clicked => { Store.set-interface(0); } }
                    ChoiceChip { text: @tr("Desktop"); selected: Store.interface-mode == 1; clicked => { Store.set-interface(1); } }
                    ChoiceChip { text: @tr("TV"); selected: Store.interface-mode == 2; clicked => { Store.set-interface(2); } }
                }
            }

            SettingsCard {
                // In English as well, always: findable by someone who cannot read
                // the language Bilby is in.
                title: @tr("Language") == "Language" ? "Language" : @tr("Language") + "  ·  Language";
                property <int> per-row: compact ? 3 : 5;
                for r in Math.ceil(Store.languages.length / self.per-row) : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for choice[i] in Store.languages : ChoiceChip {
                        visible: Math.floor(i / per-row) == r;
                        width: self.visible ? self.preferred-width : 0;
                        text: choice.label;
                        selected: choice.on;
                        clicked => { Store.set-language(choice.id); }
                    }
                }
            }

            SettingsCard {
                title: @tr("Appearance");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ChoiceChip { text: @tr("Match system"); selected: Store.theme-mode == 0; clicked => { Store.set-theme(0); } }
                    ChoiceChip { text: @tr("Light"); selected: Store.theme-mode == 1; clicked => { Store.set-theme(1); } }
                    ChoiceChip { text: @tr("Dark"); selected: Store.theme-mode == 2; clicked => { Store.set-theme(2); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Sounds: a quiet tick or pop as you move about and press things.");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Sounds");
                            checked: Store.sounds;
                            toggled(on) => { Store.set-sounds(on); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Reduce motion: pages and buttons change at once instead of moving.");
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Reduce motion");
                            checked: Theme.reduce-motion;
                            toggled(on) => { Store.set-reduce-motion(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Releases");
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: @tr("Include pre-releases"); color: Theme.text; font-size: 14px; }
                        Text {
                            text: @tr("Offer betas and release candidates as soon as they are published. They may be unstable.");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Include pre-releases");
                            checked: Store.include-prereleases;
                            toggled(on) => { Store.set-prereleases(on); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: @tr("Show ratings and reviews"); color: Theme.text; font-size: 14px; }
                        Text {
                            text: @tr("They come from the service the GNOME and KDE app stores use (odrs.gnome.org). Star ratings arrive as one file a day for every app. Written reviews are asked for when you open the page of an app that has them, which tells that service which app it was. Nothing that identifies you is sent.");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Show ratings and reviews");
                            checked: Store.show-ratings;
                            toggled(on) => { Store.set-ratings(on); }
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Updates");
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Text { text: @tr("Check for updates when the store opens"); color: Theme.text; font-size: 14px; wrap: word-wrap; }
                        Text {
                            text: @tr("Uses one request per app in your library. Turn it off if GitHub's allowance is tight; you can still check from the Library page.");
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: @tr("Check for updates when the store opens");
                            checked: Store.check-updates-on-start;
                            toggled(on) => { Store.set-check-on-start(on); }
                        }
                    }
                }
            }

            if Store.steam-available : SettingsCard {
                title: @tr("Steam");
                Text {
                    text: Store.steam-signed-in ? @tr("Signed in. Bilby knows {} in your Steam library and marks them Owned.", Store.steam-summary) : Store.steam-state == 1 ? @tr("Sign in on Steam's page in the window that opened. Close it to stop.") : Store.steam-state == 2 ? @tr("Sign in on Steam's page in Longboard, then choose to share your library.") : Store.steam-state == 3 ? @tr("Scan this with the Steam app on your phone and approve the sign-in there.") : @tr("Sign in to see which Steam games you already own. Bilby keeps only the list of what you own, on this device. Choose how:");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if !Store.steam-signed-in && Store.steam-state == 0 : VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Button { text: @tr("Sign in with a QR code"); min-width: 200px; accessible-label: @tr("Sign in to Steam with a QR code"); clicked => { Store.steam-signin-qr(); } }
                        }
                        Text { horizontal-stretch: 1; text: @tr("Scan a code with the Steam app on your phone. Nothing to type. Steam gives Bilby a key to your account, which Bilby uses once to read the list and then throws away."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Button { text: @tr("Sign in in a browser"); primary: false; min-width: 200px; accessible-label: @tr("Sign in to Steam in a browser"); clicked => { Store.steam-signin(); } }
                        }
                        Text { horizontal-stretch: 1; text: @tr("Steam's own sign-in page opens in a small window. The browser asks Steam for the list, so no key ever reaches Bilby."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                    }
                }
                if Store.steam-state == 3 : HorizontalLayout {
                    alignment: start;
                    spacing: 16px;
                    Rectangle {
                        width: 216px;
                        height: 216px;
                        border-radius: 12px;
                        background: white;
                        accessible-role: AccessibleRole.image;
                        accessible-label: @tr("QR code to scan with the Steam app");
                        if Store.steam-qr.width > 0 : Image {
                            width: 200px;
                            height: 200px;
                            source: Store.steam-qr;
                            image-rendering: pixelated;
                        }
                        if Store.steam-qr.width == 0 : Busy { }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: Store.steam-qr-scanned ? @tr("Scanned. Approve it in the Steam app.") : @tr("Waiting for the Steam app…"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: @tr("The code refreshes by itself."); color: Theme.text-dim; font-size: 12px; }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    if Store.steam-state != 0 : Button { text: @tr("Stop waiting"); primary: false; accessible-label: @tr("Stop waiting for Steam"); clicked => { Store.steam-cancel(); } }
                    if Store.steam-signed-in && Store.steam-state == 0 : Button { text: @tr("Sign out"); primary: false; accessible-label: @tr("Sign out of Steam"); clicked => { Store.steam-signout(); } }
                }
            }

            SettingsCard {
                title: @tr("GitHub access");
                Text {
                    text: Store.has-token ? @tr("You are signed in. GitHub allows 5,000 requests an hour.") : @tr("Everything works without signing in, but GitHub then allows only 60 requests an hour for your whole network, which a few searches can use up. Signing in raises that to 5,000. Bilby asks for no access to your account.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if !Store.has-token && Store.signin-state == 0 : HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Sign in with GitHub"); clicked => { Store.github-signin(); } }
                }
                if Store.signin-state == 1 : Busy { }
                // The code to type at GitHub, large enough to read across a room.
                if Store.signin-state == 2 : Rectangle {
                    border-radius: 12px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.5);
                    height: code-box.preferred-height;
                    code-box := VerticalLayout {
                        width: parent.width;
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: @tr("On this or any other device, open github.com/login/device and enter this code:");
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: Store.signin-code;
                            color: Theme.text;
                            font-size: 30px;
                            font-weight: 800;
                            letter-spacing: 3px;
                            accessible-role: text;
                            accessible-label: @tr("Sign-in code {}", Store.signin-code);
                        }
                        Busy { }
                        Text { text: @tr("Waiting for you to enter it. This page updates by itself."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: @tr("Open that page"); clicked => { Store.open-url("https://github.com/login/device"); } }
                            Button { text: @tr("Cancel"); primary: false; accessible-label: @tr("Cancel signing in"); clicked => { Store.github-cancel(); } }
                        }
                    }
                }
                Text {
                    text: @tr("Or paste a personal access token (one with no scopes is enough):");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if Store.quota-text != "" : Text {
                    text: Store.quota-text;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.bg;
                        border-width: token.has-focus ? 2px : 1px;
                        border-color: token.has-focus ? Theme.accent : Theme.stroke;
                        if token.text == "" : Text {
                            x: 12px;
                            text: Store.has-token ? @tr("Paste a new token to replace it") : @tr("Paste a token");
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        token := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 100%;
                            color: Theme.text;
                            font-size: 13px;
                            single-line: true;
                            input-type: password;
                            vertical-alignment: center;
                            accessible-label: @tr("GitHub token");
                            edited => { root.token-saved = false; }
                            accepted => {
                                Store.save-token(self.text);
                                self.text = "";
                                root.token-saved = true;
                            }
                        }
                    }
                    Button {
                        text: root.token-saved ? @tr("Saved") : @tr("Save");
                        primary: false;
                        enabled: token.text != "";
                        accessible-label: @tr("Save token");
                        clicked => {
                            Store.save-token(token.text);
                            token.text = "";
                            root.token-saved = true;
                        }
                    }
                    if Store.has-token : Button {
                        text: @tr("Sign out");
                        primary: false;
                        danger: true;
                        accessible-label: @tr("Sign out of GitHub");
                        clicked => {
                            Store.save-token("");
                            root.token-saved = false;
                        }
                    }
                }
            }

            SettingsCard {
                title: @tr("Storage");
                HorizontalLayout {
                    spacing: 12px;
                    Text { width: compact ? 110px : 170px; text: @tr("Downloads go to"); color: Theme.text-dim; font-size: 13px; }
                    Text { horizontal-stretch: 1; text: Store.downloads-dir; color: Theme.text; font-size: 13px; wrap: char-wrap; }
                }
                Text {
                    text: @tr("Installers and other files Bilby downloads are saved here. Apps that run as one file (AppImages) are then moved to the Applications folder in your home folder; packages, Flatpaks and store apps go where your system puts them.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: @tr("Change folder"); primary: false; accessible-label: @tr("Change the downloads folder"); clicked => { Store.choose-downloads(); } }
                    if Store.downloads-custom : Button { text: @tr("Use the usual folder"); primary: false; clicked => { Store.set-downloads(""); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: folder-input.has-focus ? Theme.focus : Theme.stroke;
                        folder-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            color: Theme.text;
                            font-size: 13px;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-label: @tr("Downloads folder path");
                            accepted => {
                                Store.set-downloads(self.text);
                                self.text = "";
                            }
                        }
                        if folder-input.text == "" : Text { x: 10px; text: @tr("Or type a folder's full path and press Enter"); color: Theme.text-dim; font-size: 13px; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: @tr("Ask where to save each download"); color: Theme.text; font-size: 14px; }
                        Text { text: @tr("A folder chooser opens before each file is fetched. Backing out of it cancels the download."); color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle { label: @tr("Ask where to save each download"); checked: Store.ask-where; toggled(on) => { Store.set-ask-where(on); } }
                    }
                }
                // Side by side where there is room, stacked on a phone.
                if !compact : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: @tr("Open folder"); primary: false; accessible-label: @tr("Open downloads folder"); clicked => { Store.open-downloads(); } }
                    Button { text: @tr("Clear cached catalog data"); primary: false; clicked => { Store.clear-cache(); } }
                    if Store.recent.length > 0 : Button { text: @tr("Clear search history"); primary: false; clicked => { Store.clear-recent(); } }
                }
                if compact : VerticalLayout {
                    spacing: 8px;
                    Button { text: @tr("Open folder"); primary: false; accessible-label: @tr("Open downloads folder"); clicked => { Store.open-downloads(); } }
                    Button { text: @tr("Clear cached catalog data"); primary: false; clicked => { Store.clear-cache(); } }
                    if Store.recent.length > 0 : Button { text: @tr("Clear search history"); primary: false; clicked => { Store.clear-recent(); } }
                }
            }

            if Store.prefer-applies : SettingsCard {
                title: @tr("Preferred kind of app");
                Text {
                    text: @tr("Many apps come more than one way. Choose which Bilby offers first when there is a choice. Automatic picks what suits this system: its own packages on most, Flatpak on a read-only system such as Fedora Kinoite. You can always pick another on an app's page.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ChoiceChip { text: @tr("Automatic"); selected: Store.prefer-kind == 0; clicked => { Store.set-prefer-kind(0); } }
                    ChoiceChip { text: @tr("Flatpak"); selected: Store.prefer-kind == 1; clicked => { Store.set-prefer-kind(1); } }
                    ChoiceChip { text: @tr("AppImage"); selected: Store.prefer-kind == 2; clicked => { Store.set-prefer-kind(2); } }
                    ChoiceChip { text: @tr("System packages"); selected: Store.prefer-kind == 3; clicked => { Store.set-prefer-kind(3); } }
                }
            }

            SettingsCard {
                title: @tr("About");
                if Store.store-update != "" : HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: @tr("Bilby {0} is available. You have {1}.", Store.store-update, Store.app-version);
                            color: Theme.accent;
                            font-size: 14px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    Button {
                        text: @tr("View update");
                        accessible-label: @tr("View the store's update");
                        clicked => { Store.view-store-update(); }
                    }
                }
                if Store.store-update == "" : HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Check for a newer Bilby"); primary: false; clicked => { Store.check-store-update(); } }
                }
                Text {
                    text: @tr("Bilby {}. Everything runs on this device: there is no account and no server of ours. The store talks directly to the places apps come from, and keeps your library and settings in a file on this device.", Store.app-version);
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("Apps come from the sources listed above and are not reviewed by Bilby. Install software you trust. Made with Slint.");
                    color: Theme.text-dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                if Store.demo : Text {
                    text: @tr("Demo mode: the catalog is fictional and nothing is fetched from the network.");
                    color: Theme.warn;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Short feedback that goes away by itself. Fills its parent; only the pill is drawn.
export component Toast inherits Rectangle {
    in property <length> bottom: 24px;
    property <bool> shown: Store.toast != "";
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - root.bottom + (root.shown ? 0px : 14px);
        width: min(root.width - 32px, label.preferred-width + 60px);
        height: 44px;
        border-radius: 22px;
        background: Theme.text;
        opacity: root.shown ? 1 : 0;
        visible: self.opacity > 0;
        accessible-role: text;
        accessible-label: Store.toast;
        animate opacity { duration: Theme.smooth; }
        animate y { duration: Theme.smooth; easing: ease-out; }
        TouchArea {
            clicked => { Store.dismiss-toast(); }
        }
        label := Text {
            x: 20px;
            width: parent.width - 40px;
            text: Store.toast;
            color: Store.toast-is-error ? (Theme.dark ? #b3261e : #ffb4ab) : Theme.bg;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The question that stands in front of something guarded: "are you 18 or over?" or
// the PIN. It covers the whole window; nothing behind it can be reached.
export component GateOverlay inherits Rectangle {
    property <string> entry;
    property <int> count: 0;
    function digit(d: string) {
        root.entry += d;
        root.count += 1;
        if (root.count == 4) {
            Store.gate-pin(root.entry);
            root.entry = "";
            root.count = 0;
        }
    }
    function rub() {
        // Only whole entries are ever sent, so starting again is the simplest undo.
        root.entry = "";
        root.count = 0;
    }
    background: #000000b0;
    TouchArea { }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Store.gate-cancel();
            } else if (Store.gate >= 2 && (event.text == "0" || event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4" || event.text == "5" || event.text == "6" || event.text == "7" || event.text == "8" || event.text == "9")) {
                root.digit(event.text);
            } else if (Store.gate >= 2 && event.text == Key.Backspace) {
                root.rub();
            }
            accept
        }
    }
    Rectangle {
        width: min(parent.width - 32px, 420px);
        height: box.preferred-height;
        border-radius: 16px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.stroke;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: Store.gate-title;
        box := VerticalLayout {
            width: parent.width;
            padding: 24px;
            spacing: 14px;
            Text { text: Store.gate-title; color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
            Text { text: Store.gate-text; color: Theme.text-dim; font-size: 14px; wrap: word-wrap; }
            if Store.gate == 1 : HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Button { text: Store.gate-no; primary: false; accessible-label: Store.gate-no == @tr("No") ? @tr("No, I am not") : Store.gate-no; clicked => { Store.gate-answer(false); } }
                Button { text: Store.gate-yes; clicked => { Store.gate-answer(true); } }
            }
            if Store.gate >= 2 : VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 14px;
                    for filled in [root.count > 0, root.count > 1, root.count > 2, root.count > 3] : Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: filled ? Theme.accent : transparent;
                        border-width: 2px;
                        border-color: filled ? Theme.accent : Theme.stroke;
                    }
                }
                if Store.gate-error != "" : Text { text: Store.gate-error; color: Theme.bad; font-size: 13px; horizontal-alignment: center; }
                for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]] : HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    for d in row : Button { text: d; primary: false; min-width: 64px; accessible-label: @tr("Digit {}", d); clicked => { root.digit(d); } }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: @tr("Clear"); primary: false; min-width: 64px; clicked => { root.rub(); } }
                    Button { text: "0"; primary: false; min-width: 64px; accessible-label: @tr("Digit 0"); clicked => { root.digit("0"); } }
                    Button { text: @tr("Cancel"); primary: false; min-width: 64px; accessible-label: @tr("Cancel the PIN"); clicked => { Store.gate-cancel(); } }
                }
            }
        }
    }
}
