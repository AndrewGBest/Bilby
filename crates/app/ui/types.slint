// Everything the Rust side and the three interfaces share. The interfaces never talk to
// each other or to the network: they render `Store` and call its callbacks.

export enum Shell { desktop, mobile, tv }

export struct AppCard {
    id: string,
    name: string,
    author: string,
    summary: string,
    source: string,
    // What would be installed here, e.g. "AppImage · x86_64". Empty until checked.
    badge: string,
    version: string,
    popularity: string,
    initials: string,
    tint: color,
    // The owner's picture once it has been fetched; empty until then.
    icon: image,
    // In the library, and whether a newer release is known.
    installed: bool,
    // "4.6" and "931 ratings", when a ratings service knows the app; else "".
    rating: string,
    rating-count: string,
    // The share of ratings at five stars, four, three, two and one. Empty when unknown.
    rating-spread: [float],
    // "48k downloads", where the host counts them; else "". The note says what was
    // counted: "of recent versions" or "in total".
    downloads: string,
    downloads-note: string,
    // What it costs where it is sold: "Free", "$9.99". "" where everything is free.
    price: string,
    // The one figure a tile has room for: downloads where known, else `popularity`.
    headline: string,
    // The source has confirmed who the developer is.
    verified: bool,
    // How many other sources have this same app (0 when this is the only one).
    more-sources: int,
    // The one figure a tile always shows: rating, or how many use it, with the price.
    stat: string,
    // For adults: in a listing this card is a cover, with nothing of the app on it.
    adult: bool,
    has-update: bool,
}

export struct Section {
    title: string,
    apps: [AppCard],
}

export struct OptionRow {
    file: string,
    label: string,
    size: string,
    // Caveat such as "runs through Rosetta 2". Empty for native builds.
    note: string,
    native: bool,
    // The release publishes a SHA-256 for this file; it is checked after download.
    verified: bool,
    verb: string,
    steps: [string],
    command: string,
}

export struct HiddenRow {
    file: string,
    reason: string,
}

// What one person wrote about an app.
export struct ReviewRow {
    // "★★★★☆"
    stars: string,
    title: string,
    text: string,
    // "Ana  ·  2026-10-02  ·  version 4.1"
    meta: string,
}

// Somewhere a review of the open app can be left.
export struct ReviewPlace {
    // "odrs", or a store's short name ("steam").
    id: string,
    name: string,
    // What choosing it does.
    note: string,
    // Sent from here; otherwise the store's own page is opened.
    from-here: bool,
    chosen: bool,
}

export struct Fact {
    name: string,
    value: string,
}

// One update waiting for the operating system.
export struct SystemUpdate {
    name: string,
    // "6.11.5 → 6.11.6", or just the new version when the old one is not known.
    change: string,
    // The package manager it comes through.
    via: string,
}

// A source of apps that can be switched on and off, or filtered by.
// One app among several for the same service ("YouTube": VacuumTube, FreeTube, ...).
// A Windows app that is installed, and what it does differently from the others.
export struct WindowsApp {
    id: string,
    name: string,
    // 0 the same as the others, 1 the standard Proton, 2 GE-Proton.
    proton: int,
    // Performance figures: 0 the same as the others, 1 on, 2 off.
    overlay: int,
}

export struct VersionChoice {
    id: string,
    // "VacuumTube".
    name: string,
    // A few words on what kind of version it is.
    note: string,
    // Made by the service's owner.
    official: bool,
    on: bool,
}

// A row of the TV's list of other choices on an app's page: another way to use the
// service, or the same app from another source.
// A key of the TV's on-screen keyboard. `col` and `span` count in tenths of its width.
export struct OskKey {
    label: string,
    row: int,
    col: int,
    span: int,
    // Not a letter: space, delete, shift and the like.
    wide: bool,
    // The key that searches.
    go: bool,
}

export struct TvChoice {
    id: string,
    name: string,
    // A few words under the name on what this choice is.
    note: string,
    // Set on the first row of each group: what the group is.
    heading: string,
}

export struct SourceChoice {
    // Its short name: "flathub", "steam".
    id: string,
    label: string,
    on: bool,
    // In search results: how many of them it gave.
    count: int,
}

export struct LibraryRow {
    card: AppCard,
    // "AppImage · x86_64  ·  installed 2026-11-19"
    detail: string,
    // 0 not checked, 1 checking, 2 up to date, 3 update available, 4 could not check
    status: int,
    status-text: string,
    // The store placed the file itself, so it can also delete it.
    store-managed: bool,
}

export global Store {
    // --- device -----------------------------------------------------------------
    in property <Shell> shell: Shell.desktop;
    // Desktop and mobile swap automatically with the window width; TV is explicit.
    in property <bool> adaptive: true;
    in property <string> platform-title;
    // The same in everyday words: "This Linux computer".
    in property <string> device-name;
    in property <[Fact]> facts;
    in property <bool> demo;
    in property <string> app-version;

    // --- browse -----------------------------------------------------------------
    in property <[Section]> sections;
    in property <[string]> categories;
    // "" shows every category.
    in-out property <string> category;
    in property <AppCard> spotlight;
    // Same content arranged for the TV grid: library and search results come first.
    in property <[Section]> tv-rows;
    // The kinds of app there are, for the TV's page of categories: each a tile whose id
    // opens everything of that kind.
    in property <[AppCard]> tv-categories;
    // The TV's Library page: updates first, then what is installed, then favourites.
    in property <[Section]> tv-library-rows;
    // 0 discover, 1 search, 2 library, 3 settings, 4 this device (reached from the
    // library and from settings; it has no navigation entry of its own)
    in-out property <int> page;
    // The page the device page was opened from, which its back arrow returns to.
    in-out property <int> system-from: 2;
    in-out property <string> query;
    in property <bool> searching;
    in property <bool> searched;
    in property <[AppCard]> results;
    in property <string> search-note;
    in property <string> search-error;
    // The sources the current results came from, and the one being shown ("" for all).
    in property <[SourceChoice]> result-sources;
    in property <string> source-filter;
    in property <[string]> recent;

    // --- details ----------------------------------------------------------------
    in-out property <bool> details-open;
    in property <bool> details-loading;
    in property <string> details-error;
    in property <AppCard> app;
    // Every source that has this app, when more than one does. `id` is the app's id at
    // that source and `on` marks the one this page is showing.
    in property <[SourceChoice]> app-sources;
    // The other ways to use the service this app belongs to, that work on this device
    // ("YouTube": VacuumTube, FreeTube, ...). On the service's own app, everything
    // else; on an app someone else made, the service's own.
    in property <[VersionChoice]> app-family;
    in property <string> app-family-name;
    // An app that is needed first (Steam, for a Steam game), which this store can
    // install: its id and what to call it. "" when nothing is missing.
    // For the TV's Versions list: the other versions and sources as rows to choose,
    // each labelled with what choosing it does.
    in property <[TvChoice]> tv-choices;
    in property <string> helper-id;
    in property <string> helper-label;
    // Why that is needed, in a sentence, when it is not obvious (an AppImage and FUSE).
    in property <string> need-note;
    in property <string> release-date;
    in property <string> release-age;
    in property <string> license;
    in property <string> notes;
    // Web addresses found in the description and notes, for a remote to pick from.
    in property <[string]> about-links;
    // The start of the project's README as plain text, "" when there is none.
    in property <string> about;
    // Pictures of the app found in its README.
    in property <[image]> screenshots;
    // The picture of the open app that is being looked at large, counted from 0, or
    // -1 for none. On a computer or phone; the TV keeps its own.
    in-out property <int> picture: -1;
    // Written reviews, for apps a ratings service knows. Empty for every other app.
    in property <[ReviewRow]> reviews;
    // Where a review of the open app can be left. Empty when nowhere takes one.
    in property <[ReviewPlace]> review-places;
    // One of the chosen places is a store's own page: the words are copied for it.
    in property <bool> review-copies;
    // One of the chosen places takes the review from here, with a title and a name.
    in property <bool> review-from-here;
    // The name shown next to the last review, offered again.
    in-out property <string> review-name;
    // What is being written where there is no keyboard to type with (a TV): the
    // on-screen keyboard types into these.
    in-out property <string> review-title;
    in-out property <string> review-text;
    // What the on-screen keyboard types into: 0 the search, 1 a review's title,
    // 2 its text, 3 the name shown next to it.
    in-out property <int> osk-target;
    // 0 writing, 1 being sent, 2 done.
    in property <int> review-state;
    // Why the review cannot be sent yet, or why it was refused.
    in property <string> review-problem;
    // What became of it, a line for each place.
    in property <string> review-result;
    in property <string> warning;
    in property <string> homepage;
    // The open app's own page at the source it is downloaded from. Empty when the
    // source has none.
    in property <string> source-page;
    // Set when nothing in the app's releases fits this machine.
    in property <string> unavailable;
    in property <[OptionRow]> options;
    in property <[HiddenRow]> hidden;
    // Version in the library or installed by the system's package manager, "" when neither.
    in property <string> installed-version;
    // The app is a package (AUR or a system repository) rather than a project's release.
    in property <bool> is-package;
    // The app is a website that opens in Longboard (Linux TVs).
    in property <bool> is-website;
    // Releases that have a file for this machine, newest first, and the one shown.
    in property <[string]> versions;
    in property <int> selected-version;
    // The open app is in the person's favourites.
    in property <bool> is-favourite;
    // The store placed this app itself and can start it.
    in property <bool> can-open;
    // The open app is in the library, so it can be removed from it.
    in property <bool> in-library;
    // On the device, not installed by the store, and the store can take it off.
    in property <bool> can-uninstall;
    // On the device, not installed by the store, and the tool that looks after it has
    // an update waiting for it. `outside-change` is "1.2 → 1.3", as much as is known.
    in property <bool> outside-update;
    in property <string> outside-change;

    // --- install ----------------------------------------------------------------
    // 0 idle, 1 working, 2 done, 3 failed
    in property <int> install-state;
    // The app on the page is waiting its turn behind another download.
    in property <bool> queued;
    in property <int> install-index;
    in property <float> install-progress;
    in property <string> install-message;
    // What the open app's last install did, step by step. The page folds it away
    // until asked (`log-open`).
    in property <string> install-log;
    in-out property <bool> log-open;

    // --- library ----------------------------------------------------------------
    in property <[LibraryRow]> library;
    // Apps on the device that the store did not install: Flatpaks, Steam games and
    // what the system's package manager put in the app menu.
    in property <[AppCard]> also-installed;
    in property <int> updates-count;
    in property <bool> checking-updates;
    in property <string> last-checked;
    // The library app being updated in place right now, "" when none.
    in property <string> updating-id;
    // Apps marked to come back to; kept on this device like everything else.
    in property <[AppCard]> favourites;

    // --- this device ------------------------------------------------------------
    // "Ubuntu 24.04.1 LTS" and "Linux 6.8.0 · x86_64".
    in property <string> system-name;
    in property <string> system-tagline;
    in property <[Fact]> system-facts;
    // The store can check for and install this system's updates.
    in property <bool> system-supported;
    // Why it cannot, or what else the person should know. "" when there is nothing to say.
    in property <string> system-note;
    // The label of a button that opens the system's own update page, "" when none.
    in property <string> system-handoff;
    // 0 not checked, 1 checking, 2 up to date, 3 updates waiting, 4 installing, 5 could not check
    in property <int> system-state;
    // "Up to date", "6 updates available": the answer at a glance.
    in property <string> system-headline;
    in property <string> system-detail;
    in property <[SystemUpdate]> system-updates;
    // Something already installed needs a restart to take effect.
    in property <bool> system-restart;
    // While installing (state 4): how far it has got, 0 to 1, and what it is on now.
    in property <float> system-progress;
    in property <string> system-step;
    // What the updater printed the last time it ran.
    in property <string> system-log;

    // --- settings ---------------------------------------------------------------
    in property <int> theme-mode;
    in property <bool> include-prereleases;
    in property <bool> show-ratings;
    in property <bool> check-updates-on-start;
    in property <bool> has-token;
    // Signing in to GitHub with a code: 0 not signing in, 1 asking GitHub for a code,
    // 2 waiting for the person to enter `signin-code` at github.com/login/device.
    // Signing in to Steam on Steam's own page: 0 not signing in, 1 its page is open
    // in the store's sign-in window, 2 it is open in Longboard.
    // 3: a code is on screen for the Steam app on a phone to scan.
    in property <int> steam-state;
    in property <image> steam-qr;
    // The Steam app has read the code; the person has yet to approve.
    in property <bool> steam-qr-scanned;
    in property <bool> steam-available;
    in property <bool> steam-signed-in;
    // "312 games and tools", when signed in.
    in property <string> steam-summary;
    // GOG: 0 idle, 1 waiting for the sign-in window.
    in property <int> gog-state;
    in property <bool> gog-available;
    in property <bool> gog-signed-in;
    in property <string> gog-summary;
    in property <int> signin-state;
    in property <string> signin-code;
    in property <string> downloads-dir;
    // The person chose that folder; false for the usual one.
    in property <bool> downloads-custom;
    // Ask where to save each download.
    in property <bool> ask-where;
    // A newer release of the store itself that has a file for this device, "" when none.
    in property <string> store-update;
    // GitHub's remaining request allowance, in words. Empty until known.
    in property <string> quota-text;
    // First run: explain what this store is before anything is installed.
    in property <bool> show-welcome;
    // 0 decide for me, 1 desktop, 2 TV
    in property <int> interface-mode;
    // Every source that applies to this device, and whether it is switched on.
    in property <[SourceChoice]> sources;
    // Family mode: nothing for adults anywhere. Adult things on the home page only
    // where asked for. A PIN, where set, guards these and adult content.
    // Recommend the hand-kept list of apps nearly everyone expects.
    // The quiet sounds of moving about.
    in property <bool> sounds;
    in property <bool> show-essentials;
    // Also show what does not run on this device (marked, and not installable).
    in property <bool> show-everything;
    // Windows programs can be set up to run on this device, and whether they are offered.
    in property <bool> windows-possible;
    in property <bool> windows-apps;
    callback set-windows-apps(bool);
    // Which part of the settings is showing: 0 general, 1 stores, 2 accounts,
    // 3 Windows apps, 4 family, 5 updates, 6 storage and about.
    in-out property <int> settings-section;
    // How Windows apps run in general: 0 the standard Proton, 1 GE-Proton; whether
    // performance figures are drawn and GameMode used, and whether those are installed.
    in property <int> windows-proton;
    in property <bool> windows-overlay;
    in property <bool> windows-gamemode;
    in property <bool> has-mangohud;
    in property <bool> has-gamemode;
    callback set-windows-proton(int);
    callback set-windows-overlay(bool);
    callback set-windows-gamemode(bool);
    // The Windows apps that are installed, each with what it does differently.
    in property <[WindowsApp]> windows-installed;
    // An app's own choices: its id, Proton (0 same, 1 standard, 2 GE), figures (0 same, 1 on, 2 off).
    callback set-windows-app(string, int, int);
    callback open-windows-tool(string);
    callback open-windows-folder(string);
    in property <bool> auto-update;
    // This desktop has a system tray, and closing the window keeps the store in it.
    in property <bool> tray-available;
    in property <bool> close-to-tray;
    // The kind of app offered first on Linux: 0 what suits the system, 1 Flatpak,
    // 2 AppImage, 3 the system's own packages. And whether that means anything here.
    in property <int> prefer-kind;
    in property <bool> prefer-applies;
    // Lists of apps on the person's own servers: `id` is the list's address.
    in property <[SourceChoice]> own-sources;
    in property <bool> family-mode;
    in property <bool> adult-on-home;
    // Adult things shown as they are: no cover, no question.
    in property <bool> adult-uncovered;
    in property <bool> has-pin;
    in property <bool> pin-for-installs;
    // A question standing between the person and what they asked for: 0 none,
    // 1 "are you 18 or over?", 2 enter the PIN, 3 choose a PIN, 4 enter it again.
    in property <int> gate;
    in property <string> gate-title;
    in property <string> gate-text;
    in property <string> gate-error;
    // The two answers to a yes-or-no question.
    in property <string> gate-no: "No";
    in property <string> gate-yes: "Yes, I am 18 or over";
    // The store is running from a file it can add to the app menu, and whether it has.
    in property <bool> can-register;
    in property <bool> in-menu;
    // A controller is attached but nothing says this is a TV: ask, once.
    in property <bool> ask-tv;

    // --- feedback ---------------------------------------------------------------
    in property <string> toast;
    in property <bool> toast-is-error;

    callback search(string);
    // Out of a search and back to Home: the box emptied, the results put away.
    callback leave-search();
    // The languages Bilby comes in, "System" first; `on` marks the one chosen.
    in property <[SourceChoice]> languages;
    in property <string> language-name;
    // By code ("fr"); empty for the system's own.
    callback set-language(string);
    // The one after the current one, for a remote.
    callback next-language();
    // The countries whose prices the stores can be asked for, "System" first; `on`
    // marks the one chosen.
    in property <[SourceChoice]> countries;
    in property <string> country-name;
    // By code ("CA"); empty for the system's own.
    callback set-country(string);
    // The one after the current one (or, with `false`, before it), for a remote.
    callback step-country(bool);
    // The TV's on-screen keyboard: its keys as they now show, and which is highlighted.
    in property <[OskKey]> osk-keys;
    in property <int> osk-at;
    // Show it afresh: small letters, the highlight on the first.
    callback osk-open();
    // 0 up, 1 down, 2 left, 3 right.
    callback osk-move(int);
    // OK on the highlighted key, or a tap on any key: true when it was "search".
    callback osk-press() -> bool;
    callback osk-tap(int) -> bool;
    // From a real keyboard while it is up.
    callback osk-type(string);
    callback osk-erase();
    // The system's password is wanted (TV): asked for on screen, with the keyboard.
    in property <bool> password-ask;
    // The one just given was not right.
    in property <bool> password-wrong;
    // How many characters have been typed; the password itself never comes here.
    in property <int> password-length;
    callback password-submit();
    callback password-cancel();
    callback open(string);
    // Fetch everything in the category of this name ("" for none in particular).
    callback browse-category(string);
    callback close-details();
    callback retry-details();
    callback select-version(int);
    callback install(int);
    callback cancel-install();
    callback check-updates();
    callback update-app(string);
    callback update-all();
    callback remove-from-library(string);
    callback skip-update(string);
    callback toggle-favourite();
    callback launch();
    // From a list: open the app's page and start installing what suits this device.
    callback quick-install(string);
    // Save a file that was hidden because it does not suit this device.
    callback download-hidden(int);
    callback set-theme(int);
    callback set-prereleases(bool);
    callback set-ratings(bool);
    callback set-check-on-start(bool);
    callback open-downloads();
    callback save-token(string);
    callback github-signin();
    callback github-cancel();
    callback steam-signin();
    callback steam-signin-qr();
    callback steam-cancel();
    callback steam-signout();
    callback gog-signin();
    callback gog-cancel();
    callback gog-signout();
    callback toggle-review-place(string);
    // Stars, title, text, and the name to show.
    callback send-review(int, string, string, string);
    callback clear-cache();
    callback clear-recent();
    callback open-url(string);
    callback dismiss-toast();
    callback dismiss-welcome();
    callback view-store-update();
    // Look for a newer version of the store itself, and say what was found.
    callback check-store-update();
    callback set-interface(int);
    callback set-source(string, bool);
    // Choose the downloads folder with the system's dialog, or set it by its path
    // ("" goes back to the usual one).
    callback choose-downloads();
    callback set-downloads(string);
    callback set-ask-where(bool);
    // Add a list of apps by its address, or take one away.
    callback add-own-source(string);
    callback remove-own-source(string);
    // Make a sound: 0 the highlight moved, 1 a press, 2 stepping back, 3 a switch.
    callback play(int);
    callback set-sounds(bool);
    callback set-essentials(bool);
    callback set-show-everything(bool);
    callback set-auto-update(bool);
    callback set-close-to-tray(bool);
    callback set-prefer-kind(int);
    callback set-family-mode(bool);
    callback set-adult-on-home(bool);
    callback set-adult-uncovered(bool);
    callback set-pin-for-installs(bool);
    // Set a PIN, or change the one there is.
    callback set-pin();
    callback remove-pin();
    // The answer to "are you 18 or over?", four digits entered, or stepping back.
    callback gate-answer(bool);
    callback gate-pin(string);
    callback gate-cancel();
    callback filter-results(string);
    callback set-reduce-motion(bool);
    callback set-in-menu(bool);
    callback answer-tv(bool);
    callback system-check();
    // Updates are in place and wait for a restart: ask, then restart the device.
    callback system-restart-now();
    callback system-update();
    callback system-handoff-open();
}
