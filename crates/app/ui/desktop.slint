// Desktop: sidebar navigation, a search field that is always visible, and a card grid
// that reflows with the window. Built for a pointer and a keyboard:
// Ctrl+K or Ctrl+F jumps to search, Escape goes back, Tab walks through everything.
import { Theme } from "theme.slint";
import { AppCard, Section, Store } from "types.slint";
import { AppIcon, AppTile, Button, Busy, Chip, ChoiceChip, EmptyState, SearchField, DetailsBody, LibraryBody, SettingsBody, SystemBody, Appear, FadeIn, SourceFilter, Toast, TvQuestion, UpdatesBanner, Welcome } from "components.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <int> badge;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: active ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: Theme.quick; }
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: active;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image { source: icon; colorize: active ? Theme.accent : Theme.text-dim; width: 18px; height: 18px; }
        }
        Text {
            horizontal-stretch: 1;
            text: label;
            color: active ? Theme.text : Theme.text-dim;
            font-size: 14px;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
        }
        if badge > 0 : VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(20px, count.preferred-width + 12px);
                height: 20px;
                border-radius: 10px;
                background: Theme.accent;
                count := Text { text: badge; color: Theme.on-accent; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

component CardGrid inherits Rectangle {
    in property <[AppCard]> apps;
    property <length> gap: 14px;
    property <int> cols: max(1, floor((self.width + gap) / (264px + gap)));
    property <length> tile-w: (self.width - (cols - 1) * gap) / cols;
    property <length> tile-h: 176px;
    // How many lines of tiles to show at most; 0 for all of them. A page of many
    // sections shows the start of each, and the section's own page the whole of it.
    in property <int> max-rows: 0;
    // A section only a line longer than that is shown whole: hiding two tiles behind
    // a button saves nothing.
    out property <int> shown: max-rows > 0 && apps.length > cols * (max-rows + 1) ? cols * max-rows : apps.length;
    property <int> rows: ceil(shown / cols);
    height: max(0px, rows * (tile-h + gap) - gap);
    for i in shown : AppTile {
        x: mod(i, cols) * (tile-w + gap);
        y: floor(i / cols) * (tile-h + gap);
        width: tile-w;
        height: tile-h;
        app: apps[i];
        clicked => { Store.open(apps[i].id); }
    }
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 20px;
    font-weight: 700;
    accessible-role: text;
}

// The first featured app, given room to breathe.
component Spotlight inherits Rectangle {
    in property <AppCard> app;
    height: 148px;
    border-radius: 18px;
    background: @linear-gradient(100deg, app.tint.darker(45%) 0%, app.tint.darker(10%) 100%);
    // The whole banner opens the app, not just the button.
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Store.open(app.id); }
    }
    HorizontalLayout {
        padding: 24px;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 88px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            Text { text: @tr("Featured"); color: white.with-alpha(0.75); font-size: 12px; font-weight: 700; }
            Text { text: app.name; color: white; font-size: 28px; font-weight: 800; overflow: elide; }
            Text { text: app.summary; color: white.with-alpha(0.9); font-size: 14px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 104px;
                height: 42px;
                border-radius: 21px;
                background: view-ta.has-hover ? white : white.with-alpha(0.92);
                border-width: view-fs.has-focus ? 2px : 0px;
                border-color: black;
                accessible-role: button;
                accessible-label: @tr("View {}", app.name);
                accessible-action-default => { Store.open(app.id); }
                view-fs := FocusScope {
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            Store.open(app.id);
                            return accept;
                        }
                        reject
                    }
                    view-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Store.open(app.id); }
                    }
                }
                Text { text: @tr("View"); color: #111318; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

export component DesktopShell inherits Rectangle {
    background: Theme.bg;

    // Keyboard shortcuts must work before anything was clicked.
    init => { keys.focus(); }

    // Opening or leaving an app page hides whatever had the focus; take it back so
    // Escape, Back and the shortcuts keep working.
    property <bool> on-app-page: Store.details-open;
    changed on-app-page => { keys.focus(); }

    // One step back: out of an app's page, or from the device page to where it was opened.
    function back() {
        if (Store.details-open) {
            Store.close-details();
        } else if (Store.page == 4) {
            Store.page = Store.system-from;
        } else if (Store.page == 1) {
            Store.leave-search();
        }
    }
    function go(page: int) {
        if (page == 0) {
            // Home is Home: a search that was open is put away.
            Store.leave-search();
            return;
        }
        Store.close-details();
        Store.page = page;
    }

    keys := FocusScope {
        // Shortcuts work wherever the focus is, including inside the search field.
        capture-key-pressed(event) => {
            if (event.modifiers.control && (event.text == "k" || event.text == "f")) {
                search.grab-focus();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (Store.details-open || Store.page == 4) {
                    root.back();
                    return accept;
                }
                if (search.has-focus && Store.page != 1) {
                    keys.focus();
                    return accept;
                }
                if (Store.page == 1) {
                    keys.focus();
                    root.back();
                    return accept;
                }
            }
            if (event.modifiers.alt && event.text == Key.LeftArrow && (Store.details-open || Store.page == 4 || Store.page == 1)) {
                root.back();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            // "/" starts a search when nothing else wants the key.
            if (event.text == "/") {
                search.grab-focus();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // ---- sidebar ----
            Rectangle {
                width: 228px;
                background: Theme.surface.with-alpha(0.6);
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    HorizontalLayout {
                        padding: 8px;
                        padding-bottom: 18px;
                        spacing: 10px;
                        alignment: start;
                        Image { width: 28px; height: 28px; source: @image-url("icons/logo.svg"); accessible-role: none; }
                        Text { text: "Bilby"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                    }
                    NavItem {
                        label: @tr("Discover");
                        icon: @image-url("icons/discover.svg");
                        active: Store.page == 0 && !Store.details-open;
                        clicked => { root.go(0); }
                    }
                    NavItem {
                        label: @tr("Search");
                        icon: @image-url("icons/search.svg");
                        active: Store.page == 1 && !Store.details-open;
                        clicked => {
                            root.go(1);
                            search.grab-focus();
                        }
                    }
                    NavItem {
                        label: @tr("Library");
                        icon: @image-url("icons/library.svg");
                        badge: Store.updates-count + (Store.system-state == 3 ? 1 : 0);
                        active: (Store.page == 2 || (Store.page == 4 && Store.system-from == 2)) && !Store.details-open;
                        clicked => { root.go(2); }
                    }
                    NavItem {
                        label: @tr("Settings");
                        icon: @image-url("icons/settings.svg");
                        active: (Store.page == 3 || (Store.page == 4 && Store.system-from == 3)) && !Store.details-open;
                        clicked => { root.go(3); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if Store.demo : Rectangle {
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.warn.with-alpha(0.14);
                        Text { text: @tr("Demo catalog"); color: Theme.warn; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 58px;
                        border-radius: 12px;
                        background: dev-ta.has-hover ? Theme.surface-2 : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        accessible-role: button;
                        accessible-label: @tr("{}. Everything shown works here.", Store.device-name);
                        accessible-action-default => { root.go(3); }
                        dev-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.go(3); }
                        }
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            spacing: 3px;
                            Text { text: Store.device-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: @tr("Everything shown works here"); color: Theme.text-dim; font-size: 11px; overflow: elide; }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.stroke; }

            // ---- content ----
            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 18px;
                    padding-bottom: 10px;
                    spacing: 14px;
                    if Store.details-open || Store.page == 4 || Store.page == 1 : Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: back-ta.has-hover ? Theme.surface-2 : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        accessible-role: button;
                        accessible-label: @tr("Back");
                        accessible-action-default => { root.back(); }
                        back-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back(); }
                        }
                        Image { source: @image-url("icons/back.svg"); colorize: Theme.text; width: 18px; height: 18px; }
                    }
                    search := SearchField {
                        horizontal-stretch: 1;
                        max-width: 560px;
                        text <=> Store.query;
                        placeholder: @tr("Search, or paste a project link   (Ctrl+K)");
                        accepted(text) => { Store.search(text); }
                        edited(text) => { Store.typing(text); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    if Store.details-open : FadeIn {
                        DetailsBody { compact: false; }
                    }

                    // The browse pages stay alive while details are open, so coming
                    // back returns to the same scroll position.
                    Appear {
                        shown: !Store.details-open && Store.page == 0;
                        Flickable {
                            VerticalLayout {
                                padding: 32px;
                                padding-top: 14px;
                                spacing: 18px;
                                alignment: start;
                                if Store.show-welcome : Welcome { compact: false; }
                                if Store.ask-tv && !Store.show-welcome : TvQuestion { compact: false; }
                                if Store.updates-count > 0 : UpdatesBanner { }
                                if Store.spotlight.id != "" && Store.category == "" && !Store.show-welcome : Spotlight { app: Store.spotlight; }
                                if Store.categories.length > 1 : Flickable {
                                    height: 32px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        ChoiceChip { text: @tr("All"); selected: Store.category == ""; clicked => { Store.category = ""; Store.browse-category(""); } }
                                        for name in Store.categories : ChoiceChip {
                                            text: name;
                                            selected: Store.category == name;
                                            clicked => { Store.category = name; Store.browse-category(name); }
                                        }
                                    }
                                }
                                // In a layout of their own without spacing: a section that is
                                // filtered out must take no room at all, and the page's spacing
                                // around each of a dozen hidden ones adds up to a hole.
                                VerticalLayout {
                                    spacing: 0px;
                                    for section in Store.sections : VerticalLayout {
                                    if Store.category == "" || Store.category == section.title : VerticalLayout {
                                        spacing: 14px;
                                        padding-bottom: 28px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Heading { text: section.title; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            // The start of each section; the rest is one press away.
                                            // (Hidden rather than left out: whether it is needed depends on
                                            // how many tiles fit, which the layout must not depend on.)
                                            ChoiceChip {
                                                visible: Store.category == "" && section.apps.length > grid.shown;
                                                text: @tr("Show all {}", section.apps.length);
                                                selected: false;
                                                accessible-label: @tr("Show all {0} in {1}", section.apps.length, section.title);
                                                clicked => { Store.category = section.title; Store.browse-category(section.title); }
                                            }
                                        }
                                        grid := CardGrid { apps: section.apps; max-rows: Store.category == "" ? 2 : 0; }
                                    }
                                    }
                                }
                                if Store.sections.length == 0 : EmptyState {
                                    title: @tr("Nothing featured for this device yet");
                                    body: @tr("Search for an app by name, or paste a project link.");
                                    action: @tr("Search");
                                    acted => {
                                        Store.page = 1;
                                        search.grab-focus();
                                    }
                                }
                            }
                        }
                    }

                    Appear {
                        shown: !Store.details-open && Store.page == 1;
                        Flickable {
                            VerticalLayout {
                                padding: 32px;
                                padding-top: 14px;
                                spacing: 14px;
                                alignment: start;
                                Heading {
                                    text: Store.searching ? @tr("Searching…") : Store.searched ? @tr("Results") : @tr("Search");
                                }
                                if Store.searching : Busy { }
                                if Store.search-note != "" && !Store.searching : Text {
                                    text: Store.search-note;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                if Store.result-sources.length > 1 && !Store.searching : SourceFilter { }
                                if Store.search-error != "" && !Store.searching : Rectangle {
                                    height: err.preferred-height + 24px;
                                    border-radius: 12px;
                                    background: Theme.bad.with-alpha(0.1);
                                    err := Text {
                                        x: 14px;
                                        width: parent.width - 28px;
                                        text: Store.search-error;
                                        color: Theme.bad;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                                if !Store.searched && !Store.searching && Store.suggestions.length == 0 : VerticalLayout {
                                    spacing: 14px;
                                    Text {
                                        text: @tr("Type a name and press Enter, or paste a link to a project. Only apps that work on this device are listed.");
                                        color: Theme.text-dim;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                    }
                                }
                                if Store.recent.length > 0 && !Store.searching : Flickable {
                                    height: 32px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: @tr("Recent"); color: Theme.text-dim; font-size: 12px; font-weight: 700; }
                                        }
                                        for q in Store.recent : ChoiceChip {
                                            text: q;
                                            accessible-label: @tr("Search again for {}", q);
                                            clicked => {
                                                Store.query = q;
                                                Store.search(q);
                                            }
                                        }
                                    }
                                }
                                if Store.suggestions.length > 0 && !Store.searching : VerticalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: @tr("Featured apps matching “{}”  ·  press Enter to search GitHub too", Store.query);
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    CardGrid { apps: Store.suggestions; }
                                }
                                CardGrid { apps: Store.results; }
                                if Store.searched && !Store.searching && Store.results.length == 0 && Store.search-error == "" : EmptyState {
                                    title: @tr("No apps for this device");
                                    body: @tr("Try a different name, or check the spelling. Projects without a file for {} are left out.", Store.platform-title);
                                }
                            }
                        }
                    }

                    Appear {
                        shown: !Store.details-open && Store.page == 2;
                        LibraryBody { compact: false; x: 0; width: min(parent.width, 860px); }
                    }
                    Appear {
                        shown: !Store.details-open && Store.page == 3;
                        SettingsBody { compact: false; x: 0; width: min(parent.width, 760px); }
                    }
                    Appear {
                        shown: !Store.details-open && Store.page == 4;
                        SystemBody { compact: false; x: 0; width: min(parent.width, 760px); }
                    }
                }
            }
        }
    }
    Toast { }
}
