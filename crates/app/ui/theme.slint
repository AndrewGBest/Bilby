// Colours and metrics shared by all three interfaces.
export global Theme {
    out property <color> bg: #0e1014;
    out property <color> surface: #161920;
    out property <color> surface-2: #1e222b;
    out property <color> stroke: #282d38;
    out property <color> text: #eceef3;
    out property <color> text-dim: #98a1b3;
    out property <color> accent: #8aa6ff;
    out property <color> on-accent: #0a1022;
    out property <color> ok: #62d6a0;
    out property <color> warn: #f2bd6b;
    out property <color> bad: #f38181;
}
