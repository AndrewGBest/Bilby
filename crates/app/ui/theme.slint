// Colours shared by all three interfaces, in a light and a dark variant.
import { Palette } from "std-widgets.slint";

export global Theme {
    // 0 follow the system, 1 light, 2 dark
    in property <int> mode: 0;
    out property <bool> dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);

    out property <color> bg: dark ? #0e1014 : #f4f5f8;
    out property <color> surface: dark ? #161920 : #ffffff;
    out property <color> surface-2: dark ? #1e222b : #e9ecf2;
    out property <color> stroke: dark ? #282d38 : #d9dde6;
    out property <color> text: dark ? #eceef3 : #151821;
    out property <color> text-dim: dark ? #98a1b3 : #5b6475;
    out property <color> accent: dark ? #8aa6ff : #3857d6;
    out property <color> on-accent: dark ? #0a1022 : #ffffff;
    out property <color> ok: dark ? #62d6a0 : #177a4c;
    out property <color> warn: dark ? #f2bd6b : #96600a;
    out property <color> bad: dark ? #f38181 : #c23232;
    out property <color> focus: dark ? #ffffff : #151821;
}
