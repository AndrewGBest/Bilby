// TV: a ten-foot interface driven entirely by a remote's D-pad (arrow keys), OK (Enter)
// and Back (Escape). One thing has focus at a time and it is always obvious which.
// Every size is a multiple of `u` so the layout looks the same on a 540dp Android TV
// surface and a 1080p or 4K desktop window.
import { Theme } from "theme.slint";
import { AppCard, Section, Store } from "types.slint";
import { AppIcon, Chip } from "components.slint";

component TvTile inherits Rectangle {
    in property <AppCard> app;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    border-radius: 9 * u;
    background: focused ? Theme.surface-2 : Theme.surface;
    border-width: focused ? 2 * u : 0.5 * u;
    border-color: focused ? white : Theme.stroke;
    opacity: focused ? 1 : 0.8;
    animate border-width, opacity, background { duration: 120ms; }
    TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 9 * u;
        spacing: 5 * u;
        HorizontalLayout {
            spacing: 7 * u;
            AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 26 * u; }
            VerticalLayout {
                alignment: center;
                spacing: 1 * u;
                Text { text: app.name; color: Theme.text; font-size: 11 * u; font-weight: 700; overflow: elide; }
                Text { text: app.author; color: Theme.text-dim; font-size: 8 * u; overflow: elide; }
            }
        }
        Text {
            vertical-stretch: 1;
            text: app.summary;
            color: Theme.text-dim;
            font-size: 8.5 * u;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

export component TvShell inherits Rectangle {
    property <length> u: root.height / 540;
    property <[Section]> rows: Store.tv-rows;
    property <int> cur-row: 0;
    property <int> cur-col: 0;
    // Focused option on the details screen.
    property <int> opt: 0;
    property <AppCard> current: rows[cur-row].apps[cur-col];
    property <length> tile-w: 150 * u;
    property <length> tile-h: 84 * u;
    property <length> tile-gap: 9 * u;
    property <length> row-h: 112 * u;
    property <length> margin: 32 * u;

    background: @linear-gradient(180deg, #151a26 0%, #0b0d12 70%);

    init => { scope.focus(); }

    // Rows come and go (search results, the library row). Keep the focus on something
    // that exists instead of pointing past the end.
    changed rows => {
        root.cur-row = max(0, min(root.cur-row, rows.length - 1));
        root.cur-col = max(0, min(root.cur-col, rows[root.cur-row].apps.length - 1));
    }

    scope := FocusScope {
        // While the search box has focus, steal the keys that should leave it.
        capture-key-pressed(event) => {
            if (search.has-focus && (event.text == Key.DownArrow || event.text == Key.Escape || event.text == Key.Back)) {
                scope.focus();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (search.has-focus) {
                return reject;
            }
            if (Store.details-open) {
                if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace || event.text == Key.LeftArrow) {
                    Store.close-details();
                } else if (event.text == Key.UpArrow) {
                    root.opt = max(0, root.opt - 1);
                } else if (event.text == Key.DownArrow) {
                    root.opt = max(0, min(Store.options.length - 1, root.opt + 1));
                } else if (event.text == Key.Return || event.text == " ") {
                    if (Store.details-error != "") {
                        Store.retry-details();
                    } else if (Store.install-state == 1) {
                        Store.cancel-install();
                    } else if (Store.options.length > 0) {
                        Store.install(root.opt);
                    }
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col + 1));
            } else if (event.text == Key.LeftArrow) {
                root.cur-col = max(0, root.cur-col - 1);
            } else if (event.text == Key.DownArrow) {
                if (root.cur-row < rows.length - 1) {
                    root.cur-row += 1;
                    root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col));
                }
            } else if (event.text == Key.UpArrow) {
                if (root.cur-row > 0) {
                    root.cur-row -= 1;
                    root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col));
                } else {
                    search.focus();
                }
            } else if (event.text == Key.Return || event.text == " ") {
                if (current.id != "") {
                    root.opt = 0;
                    Store.open(current.id);
                }
            } else {
                // Back on the home screen: let the system leave the app.
                return reject;
            }
            accept
        }

        // ---- top bar ----
        HorizontalLayout {
            x: margin;
            y: 18 * u;
            width: parent.width - 2 * margin;
            height: 24 * u;
            spacing: 10 * u;
            Rectangle {
                width: 16 * u;
                height: 16 * u;
                y: 4 * u;
                border-radius: 4 * u;
                background: @linear-gradient(135deg, #8aa6ff 0%, #b28cff 100%);
            }
            Text { text: "untitledstore"; color: Theme.text; font-size: 11 * u; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 190 * u;
                border-radius: 12 * u;
                background: Theme.surface;
                border-width: search.has-focus ? 2 * u : 0.5 * u;
                border-color: search.has-focus ? white : Theme.stroke;
                Image {
                    x: 9 * u;
                    source: @image-url("icons/search.svg");
                    colorize: Theme.text-dim;
                    width: 10 * u;
                    height: 10 * u;
                }
                if search.text == "" : Text {
                    x: 25 * u;
                    text: search.has-focus ? "Type, then press OK" : "Search  (press Up)";
                    color: Theme.text-dim;
                    font-size: 9 * u;
                    vertical-alignment: center;
                }
                search := TextInput {
                    x: 25 * u;
                    width: parent.width - 34 * u;
                    height: 100%;
                    text <=> Store.query;
                    color: Theme.text;
                    font-size: 9 * u;
                    single-line: true;
                    vertical-alignment: center;
                    accepted => {
                        Store.search(self.text);
                        root.cur-row = 0;
                        root.cur-col = 0;
                        scope.focus();
                    }
                }
            }
            Text { text: Store.platform-title; color: Theme.ok; font-size: 9 * u; font-weight: 600; vertical-alignment: center; }
        }

        // ---- home: hero for the focused app, rows below ----
        if !Store.details-open : Rectangle {
            VerticalLayout {
                x: margin;
                y: 62 * u;
                width: 420 * u;
                height: 150 * u;
                spacing: 6 * u;
                alignment: start;
                Text { text: current.name; color: Theme.text; font-size: 34 * u; font-weight: 800; overflow: elide; }
                Text {
                    text: current.id == "" ? "" : current.author + "  ·  " + current.source;
                    color: Theme.text-dim;
                    font-size: 10 * u;
                }
                Text { text: current.summary; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                HorizontalLayout {
                    padding-top: 4 * u;
                    spacing: 5 * u;
                    alignment: start;
                    if current.badge != "" : Chip { text: current.badge; tone: Theme.ok; font-size: 8 * u; }
                    if current.version != "" : Chip { text: current.version; font-size: 8 * u; }
                    if current.has-update : Chip { text: "Update available"; tone: Theme.accent; font-size: 8 * u; }
                    if current.installed && !current.has-update : Chip { text: "Installed"; tone: Theme.accent; font-size: 8 * u; }
                    if current.id != "" : Chip { text: "OK  ·  Details"; tone: Theme.accent; font-size: 8 * u; }
                }
                if rows.length == 0 : Text {
                    text: Store.searching ? "Searching…" : "Nothing for this device yet. Press Up to search.";
                    color: Theme.text-dim;
                    font-size: 12 * u;
                }
            }
            if Store.search-note != "" : Text {
                x: margin;
                y: 214 * u;
                width: parent.width - 2 * margin;
                text: Store.search-note;
                color: Theme.text-dim;
                font-size: 8.5 * u;
                overflow: elide;
            }
            Rectangle {
                y: 232 * u;
                height: parent.height - self.y;
                clip: true;
                Rectangle {
                    y: -root.cur-row * row-h;
                    height: rows.length * row-h;
                    animate y { duration: 220ms; easing: ease-out; }
                    for section[r] in rows : Rectangle {
                        property <int> n: section.apps.length;
                        // Keep the focused tile in view: scroll once it passes the third column.
                        property <int> shift: r == root.cur-row ? max(0, root.cur-col - 2) : 0;
                        y: r * row-h;
                        height: row-h;
                        opacity: r < root.cur-row ? 0 : 1;
                        animate opacity { duration: 160ms; }
                        Text {
                            x: margin;
                            y: 0;
                            height: 18 * u;
                            text: section.title;
                            color: r == root.cur-row ? Theme.text : Theme.text-dim;
                            font-size: 10 * u;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            x: margin - shift * (tile-w + tile-gap);
                            y: 22 * u;
                            height: tile-h;
                            width: n * (tile-w + tile-gap);
                            animate x { duration: 200ms; easing: ease-out; }
                            for app[c] in section.apps : TvTile {
                                x: c * (tile-w + tile-gap);
                                width: tile-w;
                                height: tile-h;
                                u: root.u;
                                app: app;
                                focused: r == root.cur-row && c == root.cur-col && !search.has-focus;
                                clicked => {
                                    root.cur-row = r;
                                    root.cur-col = c;
                                    root.opt = 0;
                                    scope.focus();
                                    Store.open(app.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- details: app on the left, installable files on the right ----
        if Store.details-open : Rectangle {
            VerticalLayout {
                x: margin;
                y: 70 * u;
                width: 250 * u;
                spacing: 8 * u;
                alignment: start;
                AppIcon { initials: Store.app.initials; tint: Store.app.tint; icon: Store.app.icon; size: 56 * u; }
                Text { text: Store.app.name; color: Theme.text; font-size: 28 * u; font-weight: 800; wrap: word-wrap; }
                Text { text: Store.app.author + "  ·  " + Store.app.source; color: Theme.text-dim; font-size: 10 * u; }
                Text { text: Store.app.summary; color: Theme.text; font-size: 11 * u; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 5 * u;
                    alignment: start;
                    if Store.app.version != "" : Chip { text: Store.app.version; font-size: 8 * u; }
                    if Store.app.popularity != "" : Chip { text: Store.app.popularity; font-size: 8 * u; }
                    if Store.release-date != "" : Chip { text: Store.release-date; font-size: 8 * u; }
                }
                if Store.warning != "" : Text { text: Store.warning; color: Theme.warn; font-size: 9 * u; wrap: word-wrap; }
                Text { text: "Back  ·  Return to browsing"; color: Theme.text-dim; font-size: 8.5 * u; }
            }
            VerticalLayout {
                x: 320 * u;
                y: 70 * u;
                width: parent.width - self.x - margin;
                spacing: 7 * u;
                alignment: start;
                Text {
                    text: Store.details-loading ? "Checking releases against this device…" : Store.details-error != "" ? Store.details-error + "  Press OK to try again." : Store.unavailable != "" ? Store.unavailable : Store.installed-version != "" && Store.installed-version != Store.app.version ? "Update available: you have " + Store.installed-version : "Works on " + Store.platform-title;
                    color: Store.details-error != "" ? Theme.bad : Store.unavailable != "" ? Theme.warn : Theme.text-dim;
                    font-size: 10 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                for option[i] in Store.options : Rectangle {
                    property <bool> focused: i == root.opt;
                    property <bool> mine: Store.install-index == i && Store.install-state != 0;
                    height: 50 * u;
                    border-radius: 9 * u;
                    background: focused ? Theme.surface-2 : Theme.surface;
                    border-width: focused ? 2 * u : 0.5 * u;
                    border-color: focused ? white : Theme.stroke;
                    animate border-width { duration: 100ms; }
                    TouchArea {
                        clicked => {
                            root.opt = i;
                            Store.install(i);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12 * u;
                        padding-right: 12 * u;
                        spacing: 10 * u;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2 * u;
                            horizontal-stretch: 1;
                            Text { text: option.label; color: Theme.text; font-size: 12 * u; font-weight: 700; overflow: elide; }
                            Text {
                                text: mine ? (Store.install-state == 1 ? "Downloading…  " + round(Store.install-progress * 100) + "%" : Store.install-message) : option.note != "" ? option.note : option.size != "" ? option.file + "  ·  " + option.size : option.file;
                                color: mine && Store.install-state == 3 ? Theme.bad : mine && Store.install-state == 2 ? Theme.ok : option.note != "" && !mine ? Theme.warn : Theme.text-dim;
                                font-size: 8.5 * u;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            if i == 0 : Chip { text: "Best for this TV"; tone: Theme.accent; font-size: 8 * u; }
                        }
                        VerticalLayout {
                            alignment: center;
                            if focused : Chip { text: mine && Store.install-state == 1 ? "OK  ·  Cancel" : "OK  ·  " + option.verb; tone: Theme.ok; font-size: 8 * u; }
                        }
                    }
                }
                if Store.hidden.length > 0 && !Store.details-loading : Text {
                    text: Store.hidden.length + (Store.hidden.length == 1 ? " other file was" : " other files were") + " hidden because they don't work on this device.";
                    color: Theme.text-dim;
                    font-size: 8.5 * u;
                }
            }
        }
    }
    if Store.toast != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 44 * u;
        width: toast-label.preferred-width + 28 * u;
        height: 24 * u;
        border-radius: 12 * u;
        background: #eceef3;
        toast-label := Text {
            text: Store.toast;
            color: Store.toast-is-error ? #b3261e : #0e1014;
            font-size: 10 * u;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
