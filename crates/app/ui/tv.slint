                    height: parent.height - self.y;
                    clip: true;
                    property <length> further: max(0, words.preferred-height - self.height);
                    changed further => { root.about-max = self.further; }
                    init => { root.about-max = self.further; }
                    words := VerticalLayout {
                        x: 0;
                        y: -min(root.about-scroll, parent.further);
                        width: min(parent.width - 20 * u, 760 * u);
