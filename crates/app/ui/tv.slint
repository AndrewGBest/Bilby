// TV: a ten-foot interface driven entirely by a remote's D-pad (arrow keys), OK (Enter)
// and Back (Escape). One thing has focus at a time and it is always obvious which.
// Every size is a multiple of `u` so the layout looks the same on a 540dp Android TV
// surface and a 1080p or 4K desktop window.
import { Theme } from "theme.slint";
import { AppCard, Section, Store } from "types.slint";
import { AppIcon, FadeIn, ProgressBar } from "components.slint";

// Sizes follow Android TV's guidance: content stays inside a 48dp side and 27dp
// top/bottom margin, body text is 12dp or larger, and the focused item grows a little
// as well as gaining a border, so it is obvious from across a room.
component TvTile inherits Rectangle {
    in property <AppCard> app;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    Rectangle {
        // The focused tile is drawn slightly larger, about 1.05x.
        x: focused ? -5 * u : 0;
        y: focused ? -3 * u : 0;
        width: parent.width + (focused ? 10 * u : 0);
        height: parent.height + (focused ? 6 * u : 0);
        border-radius: 10 * u;
        background: focused ? Theme.surface-2 : Theme.surface;
        border-width: focused ? 2 * u : 0.5 * u;
        border-color: focused ? white : Theme.stroke;
        opacity: focused ? 1 : 0.82;
        animate x, y, width, height, border-width, opacity, background { duration: 130ms; easing: ease-out; }
        TouchArea {
            clicked => { root.clicked(); }
        }
        VerticalLayout {
            padding: 11 * u;
            spacing: 6 * u;
            HorizontalLayout {
                spacing: 9 * u;
                AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 32 * u; }
                VerticalLayout {
                    alignment: center;
                    spacing: 1 * u;
                    Text { text: app.name; color: Theme.text; font-size: 14 * u; font-weight: 700; overflow: elide; }
                    Text {
                        text: app.has-update ? "Update available" : app.installed ? "Installed" : app.rating != "" ? "★ " + app.rating + "  ·  " + app.rating-count : app.headline != "" ? app.headline : app.author;
                        color: app.has-update || app.installed ? Theme.accent : Theme.text-dim;
                        font-size: 11 * u;
                        font-weight: app.has-update || app.installed ? 700 : 400;
                        overflow: elide;
                    }
                }
            }
            Text {
                vertical-stretch: 1;
                text: app.summary;
                color: Theme.text-dim;
                font-size: 11.5 * u;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

// An entry of the top bar: where you are is underlined, where the remote points is boxed.
component TvTab inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    in property <bool> focused;
    in property <bool> attention;
    in property <length> u;
    width: label.preferred-width + 22 * u;
    border-radius: 14 * u;
    background: focused ? Theme.surface-2 : transparent;
    border-width: focused ? 2 * u : 0;
    border-color: white;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.current;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.attention ? Theme.warn : root.current || root.focused ? Theme.text : Theme.text-dim;
        font-size: 12 * u;
        font-weight: root.current ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.current && !root.focused : Rectangle {
        x: 11 * u;
        y: parent.height - 2 * u;
        width: parent.width - 22 * u;
        height: 2 * u;
        border-radius: 1 * u;
        background: Theme.accent;
    }
}

// A setting that is on or off. OK switches it.
component TvSetting inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    // What to show on the right instead of On or Off.
    in property <string> value;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    height: 26 * u;
    border-radius: 8 * u;
    background: focused ? Theme.surface-2 : transparent;
    border-width: focused ? 2 * u : 0;
    border-color: white;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10 * u;
        padding-right: 10 * u;
        spacing: 12 * u;
        Text { horizontal-stretch: 1; text: root.label; color: Theme.text; font-size: 12 * u; vertical-alignment: center; overflow: elide; }
        Text { text: root.value != "" ? root.value : root.on ? "On" : "Off"; color: root.value != "" ? Theme.accent : root.on ? Theme.ok : Theme.text-dim; font-size: 12 * u; font-weight: 700; vertical-alignment: center; }
    }
}

// A button on the TV app page. The remote moves between them; OK presses the focused one.
component TvButton inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <bool> primary;
    in property <length> u;
    // 0 to 1 while this button's action is under way.
    in property <float> progress: -1;
    callback clicked;
    height: 34 * u;
    width: label.preferred-width + 28 * u;
    Rectangle {
        x: focused ? -3 * u : 0;
        y: focused ? -2 * u : 0;
        width: parent.width + (focused ? 6 * u : 0);
        height: parent.height + (focused ? 4 * u : 0);
        border-radius: 17 * u;
        background: primary ? Theme.accent : Theme.surface-2;
        border-width: focused ? 2 * u : 0;
        border-color: white;
        opacity: focused ? 1 : 0.75;
        animate x, y, width, height, border-width, opacity { duration: Theme.quick; easing: ease-out; }
        clip: root.progress >= 0;
        if root.progress >= 0 : Rectangle {
            x: 0;
            width: parent.width * clamp(root.progress, 0.03, 1.0);
            height: parent.height;
            background: #ffffff66;
            animate width { duration: Theme.smooth; easing: ease-out; }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: primary ? #0e1014 : Theme.text;
            font-size: 13 * u;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component TvStat inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    in property <length> u;
    spacing: 1 * u;
    Text { text: root.value; color: Theme.text; font-size: 14 * u; font-weight: 700; }
    Text { text: root.caption; color: Theme.text-dim; font-size: 11 * u; }
}

export component TvShell inherits Rectangle {
    property <length> u: root.height / 540;
    property <bool> on-library: Store.page == 2 && !Store.details-open;
    property <[Section]> rows: Store.page == 2 ? Store.tv-library-rows : Store.tv-rows;
    property <int> cur-row: 0;
    property <int> cur-col: 0;
    // Focused option on the details screen.
    property <int> opt: 0;
    property <AppCard> current: rows[cur-row].apps[cur-col];
    // Four tiles fill a row inside the safe area (Android TV's four-card width).
    property <length> tile-w: 201 * u;
    property <length> tile-h: 104 * u;
    property <length> tile-gap: 20 * u;
    property <length> row-h: 146 * u;
    // Android TV's overscan-safe margins.
    property <length> margin: 48 * u;
    property <length> top: 27 * u;

    // The app page: which button has focus (0 main, 1 favourite, 2 other files), and
    // whether the list of every file is open.
    property <int> act: 0;
    property <bool> files: false;
    // Where the remote's focus is: 0 the grid of apps, 1 the top bar, 2 the library's
    // own buttons. `tab` is the focused entry of the top bar: Home, Library, Search,
    // This TV.
    property <int> zone: 0;
    property <int> tab: 0;
    property <int> lib-act: 0;
    property <bool> lib-has-actions: root.on-library && Store.library.length > 0;
    property <bool> lib-can-update-all: Store.updates-count > 1 && Store.updating-id == "";
    property <int> sys-act: 0;
    // On the device page: 0 is the row of buttons, 1 to 3 the settings below them.
    property <int> sys-row: 0;
    function enter-bar() {
        // From Home, Up lands on Search: it is what people go up there for.
        root.tab = Store.page == 2 ? 1 : Store.page == 4 ? 3 : 2;
        root.zone = 1;
    }
    // Go where the focused entry of the top bar leads.
    function activate-tab() {
        root.cur-row = 0;
        root.cur-col = 0;
        if (root.tab == 0) {
            Store.page = 0;
            root.zone = 0;
        } else if (root.tab == 1) {
            Store.page = 2;
            root.lib-act = 0;
            root.zone = Store.library.length > 0 ? 2 : Store.tv-library-rows.length > 0 ? 0 : 1;
        } else if (root.tab == 2) {
            Store.page = 0;
            root.zone = 0;
            search.focus();
        } else {
            Store.page = 4;
            root.sys-row = 0;
            root.sys-act = 0;
            root.zone = 0;
        }
    }
    property <bool> on-system: Store.page == 4 && !Store.details-open;
    property <bool> sys-can-update: Store.system-state == 3;
    // Buttons on that page: Update (when there is one), Check again (where updates are
    // handled), and always last, the way out of the TV layout.
    property <bool> sys-working: Store.system-state == 1 || Store.system-state == 4;
    property <int> sys-last: !Store.system-supported || sys-working ? 0 : sys-can-update ? 2 : 1;
    changed sys-last => { root.sys-act = min(root.sys-act, root.sys-last); }
    property <bool> busy: Store.install-state == 1;
    property <bool> is-update: Store.installed-version != "" && Store.installed-version != "installed" && Store.app.version != "" && Store.installed-version != Store.app.version;
    property <bool> open-instead: Store.can-open && !is-update && !busy;
    property <string> main-action: busy ? "Cancel" : open-instead ? "Open" : is-update ? "Update" : Store.options.length == 0 ? "" : Store.installed-version != "" && !Store.is-website ? "Install again" : Store.options[0].verb;
    // The buttons on an app's page, left to right: the main one, Favourite, Other files
    // (when there are any) and Remove (when the app is in the library).
    property <bool> has-files: Store.options.length > 0 && !Store.is-website;
    property <bool> has-reviews: Store.reviews.length > 0;
    property <int> reviews-idx: !has-reviews ? -1 : has-files ? 3 : 2;
    property <int> remove-idx: !Store.in-library ? -1 : 2 + (has-files ? 1 : 0) + (has-reviews ? 1 : 0);
    property <int> last-act: 1 + (has-files ? 1 : 0) + (has-reviews ? 1 : 0) + (Store.in-library ? 1 : 0);
    // Reading what people wrote: one review at a time, large enough for the sofa.
    property <bool> reading: false;
    property <int> rev: 0;
    changed has-reviews => {
        if (!root.has-reviews) {
            root.reading = false;
        }
    }
    // Remove asks twice: the first OK only arms it.
    property <bool> remove-armed: false;
    changed act => { root.remove-armed = false; }
    changed last-act => { root.act = min(root.act, root.last-act); }
    property <string> shown-id: Store.app.id;
    changed shown-id => {
        root.remove-armed = false;
        root.reading = false;
        root.rev = 0;
        root.act = 0;
        root.files = false;
        root.opt = 0;
    }
    function press-main() {
        if (Store.details-error != "") {
            Store.retry-details();
        } else if (root.busy) {
            Store.cancel-install();
        } else if (root.open-instead) {
            Store.launch();
        } else if (Store.options.length > 0) {
            Store.install(0);
        }
    }

    background: @linear-gradient(180deg, #151a26 0%, #0b0d12 70%);

    init => { scope.focus(); }

    // Rows come and go (search results, the library row). Keep the focus on something
    // that exists instead of pointing past the end.
    changed rows => {
        root.cur-row = max(0, min(root.cur-row, rows.length - 1));
        root.cur-col = max(0, min(root.cur-col, rows[root.cur-row].apps.length - 1));
    }

    scope := FocusScope {
        // While the search box has focus, steal the keys that should leave it.
        capture-key-pressed(event) => {
            if (search.has-focus && (event.text == Key.DownArrow || event.text == Key.Escape || event.text == Key.Back)) {
                root.zone = 0;
                scope.focus();
                return accept;
            }
            // Up, or sideways from an empty box, goes back to the top bar.
            if (search.has-focus && (event.text == Key.UpArrow || (search.text == "" && (event.text == Key.RightArrow || event.text == Key.LeftArrow)))) {
                root.tab = 2;
                root.zone = 1;
                scope.focus();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (search.has-focus) {
                return reject;
            }
            if (root.zone == 1 && !Store.details-open) {
                if (event.text == Key.LeftArrow) {
                    root.tab = max(0, root.tab - 1);
                } else if (event.text == Key.RightArrow) {
                    root.tab = min(3, root.tab + 1);
                } else if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                    root.activate-tab();
                } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    // Back from anywhere but Home goes Home; on Home there is nowhere
                    // further back, so the system may have the key.
                    if (Store.page == 0) {
                        return reject;
                    }
                    root.tab = 0;
                    root.activate-tab();
                }
                return accept;
            }
            if (root.on-system) {
                if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    root.tab = 0;
                    root.activate-tab();
                } else if (event.text == Key.UpArrow) {
                    if (root.sys-row == 0) {
                        root.enter-bar();
                    } else {
                        root.sys-row -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.sys-row = min(4, root.sys-row + 1);
                } else if (root.sys-row > 0) {
                    // A setting: OK, Left or Right switches it.
                    if (event.text == Key.Return || event.text == " " || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                        if (root.sys-row == 1) {
                            Store.set-ratings(!Store.show-ratings);
                        } else if (root.sys-row == 2) {
                            Store.set-check-on-start(!Store.check-updates-on-start);
                        } else if (root.sys-row == 3) {
                            Store.set-prereleases(!Store.include-prereleases);
                        } else if (Store.has-token) {
                            Store.save-token("");
                        } else if (Store.signin-state == 0) {
                            Store.github-signin();
                        } else {
                            Store.github-cancel();
                        }
                    }
                } else if (event.text == Key.RightArrow) {
                    root.sys-act = min(root.sys-last, root.sys-act + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.sys-act = max(0, root.sys-act - 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.sys-act == root.sys-last) {
                        Store.set-interface(1);
                    } else if (root.sys-can-update && root.sys-act == 0) {
                        Store.system-update();
                    } else {
                        Store.system-check();
                    }
                }
                return accept;
            }
            if (Store.details-open) {
                if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    // Back closes the list of files or the reviews first, then the page.
                    if (root.files) {
                        root.files = false;
                    } else if (root.reading) {
                        root.reading = false;
                    } else {
                        Store.close-details();
                    }
                } else if (root.files) {
                    if (event.text == Key.UpArrow) {
                        if (root.opt == 0) {
                            root.files = false;
                        } else {
                            root.opt -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.opt = max(0, min(Store.options.length - 1, root.opt + 1));
                    } else if (event.text == Key.RightArrow && !root.busy) {
                        // Right is an older version, Left a newer one.
                        if (Store.selected-version < Store.versions.length - 1) {
                            root.opt = 0;
                            Store.select-version(Store.selected-version + 1);
                        }
                    } else if (event.text == Key.LeftArrow && !root.busy) {
                        if (Store.selected-version > 0) {
                            root.opt = 0;
                            Store.select-version(Store.selected-version - 1);
                        }
                    } else if (event.text == Key.Return || event.text == " ") {
                        if (root.busy) {
                            Store.cancel-install();
                        } else if (Store.options.length > 0) {
                            Store.install(root.opt);
                        }
                    }
                } else if (root.reading) {
                    if (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                        root.rev = min(Store.reviews.length - 1, root.rev + 1);
                    } else if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                        if (root.rev == 0) {
                            root.reading = false;
                        } else {
                            root.rev -= 1;
                        }
                    } else if (event.text == Key.Return || event.text == " ") {
                        root.reading = false;
                    }
                } else if (event.text == Key.LeftArrow) {
                    if (root.act == 0) {
                        Store.close-details();
                    } else {
                        root.act -= 1;
                    }
                } else if (event.text == Key.RightArrow) {
                    root.act = min(root.last-act, root.act + 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.act == 0) {
                        root.press-main();
                    } else if (root.act == 1) {
                        Store.toggle-favourite();
                    } else if (root.act == root.remove-idx) {
                        if (root.remove-armed) {
                            root.remove-armed = false;
                            Store.remove-from-library(Store.app.id);
                        } else {
                            root.remove-armed = true;
                        }
                    } else if (root.act == root.reviews-idx) {
                        root.rev = 0;
                        root.reading = true;
                    } else {
                        root.opt = 0;
                        root.files = true;
                    }
                }
                return accept;
            }
            if (root.zone == 2) {
                // The library's own buttons.
                if (event.text == Key.LeftArrow) {
                    root.lib-act = max(0, root.lib-act - 1);
                } else if (event.text == Key.RightArrow) {
                    root.lib-act = min(root.lib-can-update-all ? 1 : 0, root.lib-act + 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.lib-can-update-all && root.lib-act == 0) {
                        Store.update-all();
                    } else {
                        Store.check-updates();
                    }
                } else if (event.text == Key.DownArrow) {
                    if (rows.length > 0) {
                        root.zone = 0;
                    }
                } else {
                    root.enter-bar();
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col + 1));
            } else if (event.text == Key.LeftArrow) {
                root.cur-col = max(0, root.cur-col - 1);
            } else if (event.text == Key.DownArrow) {
                if (root.cur-row < rows.length - 1) {
                    root.cur-row += 1;
                    root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col));
                }
            } else if (event.text == Key.UpArrow) {
                if (root.cur-row > 0) {
                    root.cur-row -= 1;
                    root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col));
                } else if (root.lib-has-actions) {
                    root.zone = 2;
                } else {
                    root.enter-bar();
                }
            } else if (event.text == Key.Return || event.text == " ") {
                if (current.id != "") {
                    Store.open(current.id);
                }
            } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                // Back from the apps goes up to the top bar, as on other TV stores.
                root.enter-bar();
            } else {
                return reject;
            }
            accept
        }

        // ---- top bar ----
        HorizontalLayout {
            x: margin;
            y: top;
            width: parent.width - 2 * margin;
            height: 28 * u;
            spacing: 10 * u;
            Image { width: 20 * u; height: 20 * u; y: 4 * u; source: @image-url("icons/logo.svg"); accessible-role: none; }
            Text { text: "Bilby"; color: Theme.text; font-size: 14 * u; font-weight: 700; vertical-alignment: center; }
            Rectangle { width: 14 * u; }
            TvTab {
                u: root.u;
                text: "Home";
                current: Store.page == 0 && !Store.details-open;
                focused: root.zone == 1 && root.tab == 0 && !Store.details-open && !search.has-focus;
            }
            TvTab {
                u: root.u;
                text: Store.updates-count > 0 ? "Library  ·  " + Store.updates-count + (Store.updates-count == 1 ? " update" : " updates") : "Library";
                current: root.on-library;
                focused: root.zone == 1 && root.tab == 1 && !Store.details-open && !search.has-focus;
                attention: Store.updates-count > 0;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                property <bool> pointed: root.zone == 1 && root.tab == 2 && !Store.details-open;
                width: 230 * u;
                border-radius: 14 * u;
                background: Theme.surface;
                border-width: search.has-focus || self.pointed ? 2 * u : 0.5 * u;
                border-color: search.has-focus || self.pointed ? white : Theme.stroke;
                Image {
                    x: 11 * u;
                    source: @image-url("icons/search.svg");
                    colorize: Theme.text-dim;
                    width: 12 * u;
                    height: 12 * u;
                }
                if search.text == "" : Text {
                    x: 30 * u;
                    text: search.has-focus ? "Type, then press OK" : "Search";
                    color: Theme.text-dim;
                    font-size: 12 * u;
                    vertical-alignment: center;
                }
                search := TextInput {
                    x: 30 * u;
                    width: parent.width - 40 * u;
                    height: 100%;
                    text <=> Store.query;
                    color: Theme.text;
                    font-size: 12 * u;
                    single-line: true;
                    vertical-alignment: center;
                    accepted => {
                        Store.search(self.text);
                        root.cur-row = 0;
                        root.cur-col = 0;
                        root.zone = 0;
                        scope.focus();
                    }
                }
            }
            // The device, its updates, and the way back to the desktop layout.
            TvTab {
                u: root.u;
                text: Store.device-name + (Store.system-state == 3 ? "  ·  " + Store.system-headline : "");
                current: root.on-system;
                focused: root.zone == 1 && root.tab == 3 && !Store.details-open && !search.has-focus;
                attention: Store.system-state == 3;
            }
        }

        // ---- this TV: what it runs and whether it is up to date ----
        if root.on-system : FadeIn {
            VerticalLayout {
                x: margin;
                y: 70 * u;
                width: 400 * u;
                spacing: 12 * u;
                alignment: start;
                Text { text: Store.system-name; color: Theme.text; font-size: 30 * u; font-weight: 800; wrap: word-wrap; }
                Text { text: Store.system-tagline; color: Theme.text-dim; font-size: 12 * u; overflow: elide; }
                if Store.system-supported : Text {
                    text: Store.system-headline;
                    color: Store.system-state == 2 && !Store.system-restart ? Theme.ok : Store.system-state == 5 ? Theme.bad : Store.system-state == 3 || Store.system-restart ? Theme.warn : Theme.text;
                    font-size: 20 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if Store.system-detail != "" : Text { text: Store.system-detail; color: Theme.text-dim; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-restart : Text { text: "Restart this TV to finish updating."; color: Theme.warn; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-note != "" : Text { text: Store.system-note; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-state == 4 : Text {
                    text: "You may be asked for your password. Keep the TV on until this finishes.";
                    color: Theme.text-dim;
                    font-size: 12 * u;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12 * u;
                    alignment: start;
                    padding-top: 6 * u;
                    if root.sys-can-update && !root.sys-working : TvButton {
                        u: root.u;
                        text: "Update now";
                        primary: true;
                        focused: root.zone == 0 && root.sys-row == 0 && root.sys-act == 0;
                        clicked => { Store.system-update(); }
                    }
                    if Store.system-supported && !root.sys-working : TvButton {
                        u: root.u;
                        text: "Check again";
                        primary: !root.sys-can-update;
                        focused: root.zone == 0 && root.sys-row == 0 && root.sys-act == (root.sys-can-update ? 1 : 0);
                        clicked => { Store.system-check(); }
                    }
                    TvButton {
                        u: root.u;
                        text: "Desktop layout";
                        primary: false;
                        focused: root.zone == 0 && root.sys-row == 0 && root.sys-act == root.sys-last;
                        clicked => { Store.set-interface(1); }
                    }
                }
                if Store.system-updates.length > 0 : VerticalLayout {
                    spacing: 3 * u;
                    padding-top: 8 * u;
                    Text { text: "Waiting to be installed"; color: Theme.text; font-size: 13 * u; font-weight: 700; }
                    for update[i] in Store.system-updates : Text {
                        visible: i < 6;
                        height: i < 6 ? self.preferred-height : 0;
                        text: update.name + "   " + update.change;
                        color: Theme.text-dim;
                        font-size: 12 * u;
                        overflow: elide;
                    }
                    if Store.system-updates.length > 6 : Text { text: "and " + (Store.system-updates.length - 6) + " more"; color: Theme.text-dim; font-size: 12 * u; }
                }
            }
            VerticalLayout {
                x: margin + 432 * u;
                y: 70 * u;
                width: parent.width - 2 * margin - 432 * u;
                spacing: 7 * u;
                alignment: start;
                Text { text: "Information"; color: Theme.text; font-size: 14 * u; font-weight: 700; }
                for fact in Store.system-facts : HorizontalLayout {
                    spacing: 12 * u;
                    accessible-role: text;
                    accessible-label: fact.name + ": " + fact.value;
                    Text { width: 130 * u; text: fact.name; color: Theme.text-dim; font-size: 12 * u; }
                    Text { horizontal-stretch: 1; text: fact.value; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                }
                Rectangle { height: 6 * u; }
                Text { text: "Settings"; color: Theme.text; font-size: 14 * u; font-weight: 700; }
                TvSetting {
                    u: root.u;
                    label: "Ratings and reviews";
                    on: Store.show-ratings;
                    focused: root.zone == 0 && root.sys-row == 1;
                    clicked => { Store.set-ratings(!Store.show-ratings); }
                }
                TvSetting {
                    u: root.u;
                    label: "Check for updates when Bilby opens";
                    on: Store.check-updates-on-start;
                    focused: root.zone == 0 && root.sys-row == 2;
                    clicked => { Store.set-check-on-start(!Store.check-updates-on-start); }
                }
                TvSetting {
                    u: root.u;
                    label: "Offer test versions of apps";
                    on: Store.include-prereleases;
                    focused: root.zone == 0 && root.sys-row == 3;
                    clicked => { Store.set-prereleases(!Store.include-prereleases); }
                }
                TvSetting {
                    u: root.u;
                    label: Store.has-token ? "Signed in to GitHub" : Store.signin-state != 0 ? "Signing in to GitHub…" : "Sign in to GitHub for more searches an hour";
                    value: Store.has-token ? "Sign out" : Store.signin-state != 0 ? "Cancel" : "Sign in";
                    on: Store.has-token;
                    focused: root.zone == 0 && root.sys-row == 4;
                }
                // The code to enter at GitHub, on a phone or computer.
                if Store.signin-state == 2 : VerticalLayout {
                    padding-top: 6 * u;
                    spacing: 4 * u;
                    Text { text: "On your phone or computer, open github.com/login/device and enter:"; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                    Text {
                        text: Store.signin-code;
                        color: Theme.text;
                        font-size: 30 * u;
                        font-weight: 800;
                        letter-spacing: 3 * u;
                        accessible-label: "Sign-in code " + Store.signin-code;
                    }
                }
            }
        }

        // ---- home: the focused app in large type, rows of apps below ----
        if !Store.details-open && !root.on-system : FadeIn {
            VerticalLayout {
                x: margin;
                y: 74 * u;
                width: 520 * u;
                height: 140 * u;
                spacing: 6 * u;
                alignment: start;
                Text { text: current.name; color: Theme.text; font-size: 36 * u; font-weight: 800; overflow: elide; }
                Text { text: current.summary; color: Theme.text; font-size: 14 * u; wrap: word-wrap; }
                Text {
                    text: current.id == "" ? "" : (current.has-update ? "Update available  ·  " : current.installed ? "Installed  ·  " : "") + (current.rating != "" ? "★ " + current.rating + " (" + current.rating-count + ")  ·  " : current.headline != "" ? current.headline + "  ·  " : "") + current.author;
                    color: current.has-update || current.installed ? Theme.accent : Theme.text-dim;
                    font-size: 12 * u;
                }
                if rows.length == 0 : Text {
                    text: Store.searching ? "Searching…" : root.on-library ? "Apps you install with Bilby show up here, and so do your favourites." : "Nothing for this TV yet. Press Up to search.";
                    wrap: word-wrap;
                    color: Theme.text-dim;
                    font-size: 14 * u;
                }
            }
            // The library's own buttons, beside the focused app.
            if root.lib-has-actions : HorizontalLayout {
                x: margin + 548 * u;
                y: 78 * u;
                spacing: 12 * u;
                alignment: start;
                if root.lib-can-update-all : TvButton {
                    u: root.u;
                    text: "Update all";
                    primary: true;
                    focused: root.zone == 2 && root.lib-act == 0;
                    clicked => { Store.update-all(); }
                }
                TvButton {
                    u: root.u;
                    text: Store.checking-updates ? "Checking…" : "Check for updates";
                    primary: !root.lib-can-update-all;
                    focused: root.zone == 2 && root.lib-act == (root.lib-can-update-all ? 1 : 0);
                    clicked => { Store.check-updates(); }
                }
            }
            // A search that failed says why (GitHub's allowance used up, no connection)
            // in place of the note about what was found.
            if (Store.search-note != "" || Store.search-error != "") && !root.on-library : Text {
                x: margin;
                y: 212 * u;
                width: parent.width - 2 * margin;
                text: Store.search-error != "" && !Store.searching ? Store.search-error : Store.search-note;
                color: Store.search-error != "" && !Store.searching ? Theme.warn : Theme.text-dim;
                font-size: 12 * u;
                overflow: elide;
            }
            Rectangle {
                y: 236 * u;
                height: parent.height - self.y;
                clip: true;
                Rectangle {
                    y: 4 * u - root.cur-row * row-h;
                    height: rows.length * row-h;
                    animate y { duration: 220ms; easing: ease-out; }
                    for section[r] in rows : Rectangle {
                        property <int> n: section.apps.length;
                        // Keep the focused tile in view: scroll once it passes the third column.
                        property <int> shift: r == root.cur-row ? max(0, root.cur-col - 2) : 0;
                        y: r * row-h;
                        height: row-h;
                        opacity: r < root.cur-row ? 0 : 1;
                        animate opacity { duration: 160ms; }
                        Text {
                            x: margin;
                            y: 0;
                            height: 20 * u;
                            text: section.title;
                            color: r == root.cur-row ? Theme.text : Theme.text-dim;
                            font-size: 13 * u;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            x: margin - shift * (tile-w + tile-gap);
                            y: 28 * u;
                            height: tile-h;
                            width: n * (tile-w + tile-gap);
                            animate x { duration: 200ms; easing: ease-out; }
                            for app[c] in section.apps : TvTile {
                                x: c * (tile-w + tile-gap);
                                width: tile-w;
                                height: tile-h;
                                u: root.u;
                                app: app;
                                focused: root.zone == 0 && r == root.cur-row && c == root.cur-col && !search.has-focus;
                                clicked => {
                                    root.cur-row = r;
                                    root.cur-col = c;
                                    root.zone = 0;
                                    scope.focus();
                                    Store.open(app.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- app page: what it is and one button on the left, pictures on the right ----
        if Store.details-open : FadeIn {
            VerticalLayout {
                x: margin;
                y: 70 * u;
                width: 400 * u;
                spacing: 9 * u;
                alignment: start;
                HorizontalLayout {
                    spacing: 14 * u;
                    alignment: start;
                    AppIcon { initials: Store.app.initials; tint: Store.app.tint; icon: Store.app.icon; size: 60 * u; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2 * u;
                        Text { text: Store.app.name; color: Theme.text; font-size: 28 * u; font-weight: 800; overflow: elide; }
                        Text { text: Store.app.author + (Store.app.verified ? "  ✓ verified" : ""); color: Theme.text-dim; font-size: 12 * u; overflow: elide; }
                    }
                }
                Text { text: Store.app.summary; color: Theme.text; font-size: 14 * u; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 24 * u;
                    alignment: start;
                    if Store.app.rating != "" : TvStat { u: root.u; value: "★ " + Store.app.rating; caption: Store.app.rating-count; }
                    if Store.app.price != "" : TvStat { u: root.u; value: Store.app.price; caption: "on " + Store.app.source; }
                    if Store.app.downloads != "" : TvStat { u: root.u; value: Store.app.downloads; caption: Store.app.downloads-note; }
                    // The row has room for four: with a rating and downloads, the source's own count waits.
                    if Store.app.popularity != "" && !(Store.app.rating != "" && Store.app.downloads != "") : TvStat { u: root.u; value: Store.app.popularity; caption: "on " + Store.app.source; }
                    if Store.options.length > 0 && Store.options[0].size != "" : TvStat { u: root.u; value: Store.options[0].size; caption: "download"; }
                    if Store.release-age != "" : TvStat { u: root.u; value: Store.release-age; caption: "last updated"; }
                }
                Text {
                    text: root.remove-armed ? "Press OK again to remove " + Store.app.name + " from this TV" : Store.details-loading ? "Checking what works on this TV…" : Store.details-error != "" ? Store.details-error + "  Press OK to try again." : Store.unavailable != "" ? Store.unavailable : Store.install-state == 1 ? "Downloading…  " + round(Store.install-progress * 100) + "%" : Store.install-state >= 2 ? Store.install-message : root.is-update ? "Update available: you have " + Store.installed-version : Store.installed-version == "installed" ? "Installed" : Store.installed-version != "" ? "Installed  ·  " + Store.installed-version : Store.is-website ? "Opens in Longboard, driven with your remote" : Store.options.length > 0 ? (Store.options[0].native ? "Made for this TV" : "Works on this TV") + (Store.options[0].verified ? "  ·  the download is checked" : "") : "";
                    color: Store.details-error != "" || Store.install-state == 3 ? Theme.bad : Store.unavailable != "" || root.remove-armed ? Theme.warn : Store.install-state == 1 ? Theme.accent : Theme.ok;
                    font-size: 12 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if Store.warning != "" : Text { text: Store.warning; color: Theme.warn; font-size: 12 * u; wrap: word-wrap; }
                if !Store.details-loading : HorizontalLayout {
                    padding-top: 4 * u;
                    spacing: 8 * u;
                    alignment: start;
                    if root.main-action != "" || Store.details-error != "" : TvButton {
                        u: root.u;
                        text: Store.details-error != "" ? "Try again" : root.main-action;
                        progress: root.busy ? Store.install-progress : -1;
                        primary: true;
                        focused: root.act == 0 && !root.files && !root.reading;
                        clicked => {
                            root.act = 0;
                            root.press-main();
                        }
                    }
                    TvButton {
                        u: root.u;
                        // A star alone, so five buttons fit; the corner says what it does.
                        text: Store.is-favourite ? "★" : "☆";
                        focused: (root.act == 1 || (root.act == 0 && root.main-action == "" && Store.details-error == "")) && !root.files && !root.reading;
                        clicked => {
                            root.act = 1;
                            Store.toggle-favourite();
                        }
                    }
                    if Store.options.length > 0 && !Store.is-website : TvButton {
                        u: root.u;
                        text: "Versions";
                        focused: root.act == 2 && !root.files && !root.reading;
                        clicked => {
                            root.act = 2;
                            root.opt = 0;
                            root.reading = false;
                            root.files = true;
                        }
                    }
                    if root.has-reviews : TvButton {
                        u: root.u;
                        text: "Reviews";
                        focused: root.act == root.reviews-idx && !root.files && !root.reading;
                        clicked => {
                            root.act = root.reviews-idx;
                            root.rev = 0;
                            root.files = false;
                            root.reading = true;
                        }
                    }
                    if Store.in-library : TvButton {
                        u: root.u;
                        text: root.remove-armed ? "Confirm" : "Remove";
                        focused: root.act == root.remove-idx && !root.files && !root.reading;
                        clicked => {
                            root.act = root.remove-idx;
                            if (root.remove-armed) {
                                root.remove-armed = false;
                                Store.remove-from-library(Store.app.id);
                            } else {
                                root.remove-armed = true;
                            }
                        }
                    }
                }
                if !root.files && Store.notes != "" : VerticalLayout {
                    padding-top: 8 * u;
                    spacing: 4 * u;
                    Text { text: Store.is-website ? "About this website" : Store.is-package ? "About this package" : "What's new in " + Store.app.version; color: Theme.text; font-size: 13 * u; font-weight: 700; }
                    Rectangle {
                        notes-line := Text { text: "X"; font-size: 12 * u; visible: false; }
                        height: floor(62 * u / notes-line.preferred-height) * notes-line.preferred-height;
                        clip: true;
                        Text {
                            y: 0;
                            width: parent.width;
                            text: Store.notes;
                            color: Theme.text-dim;
                            font-size: 12 * u;
                            wrap: word-wrap;
                            vertical-alignment: TextVerticalAlignment.top;
                        }
                    }
                }
            }

            // Right: pictures and the description, or every file when asked for.
            if root.reading && root.rev < Store.reviews.length : VerticalLayout {
                x: 496 * u;
                y: 70 * u;
                width: parent.width - self.x - margin;
                spacing: 8 * u;
                alignment: start;
                Text {
                    text: (root.rev > 0 ? "‹   " : "") + "Review " + (root.rev + 1) + " of " + Store.reviews.length + (root.rev < Store.reviews.length - 1 ? "   ›" : "") + (Store.app.rating != "" ? "      ★ " + Store.app.rating + " from " + Store.app.rating-count : "");
                    color: Theme.text;
                    font-size: 13 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Rectangle {
                    border-radius: 10 * u;
                    background: Theme.surface-2;
                    border-width: 2 * u;
                    border-color: white;
                    height: review-box.preferred-height;
                    accessible-role: text;
                    accessible-label: "Review " + (root.rev + 1) + ": " + Store.reviews[root.rev].title;
                    review-box := VerticalLayout {
                        width: parent.width;
                        padding: 14 * u;
                        spacing: 6 * u;
                        Text { text: Store.reviews[root.rev].stars; color: Theme.warn; font-size: 14 * u; }
                        Text { text: Store.reviews[root.rev].title; color: Theme.text; font-size: 15 * u; font-weight: 700; wrap: word-wrap; }
                        Rectangle {
                            review-line := Text { text: "X"; font-size: 13 * u; visible: false; }
                            height: min(review-text.preferred-height, floor(250 * u / review-line.preferred-height) * review-line.preferred-height);
                            clip: true;
                            review-text := Text {
                                y: 0;
                                width: parent.width;
                                text: Store.reviews[root.rev].text;
                                color: Theme.text;
                                font-size: 13 * u;
                                wrap: word-wrap;
                                vertical-alignment: TextVerticalAlignment.top;
                            }
                        }
                        Text { text: Store.reviews[root.rev].meta; color: Theme.text-dim; font-size: 11 * u; overflow: elide; }
                    }
                }
                Text {
                    text: "Reviews are written by other people and come from the ratings service the GNOME and KDE app stores use.";
                    color: Theme.text-dim;
                    font-size: 11 * u;
                    wrap: word-wrap;
                }
            }
            if !root.files && !root.reading : VerticalLayout {
                x: 496 * u;
                y: 70 * u;
                width: parent.width - self.x - margin;
                spacing: 12 * u;
                alignment: start;
                if Store.screenshots.length > 0 : Rectangle {
                    height: 236 * u;
                    border-radius: 10 * u;
                    clip: true;
                    border-width: 0.5 * u;
                    border-color: Theme.stroke;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: Store.screenshots[0];
                        image-fit: cover;
                    }
                }
                if Store.about != "" : Rectangle {
                    about-line := Text { text: "X"; font-size: 13 * u; visible: false; }
                    height: floor((Store.screenshots.length > 0 ? 150 * u : 380 * u) / about-line.preferred-height) * about-line.preferred-height;
                    clip: true;
                    Text {
                        y: 0;
                        width: parent.width;
                        text: Store.about;
                        color: Theme.text;
                        font-size: 13 * u;
                        wrap: word-wrap;
                        vertical-alignment: TextVerticalAlignment.top;
                    }
                }
            }
            if root.files : VerticalLayout {
                x: 496 * u;
                y: 70 * u;
                width: parent.width - self.x - margin;
                spacing: 8 * u;
                alignment: start;
                Text {
                    text: Store.versions.length > 1 ? (Store.selected-version > 0 ? "‹   " : "") + "Version " + Store.versions[Store.selected-version] + (Store.selected-version == 0 ? "  ·  newest" : "") + (Store.selected-version < Store.versions.length - 1 ? "   ›  older" : "") : "Every file that works on this TV";
                    color: Theme.text;
                    font-size: 13 * u;
                    font-weight: 700;
                }
                for option[i] in Store.options : Rectangle {
                    property <bool> focused: i == root.opt;
                    property <bool> mine: Store.install-index == i && Store.install-state != 0;
                    height: 54 * u;
                    Rectangle {
                        x: focused ? -3 * u : 0;
                        width: parent.width + (focused ? 6 * u : 0);
                        border-radius: 10 * u;
                        background: focused ? Theme.surface-2 : Theme.surface;
                        border-width: focused ? 2 * u : 0.5 * u;
                        border-color: focused ? white : Theme.stroke;
                        animate x, width, border-width { duration: 110ms; }
                        TouchArea {
                            clicked => {
                                root.opt = i;
                                Store.install(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14 * u;
                            padding-right: 14 * u;
                            spacing: 10 * u;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2 * u;
                                horizontal-stretch: 1;
                                Text { text: option.label + (i == 0 ? "  ·  best for this TV" : ""); color: Theme.text; font-size: 13 * u; font-weight: 700; overflow: elide; }
                                Text {
                                    text: mine ? (Store.install-state == 1 ? "Downloading…  " + round(Store.install-progress * 100) + "%" : Store.install-message) : option.note != "" ? option.note : option.size != "" ? option.file + "  ·  " + option.size : option.file;
                                    color: mine && Store.install-state == 3 ? Theme.bad : mine && Store.install-state == 2 ? Theme.ok : option.note != "" && !mine ? Theme.warn : Theme.text-dim;
                                    font-size: 11.5 * u;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                // A download arrow on the focused file; a cross while it is coming down.
                                if focused : Rectangle {
                                    width: 32 * u;
                                    height: 32 * u;
                                    border-radius: 16 * u;
                                    background: Theme.accent;
                                    accessible-role: button;
                                    accessible-label: mine && Store.install-state == 1 ? "Cancel" : option.verb;
                                    Image {
                                        width: 17 * u;
                                        height: 17 * u;
                                        source: mine && Store.install-state == 1 ? @image-url("icons/close.svg") : @image-url("icons/download.svg");
                                        colorize: #0e1014;
                                    }
                                }
                            }
                        }
                    }
                }
                if Store.hidden.length > 0 : Text {
                    text: Store.hidden.length + (Store.hidden.length == 1 ? " file for other devices is" : " files for other devices are") + " not listed.";
                    color: Theme.text-dim;
                    font-size: 12 * u;
                }
            }
        }
    }
    if Store.toast != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        // Clear of the bottom safe margin.
        y: parent.height - top - 34 * u;
        width: toast-label.preferred-width + 36 * u;
        height: 30 * u;
        border-radius: 15 * u;
        background: #eceef3;
        toast-label := Text {
            text: Store.toast;
            color: Store.toast-is-error ? #b3261e : #0e1014;
            font-size: 12 * u;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
