// TV: a ten-foot interface driven entirely by a remote's D-pad (arrow keys), OK (Enter)
// and Back (Escape). One thing has focus at a time and it is always obvious which.
// Every size is a multiple of `u` so the layout looks the same on a 540dp Android TV
// surface and a 1080p or 4K desktop window.
import { Theme } from "theme.slint";
import { AppCard, Section, Store } from "types.slint";
import { AppIcon, Busy, FadeIn, ProgressBar } from "widgets.slint";

// Sizes follow Android TV's guidance: content stays inside a 48dp side and 27dp
// top/bottom margin, body text is 12dp or larger, and the focused item grows a little
// as well as gaining a border, so it is obvious from across a room.
component TvTile inherits Rectangle {
    in property <AppCard> app;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    Rectangle {
        // The focused tile is drawn slightly larger, about 1.05x.
        x: focused ? -5 * u : 0;
        y: focused ? -3 * u : 0;
        width: parent.width + (focused ? 10 * u : 0);
        height: parent.height + (focused ? 6 * u : 0);
        border-radius: 10 * u;
        background: focused ? Theme.surface-2 : Theme.surface;
        border-width: focused ? 2 * u : 0.5 * u;
        border-color: focused ? white : Theme.stroke;
        opacity: focused ? 1 : 0.82;
        animate x, y, width, height, border-width, opacity, background { duration: 130ms; easing: ease-out; }
        TouchArea {
            clicked => { root.clicked(); }
        }
        VerticalLayout {
            padding: 11 * u;
            spacing: 6 * u;
            HorizontalLayout {
                spacing: 9 * u;
                AppIcon { initials: app.initials; tint: app.tint; icon: app.icon; size: 32 * u; }
                VerticalLayout {
                    alignment: center;
                    spacing: 1 * u;
                    Text { text: app.name; color: Theme.text; font-size: 14 * u; font-weight: 700; overflow: elide; }
                    Text {
                        text: app.has-update ? @tr("Update available") : app.installed ? @tr("Installed") : app.stat != "" ? app.stat : app.author;
                        color: app.has-update || app.installed ? Theme.accent : Theme.text-dim;
                        font-size: 11 * u;
                        font-weight: app.has-update || app.installed ? 700 : 400;
                        overflow: elide;
                    }
                }
            }
            // In a box of its own: a long summary ends with "…" on the last line that
            // fits, instead of running out through the bottom of the tile.
            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: floor(parent.height / (14 * u)) * 14 * u;
                    text: app.summary;
                    color: Theme.text-dim;
                    font-size: 11.5 * u;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: top;
                }
            }
        }
    }
}

// A category on the page of categories: its name, and a stripe of its own colour.
component TvKind inherits Rectangle {
    in property <AppCard> kind;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    accessible-role: button;
    accessible-label: kind.name;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: focused ? -5 * u : 0;
        y: focused ? -3 * u : 0;
        width: parent.width + (focused ? 10 * u : 0);
        height: parent.height + (focused ? 6 * u : 0);
        border-radius: 10 * u;
        background: focused ? Theme.surface-2 : Theme.surface;
        border-width: focused ? 2 * u : 0.5 * u;
        border-color: focused ? white : Theme.stroke;
        opacity: focused ? 1 : 0.82;
        clip: true;
        animate x, y, width, height, border-width, opacity, background { duration: 130ms; easing: ease-out; }
        TouchArea {
            clicked => { root.clicked(); }
        }
        Rectangle {
            x: 14 * u;
            y: (parent.height - self.height) / 2;
            width: 4 * u;
            height: 26 * u;
            border-radius: 2 * u;
            background: kind.tint;
        }
        Text {
            x: 30 * u;
            width: parent.width - 42 * u;
            height: parent.height;
            text: kind.name;
            color: Theme.text;
            font-size: 14 * u;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// An entry of the top bar: where you are is underlined, where the remote points is boxed.
component TvTab inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    in property <bool> focused;
    in property <bool> attention;
    in property <length> u;
    width: label.preferred-width + 22 * u;
    border-radius: 14 * u;
    background: focused ? Theme.surface-2 : transparent;
    border-width: focused ? 2 * u : 0;
    border-color: white;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.current;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.attention ? Theme.warn : root.current || root.focused ? Theme.text : Theme.text-dim;
        font-size: 12 * u;
        font-weight: root.current ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.current && !root.focused : Rectangle {
        x: 11 * u;
        y: parent.height - 2 * u;
        width: parent.width - 22 * u;
        height: 2 * u;
        border-radius: 1 * u;
        background: Theme.accent;
    }
}

// A setting that is on or off. OK switches it.
// Where the highlighted setting is in its list, which the list reads to move itself.
global TvSeen {
    in-out property <length> y;
    in-out property <length> height;
}

component TvSetting inherits Rectangle {
    // The highlighted row says where it is, and again if rows above it come or go.
    changed focused => { if (self.focused) { TvSeen.y = self.y; TvSeen.height = self.height; } }
    changed y => { if (self.focused) { TvSeen.y = self.y; TvSeen.height = self.height; } }
    in property <string> label;
    in property <bool> on;
    // What to show on the right instead of On or Off.
    in property <string> value;
    in property <bool> focused;
    in property <length> u;
    callback clicked;
    height: 26 * u;
    border-radius: 8 * u;
    background: focused ? Theme.surface-2 : transparent;
    border-width: focused ? 2 * u : 0;
    border-color: white;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10 * u;
        padding-right: 10 * u;
        spacing: 12 * u;
        Text { horizontal-stretch: 1; text: root.label; color: Theme.text; font-size: 12 * u; vertical-alignment: center; overflow: elide; }
        Text { text: root.value != "" ? root.value : root.on ? @tr("On") : @tr("Off"); color: root.value != "" ? Theme.accent : root.on ? Theme.ok : Theme.text-dim; font-size: 12 * u; font-weight: 700; vertical-alignment: center; }
    }
}

// A button on the TV app page. The remote moves between them; OK presses the focused one.
component TvButton inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <bool> primary;
    in property <length> u;
    // 0 to 1 while this button's action is under way.
    in property <float> progress: -1;
    callback clicked;
    height: 34 * u;
    width: label.preferred-width + 28 * u;
    Rectangle {
        x: focused ? -3 * u : 0;
        y: focused ? -2 * u : 0;
        width: parent.width + (focused ? 6 * u : 0);
        height: parent.height + (focused ? 4 * u : 0);
        border-radius: 17 * u;
        background: primary ? Theme.accent : Theme.surface-2;
        border-width: focused ? 2 * u : 0;
        border-color: white;
        opacity: focused ? 1 : 0.75;
        animate x, y, width, height, border-width, opacity { duration: Theme.quick; easing: ease-out; }
        clip: root.progress >= 0;
        if root.progress >= 0 : Rectangle {
            x: 0;
            width: parent.width * clamp(root.progress, 0.03, 1.0);
            height: parent.height;
            background: #ffffff66;
            animate width { duration: Theme.smooth; easing: ease-out; }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            color: primary ? #0e1014 : Theme.text;
            font-size: 13 * u;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One row of the form for writing a review: what it is, what has been put in it,
// and, while it is highlighted and empty, how to fill it.
component TvWriteRow inherits Rectangle {
    in property <length> u;
    in property <string> name;
    in property <string> value;
    in property <string> hint;
    in property <bool> focused;
    in property <bool> tall;
    in property <bool> gold;
    callback clicked;
    height: (root.tall ? 62 : 34) * u;
    border-radius: 8 * u;
    background: root.focused ? Theme.surface-2 : Theme.surface;
    border-width: root.focused ? 2 * u : 0.5 * u;
    border-color: root.focused ? white : Theme.stroke;
    clip: true;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    TouchArea {
        clicked => { root.clicked(); }
    }
    Text { x: 12 * u; y: 0; width: 84 * u; height: 34 * u; text: root.name; color: Theme.text-dim; font-size: 12 * u; font-weight: 700; vertical-alignment: center; }
    Text {
        x: 100 * u;
        y: root.tall ? 8 * u : 0;
        width: parent.width - 112 * u;
        height: parent.height - (root.tall ? 14 * u : 0);
        text: root.value != "" ? root.value : root.focused ? root.hint : "";
        color: root.value == "" ? Theme.text-dim : root.gold ? Theme.warn : Theme.text;
        font-size: (root.gold ? 16 : 13) * u;
        wrap: root.tall ? word-wrap : no-wrap;
        overflow: elide;
        vertical-alignment: root.tall ? top : center;
    }
}

// One line of an app's details: what it is on the left, the value beside it.
component TvFact inherits Rectangle {
    in property <string> name;
    in property <string> value;
    in property <length> u;
    min-height: 16 * root.u;
    accessible-role: text;
    accessible-label: root.name + ": " + root.value;
    HorizontalLayout {
        spacing: 12 * root.u;
        Text { width: 130 * root.u; text: root.name; color: Theme.text-dim; font-size: 12 * root.u; }
        Text { horizontal-stretch: 1; text: root.value; color: Theme.text; font-size: 12 * root.u; wrap: word-wrap; }
    }
}

component TvStat inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    in property <length> u;
    spacing: 1 * u;
    Text { text: root.value; color: Theme.text; font-size: 14 * u; font-weight: 700; }
    Text { text: root.caption; color: Theme.text-dim; font-size: 11 * u; }
}

export component TvShell inherits Rectangle {
    property <length> u: root.height / 540;
    property <bool> on-library: Store.page == 2 && !Store.details-open;
    // Home and a page of search results both have the search bar: it stays where it
    // is when a search has been made, so the next one is one press away.
    property <bool> has-search: (Store.page == 0 || Store.page == 1) && !root.on-cats;
    // The page of categories: open from its button in the top bar, and still open
    // underneath a category chosen from it, so Back from that one returns to it.
    property <bool> cats-open: false;
    property <bool> has-cats: Store.tv-categories.length > 1;
    property <bool> on-cats: root.cats-open && root.has-cats && Store.page == 0 && !Store.details-open;
    // The category the remote points at there, counted along the rows of four.
    property <int> cat-at: 0;
    changed has-cats => { root.cat-at = 0; }
    // The on-screen keyboard is up, typing into the search bar.
    property <bool> osk: false;
    // Run the search that has been typed and go to what it finds.
    function run-search() {
        root.osk = false;
        root.cats-open = false;
        Store.search(Store.query);
        root.cur-row = 0;
        root.cur-col = 0;
        root.zone = 0;
        scope.focus();
    }
    // The keyboard's last key was pressed: give the password, or search.
    function osk-done() {
        if (Store.password-ask) {
            Store.password-submit();
        } else if (Store.osk-target != 0) {
            // A review's words: typed, and back to the review.
            root.osk = false;
            Store.osk-target = 0;
        } else {
            root.run-search();
        }
    }
    // A letter, digit or symbol from a real keyboard, not a key that moves or acts.
    pure function typed(event: KeyEvent) -> bool {
        !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && event.text.character-count == 1
            && event.text != Key.UpArrow && event.text != Key.DownArrow && event.text != Key.LeftArrow
            && event.text != Key.RightArrow && event.text != Key.Return && event.text != Key.Escape
            && event.text != Key.Backspace && event.text != Key.Back && event.text != Key.Tab
            && event.text != Key.Delete && event.text != Key.Home && event.text != Key.End
            && event.text != Key.PageUp && event.text != Key.PageDown
    }
    property <[Section]> rows: Store.page == 2 ? Store.tv-library-rows : Store.tv-rows;
    property <int> cur-row: 0;
    property <int> cur-col: 0;
    // Focused option on the details screen.
    property <int> opt: 0;
    property <AppCard> current: rows[cur-row].apps[cur-col];
    // Four tiles fill a row inside the safe area (Android TV's four-card width).
    property <length> tile-w: 201 * u;
    property <length> tile-h: 104 * u;
    property <length> tile-gap: 20 * u;
    property <length> row-h: 146 * u;
    // Android TV's overscan-safe margins.
    property <length> margin: 48 * u;
    property <length> top: 27 * u;

    // The app page: which button has focus (0 main, 1 favourite, 2 other files), and
    // whether the list of every file is open.
    property <int> act: 0;
    property <bool> files: false;
    // Where the highlight sits in the list of versions and files, from its top: the
    // list moves up so that it stays on the screen.
    property <length> files-at: 0;
    // Where the remote's focus is: 0 the grid of apps, 1 the top bar, 2 the library's
    // own buttons. `tab` is the focused entry of the top bar: Home, Library, Search,
    // Settings, This TV, and 5 for Categories, which sits after Library.
    property <int> zone: 0;
    property <int> tab: 0;
    property <int> lib-act: 0;
    property <bool> lib-has-actions: root.on-library && Store.library.length > 0;
    property <bool> lib-can-update-all: Store.updates-count > 1 && Store.updating-id == "";
    property <int> sys-act: 0;
    // On the device page: 0 is the row of buttons, 1 to 3 the settings below them.
    property <int> sys-row: 0;
    // Where the highlight lands in the row just moved to. Each row starts from its
    // beginning, so after scrolling along one the next is entered at its first app;
    // with nothing scrolled, the app straight above or below.
    function col-in-next-row() -> int {
        return root.cur-col > 2 ? 0 : max(0, min(rows[cur-row].apps.length - 1, root.cur-col));
    }
    function enter-bar() {
        // From Home, Up lands on Search: it is what people go up there for.
        // From an app's page there is no search bar to land on: the entry of the page
        // the app was opened from, or Home.
        root.tab = root.on-cats || (root.cats-open && Store.details-open) ? 5 : Store.page == 2 ? 1 : Store.page == 3 ? 3 : Store.page == 4 ? 4 : Store.details-open ? 0 : 2;
        root.zone = 1;
    }
    // The entry of the top bar to the left or right of the focused one.
    pure function tab-left() -> int {
        root.tab == 4 ? 3 : root.tab == 3 ? (root.has-cats ? 5 : 1) : root.tab == 5 ? 1 : 0
    }
    pure function tab-right() -> int {
        root.tab == 0 ? 1 : root.tab == 1 ? (root.has-cats ? 5 : 3) : root.tab == 5 ? 3 : 4
    }
    // Back from what a search found, or from a category in full: to the page of
    // categories if it came from there, else Home.
    function back-from-results() {
        if (root.cats-open) {
            Store.leave-search();
            root.cur-row = 0;
            root.cur-col = 0;
            root.zone = 0;
        } else {
            root.tab = 0;
            root.activate-tab();
        }
    }
    // Show everything in one of the categories, from their page.
    function open-category(at: int) {
        root.cat-at = max(0, min(Store.tv-categories.length - 1, at));
        root.cur-row = 0;
        root.cur-col = 0;
        root.zone = 0;
        scope.focus();
        Store.open(Store.tv-categories[root.cat-at].id);
    }
    // Go where the focused entry of the top bar leads.
    function activate-tab() {
        // From an app's page, the page is put away first.
        if (Store.details-open) {
            Store.close-details();
        }
        root.cur-row = 0;
        root.cur-col = 0;
        if (root.tab == 5) {
            // The categories take the page: whatever search was open is put away.
            Store.leave-search();
            root.cats-open = true;
            root.cat-at = 0;
            root.zone = 0;
            return;
        }
        root.cats-open = false;
        if (root.tab == 0) {
            // Home is Home: a search that was open is put away.
            Store.leave-search();
            root.zone = 0;
        } else if (root.tab == 1) {
            Store.page = 2;
            root.lib-act = 0;
            root.zone = Store.library.length > 0 ? 2 : Store.tv-library-rows.length > 0 ? 0 : 1;
        } else if (root.tab == 2) {
            if (!root.has-search) {
                Store.page = 0;
            }
            // The on-screen keyboard comes up: a remote has no letters.
            root.zone = 1;
            scope.focus();
            Store.osk-open();
            root.osk = true;
        } else if (root.tab == 3) {
            Store.page = 3;
            root.sys-row = 1;
            root.zone = 0;
        } else {
            Store.page = 4;
            root.sys-row = 0;
            root.sys-act = 0;
            root.zone = 0;
        }
    }
    property <bool> on-system: Store.page == 4 && !Store.details-open;
    // Settings: `sys-row` is the focused one, from 1. The first five are fixed, then
    // Steam's (two while there is a choice of how to sign in), then a switch per source.
    property <bool> on-settings: Store.page == 3 && !Store.details-open;
    property <int> steam-rows: !Store.steam-available ? 0 : Store.steam-signed-in || Store.steam-state != 0 ? 1 : 2;
    property <int> src-first: 16 + root.steam-rows;
    // The language is the last row, after the sources.
    property <int> lang-row: root.src-first + Store.sources.length;
    // Then the country whose prices are asked for.
    property <int> country-row: root.lang-row + 1;
    // And after it, whether to show what does not run here.
    property <int> all-row: root.country-row + 1;
    // Where Windows programs can be set up to run: whether to offer them.
    property <int> win-row: Store.windows-possible ? root.all-row + 1 : -1;
    // And, while they are offered, which Proton runs them.
    property <int> proton-row: Store.windows-possible && Store.windows-apps ? root.win-row + 1 : -1;
    property <int> auto-row: root.all-row + 1 + (Store.windows-possible ? 1 : 0) + (root.proton-row > 0 ? 1 : 0);
    // The sections of the list, on the left: where each begins, to jump to. `set-nav`
    // is the remote being in that list, `set-at` the section it points at there.
    property <bool> set-nav: false;
    property <int> set-at: 0;
    property <[string]> set-names: [@tr("General"), @tr("Family"), @tr("Accounts"), @tr("Stores"), @tr("Language and country"), @tr("Other devices"), @tr("Updates")];
    property <[int]> set-starts: [1, 8, 14, root.src-first, root.lang-row, root.all-row, root.auto-row];
    // The section the highlighted setting is in.
    property <int> set-in: root.sys-row >= root.auto-row ? 6 : root.sys-row >= root.all-row ? 5 : root.sys-row >= root.lang-row ? 4 : root.sys-row >= root.src-first ? 3 : root.sys-row >= 14 ? 2 : root.sys-row >= 8 ? 1 : 0;
    changed on-settings => { root.set-nav = false; }
    property <int> set-last: root.auto-row;
    changed set-last => { root.sys-row = min(root.sys-row, root.set-last); }
    property <bool> sys-can-update: Store.system-state == 3;
    // Buttons on that page: Update (when there is one), Check again (where updates are
    // handled), and always last, the way out of the TV layout.
    property <bool> sys-working: Store.system-state == 1 || Store.system-state == 4;
    // Updates are in place and wait for a restart: the first button offers one.
    property <bool> sys-can-restart: Store.system-restart && !root.sys-can-update;
    property <bool> sys-lead: root.sys-can-update || root.sys-can-restart;
    property <int> sys-last: !Store.system-supported || sys-working ? 0 : sys-lead ? 2 : 1;
    changed sys-last => { root.sys-act = min(root.sys-act, root.sys-last); }
    property <bool> busy: Store.install-state == 1;
    property <bool> is-update: Store.installed-version != "" && Store.installed-version != "installed" && Store.app.version != "" && Store.installed-version != Store.app.version;
    // An update is waiting with the tool that installed it, not with the store.
    property <bool> outside: Store.outside-update && !busy && !Store.queued;
    property <bool> open-instead: Store.can-open && !is-update && !outside && !busy;
    property <string> main-action: busy ? @tr("Cancel") : Store.queued ? @tr("Queued") : outside ? @tr("Update") : open-instead ? @tr("Open") : is-update ? @tr("Update") : Store.options.length == 0 ? "" : Store.installed-version != "" && !Store.is-website ? @tr("Install again") : Store.options[0].verb;
    // The buttons on an app's page, left to right: the main one, Favourite, Other files
    // (when there are any) and Remove (when the app is in the library).
    // Other versions of the service and other sources of the app come first in the
    // Versions list, above this release's files.
    property <int> choices: Store.tv-choices.length;
    property <bool> has-files: (Store.options.length > 0 && !Store.is-website) || root.choices > 0;
    property <bool> has-reviews: Store.reviews.length > 0;
    // Something the app needs first, which the store can install (FUSE, Steam).
    property <bool> has-helper: Store.helper-id != "";
    property <int> helper-idx: !has-helper ? -1 : has-files ? 3 : 2;
    property <bool> removable: Store.in-library || Store.can-uninstall;
    property <int> remove-idx: !root.removable ? -1 : 2 + (has-files ? 1 : 0) + (has-helper ? 1 : 0);
    property <int> last-act: 1 + (has-files ? 1 : 0) + (has-helper ? 1 : 0) + (root.removable ? 1 : 0);
    // In the list of versions and files: the rows before the files are the other
    // versions of the service, the other sources, and one row to change version.
    property <int> vrow: Store.versions.length > 1 ? 1 : 0;
    property <int> pre: root.choices + root.vrow;
    // A website has nothing to pick between: adding it is the main button.
    property <int> nfiles: Store.is-website ? 0 : Store.options.length;
    // The list of releases, open to pick one from.
    property <bool> ver-open: false;
    property <int> ver-pick: 0;
    // Reading what people wrote: one review at a time, large enough for the sofa.
    property <bool> reading: false;
    property <int> rev: 0;
    changed has-reviews => {
        if (!root.has-reviews) {
            root.reading = false;
        }
    }
    // Writing one: somewhere takes a review of this app.
    property <bool> can-review: Store.review-places.length > 0;
    // The highlight is on "Write a review", which sits before the first review.
    property <bool> on-write: root.sec == 3 && root.can-review && (root.rev < 0 || !root.has-reviews);
    property <bool> writing: false;
    changed can-review => {
        if (!root.can-review) {
            root.writing = false;
        }
    }
    // The rows of the form: 0 the stars, 1 the title, 2 the text, 3 the name (only
    // where the review is sent from here), then the places when there is more than
    // one, then send and stop.
    property <int> w-row: 0;
    property <int> w-stars: 0;
    property <int> w-np: Store.review-places.length > 1 ? Store.review-places.length : 0;
    property <int> w-send: 4 + root.w-np;
    function w-move(d: int) {
        root.w-row = max(0, min(root.w-send + 1, root.w-row + d));
        if (root.w-row == 3 && !Store.review-from-here) {
            root.w-row += d;
        }
    }
    function w-open() {
        root.w-row = 0;
        root.w-stars = 0;
        Store.review-title = "";
        Store.review-text = "";
        root.writing = true;
    }
    function w-type(field: int) {
        Store.osk-target = field;
        Store.osk-open();
        root.osk = true;
    }
    function w-send-it() {
        // A store's own box is filled by pasting: the words go on the clipboard.
        if (Store.review-copies && Store.review-text != "") {
            clip.text = Store.review-title == "" ? Store.review-text : Store.review-title + "\n\n" + Store.review-text;
            clip.select-all();
            clip.copy();
        }
        Store.send-review(root.w-stars, Store.review-title, Store.review-text, Store.review-name);
    }
    function w-ok() {
        if (Store.review-state == 2) {
            root.writing = false;
        } else if (Store.review-state == 1) {
            // Being sent: nothing to press.
        } else if (root.w-row == 0) {
            root.w-stars = root.w-stars >= 5 ? 1 : root.w-stars + 1;
        } else if (root.w-row <= 3) {
            root.w-type(root.w-row);
        } else if (root.w-row < root.w-send) {
            Store.toggle-review-place(Store.review-places[root.w-row - 4].id);
        } else if (root.w-row == root.w-send) {
            root.w-send-it();
        } else {
            root.writing = false;
        }
    }
    // The app page is a column of sections the highlight moves down through:
    // 0 the buttons, 1 pictures, 2 the description, 3 reviews, 4 the details.
    property <int> sec: 0;
    // An app's page opens with the highlight on the page, wherever it was before.
    property <bool> on-app: Store.details-open;
    changed on-app => {
        if (root.on-app && root.zone == 1) {
            root.zone = 0;
        }
    }
    property <bool> has-pics: Store.screenshots.length > 0;
    property <bool> has-about: Store.about != "" || Store.notes != "";
    // Which picture and which review the highlight is on in their rows.
    property <int> pic: 0;
    // A picture shown large, and the description opened to read and follow its links.
    property <bool> viewer: false;
    property <bool> about-open: false;
    property <length> about-scroll: 0;
    property <length> about-max: 0;
    // In the opened description: 0 is the text, 1 and up its links.
    property <int> link: 0;
    function sec-exists(n: int) -> bool {
        return n == 0 || (n == 1 && root.has-pics) || (n == 2 && root.has-about) || (n == 3 && (root.has-reviews || root.can-review)) || n == 4;
    }
    function sec-down() {
        if (root.sec < 1 && root.sec-exists(1)) { root.sec = 1; }
        else if (root.sec < 2 && root.sec-exists(2)) { root.sec = 2; }
        else if (root.sec < 3 && root.sec-exists(3)) { root.sec = 3; }
        else if (root.sec < 4) { root.sec = 4; }
    }
    function sec-up() {
        if (root.sec > 3 && root.sec-exists(3)) { root.sec = 3; }
        else if (root.sec > 2 && root.sec-exists(2)) { root.sec = 2; }
        else if (root.sec > 1 && root.sec-exists(1)) { root.sec = 1; }
        else { root.sec = 0; }
    }
    // The question in front of something guarded: which answer or digit is highlighted,
    // and how much of a PIN has been entered.
    property <int> gate-choice: 0;
    property <int> gate-digit: 0;
    property <string> gate-entry;
    property <int> gate-count: 0;
    property <int> gate-now: Store.gate;
    changed gate-now => {
        root.gate-choice = 0;
        root.gate-digit = 0;
        root.gate-entry = "";
        root.gate-count = 0;
    }
    function gate-add(d: string) {
        root.gate-entry += d;
        root.gate-count += 1;
        if (root.gate-count == 4) {
            Store.gate-pin(root.gate-entry);
            root.gate-entry = "";
            root.gate-count = 0;
        }
    }
    // Remove asks twice: the first OK only arms it.
    property <bool> remove-armed: false;
    changed act => { root.remove-armed = false; }
    changed last-act => { root.act = min(root.act, root.last-act); }
    property <string> shown-id: Store.app.id;
    changed shown-id => {
        root.remove-armed = false;
        root.reading = false;
        root.writing = false;
        root.rev = 0;
        root.act = 0;
        root.files = false;
        root.ver-open = false;
        root.opt = 0;
        root.sec = 0;
        root.pic = 0;
        root.viewer = false;
        root.about-open = false;
        root.about-scroll = 0;
        root.link = 0;
    }
    function press-main() {
        if (Store.details-error != "") {
            Store.retry-details();
        } else if (root.busy) {
            Store.cancel-install();
        } else if (Store.queued) {
            Store.install(0);
        } else if (root.outside) {
            Store.update-app(Store.app.id);
        } else if (root.open-instead) {
            Store.launch();
        } else if (Store.options.length > 0) {
            Store.install(0);
        }
    }

    background: @linear-gradient(180deg, #151a26 0%, #0b0d12 70%);

    init => { scope.focus(); }

    // Rows come and go (search results, the library row). Keep the focus on something
    // that exists instead of pointing past the end.
    changed rows => {
        root.cur-row = max(0, min(root.cur-row, rows.length - 1));
        root.cur-col = max(0, min(root.cur-col, rows[root.cur-row].apps.length - 1));
    }

    scope := FocusScope {
        // While the search box has focus, steal the keys that should leave it.
        capture-key-pressed(event) => {
            if (search.has-focus && (event.text == Key.DownArrow || event.text == Key.Escape || event.text == Key.Back)) {
                root.zone = 0;
                scope.focus();
                return accept;
            }
            // Up, or sideways from an empty box, goes back to the top bar.
            if (search.has-focus && (event.text == Key.UpArrow || (search.text == "" && (event.text == Key.RightArrow || event.text == Key.LeftArrow)))) {
                root.tab = 2;
                root.zone = 1;
                scope.focus();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            // A quiet sound for each press of the remote, unless the keys are typing.
            if (!search.has-focus) {
                if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    Store.play(0);
                } else if (event.text == Key.Return || event.text == " ") {
                    Store.play(1);
                } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    Store.play(2);
                }
            }
            if (Store.gate != 0) {
                // A question fills the screen: every key is its answer, or Back.
                if (event.text == Key.Escape || event.text == Key.Back) {
                    Store.gate-cancel();
                } else if (Store.gate == 1) {
                    if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                        root.gate-choice = 1 - root.gate-choice;
                    } else if (event.text == Key.Return || event.text == " ") {
                        Store.gate-answer(root.gate-choice == 1);
                    }
                } else if (event.text == "0" || event.text == "1" || event.text == "2" || event.text == "3" || event.text == "4" || event.text == "5" || event.text == "6" || event.text == "7" || event.text == "8" || event.text == "9") {
                    root.gate-add(event.text);
                } else if (event.text == Key.LeftArrow) {
                    root.gate-digit = max(0, root.gate-digit - 1);
                } else if (event.text == Key.RightArrow) {
                    root.gate-digit = min(10, root.gate-digit + 1);
                } else if (event.text == Key.Backspace) {
                    root.gate-entry = "";
                    root.gate-count = 0;
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.gate-digit == 10) {
                        root.gate-entry = "";
                        root.gate-count = 0;
                    } else {
                        root.gate-add("" + root.gate-digit);
                    }
                }
                return accept;
            }
            if (search.has-focus) {
                return reject;
            }
            if (root.osk || Store.password-ask) {
                // The keyboard is up: the arrows walk its keys, OK presses one, Back
                // puts it away. A real keyboard still types.
                if (event.text == Key.Escape || event.text == Key.Back) {
                    if (Store.password-ask) {
                        Store.password-cancel();
                    } else {
                        root.osk = false;
                        Store.osk-target = 0;
                    }
                } else if (event.text == Key.UpArrow) {
                    Store.osk-move(0);
                } else if (event.text == Key.DownArrow) {
                    Store.osk-move(1);
                } else if (event.text == Key.LeftArrow) {
                    Store.osk-move(2);
                } else if (event.text == Key.RightArrow) {
                    Store.osk-move(3);
                } else if (event.text == Key.Return) {
                    if (Store.osk-press()) {
                        root.osk-done();
                    }
                } else if (event.text == Key.Backspace) {
                    Store.osk-erase();
                } else if (root.typed(event)) {
                    Store.osk-type(event.text);
                }
                return accept;
            }
            // The search bar is highlighted and a letter, digit or symbol is typed (a
            // keyboard, or a remote with one): the box takes it at once, no OK needed.
            // Keys that move or act are left to the rest of this handler.
            if (root.zone == 1 && root.tab == 2 && !Store.details-open && root.typed(event)) {
                search.focus();
                search.text = search.text + event.text;
                // Where the next letter goes: after this one (the text is typed in order).
                search.set-selection-offsets(search.text.character-count, search.text.character-count);
                return accept;
            }
            if (root.zone == 1) {
                if (Store.details-open && (event.text == Key.DownArrow || event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace)) {
                    // On an app's page, Down or Back returns to the page.
                    root.zone = 0;
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    // Search is its own row under the tabs, so sideways steps over it.
                    if (root.tab != 2) {
                        root.tab = root.tab-left();
                    }
                } else if (event.text == Key.RightArrow) {
                    if (root.tab != 2) {
                        root.tab = root.tab-right();
                    }
                } else if (event.text == Key.UpArrow) {
                    // From search, up to the tabs.
                    if (root.tab == 2) {
                        root.tab = 0;
                    }
                } else if (event.text == Key.DownArrow) {
                    if (root.tab == 2) {
                        // From search, down to the apps.
                        if (rows.length > 0) {
                            root.zone = 0;
                        }
                    } else if (root.on-cats) {
                        root.zone = 0;
                    } else if (root.has-search) {
                        // On Home, down from any tab is search. Only OK changes page.
                        root.tab = 2;
                    } else if (Store.page == 2) {
                        root.lib-act = 0;
                        root.zone = Store.library.length > 0 ? 2 : Store.tv-library-rows.length > 0 ? 0 : 1;
                    } else if (Store.page == 3) {
                        root.sys-row = 1;
                        root.zone = 0;
                    } else {
                        root.sys-row = 0;
                        root.zone = 0;
                    }
                } else if (event.text == Key.Return || event.text == " ") {
                    root.activate-tab();
                } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    // Back from anywhere but Home goes Home; on Home there is nowhere
                    // further back, so the system may have the key.
                    if (Store.page == 0 && !root.on-cats) {
                        return reject;
                    }
                    root.tab = 0;
                    root.activate-tab();
                }
                return accept;
            }
            if (root.on-cats) {
                // The page of categories: four to a row, OK opens the one pointed at.
                if (event.text == Key.RightArrow) {
                    if (Math.mod(root.cat-at, 4) < 3 && root.cat-at + 1 < Store.tv-categories.length) {
                        root.cat-at += 1;
                    }
                } else if (event.text == Key.LeftArrow) {
                    if (Math.mod(root.cat-at, 4) > 0) {
                        root.cat-at -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    if (root.cat-at + 4 < Store.tv-categories.length) {
                        root.cat-at += 4;
                    } else if (floor(root.cat-at / 4) < floor((Store.tv-categories.length - 1) / 4)) {
                        // The last row is a short one: its last category is the nearest.
                        root.cat-at = Store.tv-categories.length - 1;
                    }
                } else if (event.text == Key.UpArrow) {
                    if (root.cat-at >= 4) {
                        root.cat-at -= 4;
                    } else {
                        root.enter-bar();
                    }
                } else if (event.text == Key.Return || event.text == " ") {
                    root.open-category(root.cat-at);
                } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    root.tab = 0;
                    root.activate-tab();
                } else {
                    return reject;
                }
                return accept;
            }
            if (root.on-settings) {
                if (Store.steam-state == 3) {
                    // The code fills the screen: Back or OK takes it down.
                    if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace || event.text == Key.Return || event.text == " ") {
                        Store.steam-cancel();
                    }
                } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    root.tab = 0;
                    root.activate-tab();
                } else if (root.set-nav) {
                    // In the list of sections: Up and Down along it, Right or OK into
                    // the one pointed at.
                    if (event.text == Key.UpArrow) {
                        if (root.set-at == 0) {
                            root.set-nav = false;
                            root.enter-bar();
                        } else {
                            root.set-at -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.set-at = min(root.set-names.length - 1, root.set-at + 1);
                    } else if (event.text == Key.RightArrow || event.text == Key.Return || event.text == " ") {
                        root.sys-row = root.set-starts[root.set-at];
                        root.set-nav = false;
                    }
                } else if (event.text == Key.LeftArrow && root.sys-row != root.country-row) {
                    // Left is the list of sections, on the one this setting is in.
                    root.set-at = root.set-in;
                    root.set-nav = true;
                } else if (event.text == Key.UpArrow) {
                    if (root.sys-row <= 1) {
                        root.enter-bar();
                    } else {
                        root.sys-row -= 1;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.sys-row = min(root.set-last, root.sys-row + 1);
                } else if (root.sys-row == root.country-row && (event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.Return || event.text == " ")) {
                    // A long list: Right or OK is the next country, Left the one before.
                    Store.step-country(event.text != Key.LeftArrow);
                } else if (event.text == Key.Return || event.text == " " || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    // OK, Left or Right switches the focused setting.
                    if (root.sys-row == 1) {
                        Store.set-ratings(!Store.show-ratings);
                    } else if (root.sys-row == 2) {
                        Store.set-check-on-start(!Store.check-updates-on-start);
                    } else if (root.sys-row == 3) {
                        Store.set-prereleases(!Store.include-prereleases);
                    } else if (root.sys-row == 4) {
                        Store.set-interface(1);
                    } else if (root.sys-row == 5) {
                        Store.set-essentials(!Store.show-essentials);
                    } else if (root.sys-row == 6) {
                        Store.set-sounds(!Store.sounds);
                    } else if (root.sys-row == 7) {
                        Store.set-prefer-kind(Store.prefer-kind >= 3 ? 0 : Store.prefer-kind + 1);
                    } else if (root.sys-row == 8) {
                        Store.set-family-mode(!Store.family-mode);
                    } else if (root.sys-row == 9) {
                        if (!Store.family-mode) {
                            Store.set-adult-on-home(!Store.adult-on-home);
                        }
                    } else if (root.sys-row == 10) {
                        if (!Store.family-mode) {
                            Store.set-adult-uncovered(!Store.adult-uncovered);
                        }
                    } else if (root.sys-row == 11) {
                        Store.set-pin();
                    } else if (root.sys-row == 12) {
                        if (Store.has-pin) {
                            Store.set-pin-for-installs(!Store.pin-for-installs);
                        }
                    } else if (root.sys-row == 13) {
                        if (Store.has-pin) {
                            Store.remove-pin();
                        }
                    } else if (root.sys-row == 14) {
                        if (Store.store-update != "") {
                            Store.view-store-update();
                        } else {
                            Store.check-store-update();
                        }
                    } else if (root.sys-row == 15) {
                        if (Store.has-token) {
                            Store.save-token("");
                        } else if (Store.signin-state == 0) {
                            Store.github-signin();
                        } else {
                            Store.github-cancel();
                        }
                    } else if (root.sys-row == 16 && root.steam-rows > 0) {
                        if (Store.steam-state != 0) {
                            Store.steam-cancel();
                        } else if (Store.steam-signed-in) {
                            Store.steam-signout();
                        } else {
                            Store.steam-signin-qr();
                        }
                    } else if (root.sys-row == 17 && root.steam-rows > 1) {
                        // The row goes away while signing in; the highlight moves to the one that stays.
                        root.sys-row = 13;
                        Store.steam-signin();
                    } else if (root.sys-row == root.lang-row) {
                        Store.next-language();
                    } else if (root.sys-row == root.all-row) {
                        Store.set-show-everything(!Store.show-everything);
                    } else if (root.sys-row == root.win-row) {
                        Store.set-windows-apps(!Store.windows-apps);
                    } else if (root.sys-row == root.proton-row) {
                        Store.set-windows-proton(1 - Store.windows-proton);
                    } else if (root.sys-row == root.auto-row) {
                        Store.set-auto-update(!Store.auto-update);
                    } else if (root.sys-row >= root.src-first) {
                        Store.set-source(Store.sources[root.sys-row - root.src-first].id, !Store.sources[root.sys-row - root.src-first].on);
                    }
                }
                return accept;
            }
            if (root.on-system) {
                if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    root.tab = 0;
                    root.activate-tab();
                } else if (event.text == Key.UpArrow) {
                    root.enter-bar();
                } else if (event.text == Key.RightArrow) {
                    root.sys-act = min(root.sys-last, root.sys-act + 1);
                } else if (event.text == Key.LeftArrow) {
                    root.sys-act = max(0, root.sys-act - 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.sys-act == root.sys-last) {
                        Store.set-interface(1);
                    } else if (root.sys-can-update && root.sys-act == 0) {
                        Store.system-update();
                    } else if (root.sys-can-restart && root.sys-act == 0) {
                        Store.system-restart-now();
                    } else {
                        Store.system-check();
                    }
                }
                return accept;
            }
            if (Store.details-open) {
                if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                    // Back closes whatever is open on top first, then the page.
                    if (root.ver-open) {
                        root.ver-open = false;
                    } else if (root.viewer) {
                        root.viewer = false;
                    } else if (root.about-open) {
                        root.about-open = false;
                    } else if (root.files) {
                        root.files = false;
                    } else if (root.reading) {
                        root.reading = false;
                    } else if (root.writing) {
                        root.writing = false;
                    } else {
                        Store.close-details();
                    }
                } else if (root.viewer) {
                    // A picture, large: sideways for the others, OK to go back.
                    if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                        root.pic = min(Store.screenshots.length - 1, root.pic + 1);
                    } else if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                        root.pic = max(0, root.pic - 1);
                    } else if (event.text == Key.Return || event.text == " ") {
                        root.viewer = false;
                    }
                } else if (root.about-open) {
                    // The description: Up and Down read through it, sideways picks a
                    // link, OK opens the link picked (or closes when none is).
                    if (event.text == Key.DownArrow) {
                        root.about-scroll = min(root.about-max, root.about-scroll + 150 * root.u);
                    } else if (event.text == Key.UpArrow) {
                        root.about-scroll = max(0, root.about-scroll - 150 * root.u);
                    } else if (event.text == Key.RightArrow) {
                        root.link = min(Store.about-links.length, root.link + 1);
                    } else if (event.text == Key.LeftArrow) {
                        root.link = max(0, root.link - 1);
                    } else if (event.text == Key.Return || event.text == " ") {
                        if (root.link > 0) {
                            Store.open-url(Store.about-links[root.link - 1]);
                        } else {
                            root.about-open = false;
                        }
                    }
                } else if (root.files) {
                    if (root.ver-open) {
                        // The releases, newest first: Up and Down, OK takes one.
                        if (event.text == Key.UpArrow) {
                            root.ver-pick = max(0, root.ver-pick - 1);
                        } else if (event.text == Key.DownArrow) {
                            root.ver-pick = min(Store.versions.length - 1, root.ver-pick + 1);
                        } else if (event.text == Key.LeftArrow) {
                            root.ver-open = false;
                        } else if (event.text == Key.Return || event.text == " ") {
                            root.ver-open = false;
                            if (root.ver-pick != Store.selected-version) {
                                Store.select-version(root.ver-pick);
                            }
                        }
                    } else if (event.text == Key.UpArrow) {
                        if (root.opt == 0) {
                            root.files = false;
                        } else {
                            root.opt -= 1;
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.opt = max(0, min(root.pre + root.nfiles - 1, root.opt + 1));
                    } else if (event.text == Key.LeftArrow) {
                        // Left leaves the list, like everywhere else on the page.
                        root.files = false;
                    } else if (event.text == Key.Return || event.text == " ") {
                        if (root.busy) {
                            Store.cancel-install();
                        } else if (root.opt < root.choices) {
                            Store.open(Store.tv-choices[root.opt].id);
                        } else if (root.opt < root.pre) {
                            root.ver-pick = Store.selected-version;
                            root.ver-open = true;
                        } else if (root.nfiles > 0) {
                            Store.install(root.opt - root.pre);
                        }
                    }
                } else if (root.writing) {
                    // Writing a review: Up and Down along the form, OK on a row to
                    // change it, Left and Right for the stars.
                    if (Store.review-state != 0) {
                        if (event.text == Key.Return || event.text == " ") {
                            root.w-ok();
                        }
                    } else if (event.text == Key.DownArrow) {
                        root.w-move(1);
                    } else if (event.text == Key.UpArrow) {
                        root.w-move(-1);
                    } else if (event.text == Key.RightArrow && root.w-row == 0) {
                        root.w-stars = min(5, root.w-stars + 1);
                    } else if (event.text == Key.LeftArrow && root.w-row == 0) {
                        root.w-stars = max(1, root.w-stars - 1);
                    } else if (event.text == Key.RightArrow && root.w-row == root.w-send) {
                        root.w-row = root.w-send + 1;
                    } else if (event.text == Key.LeftArrow && root.w-row == root.w-send + 1) {
                        root.w-row = root.w-send;
                    } else if (event.text == Key.Return || event.text == " ") {
                        root.w-ok();
                    }
                } else if (root.reading) {
                    if (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                        root.rev = min(Store.reviews.length - 1, root.rev + 1);
                    } else if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                        if (root.rev == 0) {
                            root.reading = false;
                        } else {
                            root.rev -= 1;
                        }
                    } else if (event.text == Key.Return || event.text == " ") {
                        root.reading = false;
                    }
                } else if (event.text == Key.DownArrow) {
                    root.sec-down();
                } else if (event.text == Key.UpArrow) {
                    if (root.sec == 0) {
                        // Up from the top of the page is the top bar, as on every other page.
                        root.enter-bar();
                    } else {
                        root.sec-up();
                    }
                } else if (root.sec == 1) {
                    // The row of pictures: sideways along it, OK for the one highlighted, large.
                    if (event.text == Key.RightArrow) {
                        root.pic = min(Store.screenshots.length - 1, root.pic + 1);
                    } else if (event.text == Key.LeftArrow) {
                        root.pic = max(0, root.pic - 1);
                    } else if (event.text == Key.Return || event.text == " ") {
                        root.viewer = true;
                    }
                } else if (root.sec == 2) {
                    if (event.text == Key.Return || event.text == " ") {
                        root.about-scroll = 0;
                        root.link = 0;
                        root.about-open = true;
                    }
                } else if (root.sec == 3) {
                    // The row of reviews: sideways along it, OK to read the one highlighted.
                    // "Write a review" comes before the first of them.
                    if (event.text == Key.RightArrow) {
                        root.rev = min(Store.reviews.length - 1, root.rev + 1);
                    } else if (event.text == Key.LeftArrow) {
                        root.rev = max(root.can-review ? -1 : 0, root.rev - 1);
                    } else if (event.text == Key.Return || event.text == " ") {
                        if (root.on-write) {
                            root.w-open();
                        } else {
                            root.reading = true;
                        }
                    }
                } else if (root.sec == 4) {
                    // The details: nothing to press.
                } else if (event.text == Key.LeftArrow) {
                    if (root.act == 0) {
                        Store.close-details();
                    } else {
                        root.act -= 1;
                    }
                } else if (event.text == Key.RightArrow) {
                    root.act = min(root.last-act, root.act + 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.act == 0) {
                        root.press-main();
                    } else if (root.act == 1) {
                        Store.toggle-favourite();
                    } else if (root.act == root.remove-idx) {
                        if (root.remove-armed) {
                            root.remove-armed = false;
                            Store.remove-from-library(Store.app.id);
                        } else {
                            root.remove-armed = true;
                        }
                    } else if (root.act == root.helper-idx) {
                        Store.open(Store.helper-id);
                    } else {
                        root.opt = 0;
                        root.files = true;
                    }
                }
                return accept;
            }
            if (root.zone == 2) {
                // The library's own buttons.
                if (event.text == Key.LeftArrow) {
                    root.lib-act = max(0, root.lib-act - 1);
                } else if (event.text == Key.RightArrow) {
                    root.lib-act = min(root.lib-can-update-all ? 1 : 0, root.lib-act + 1);
                } else if (event.text == Key.Return || event.text == " ") {
                    if (root.lib-can-update-all && root.lib-act == 0) {
                        Store.update-all();
                    } else {
                        Store.check-updates();
                    }
                } else if (event.text == Key.DownArrow) {
                    if (rows.length > 0) {
                        root.zone = 0;
                    }
                } else {
                    root.enter-bar();
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.cur-col = max(0, min(rows[cur-row].apps.length - 1, root.cur-col + 1));
            } else if (event.text == Key.LeftArrow) {
                root.cur-col = max(0, root.cur-col - 1);
            } else if (event.text == Key.DownArrow) {
                if (root.cur-row < rows.length - 1) {
                    root.cur-row += 1;
                    root.cur-col = root.col-in-next-row();
                }
            } else if (event.text == Key.UpArrow) {
                if (root.cur-row > 0) {
                    root.cur-row -= 1;
                    root.cur-col = root.col-in-next-row();
                } else if (root.lib-has-actions) {
                    root.zone = 2;
                } else {
                    root.enter-bar();
                }
            } else if (event.text == Key.Return || event.text == " ") {
                if (current.id != "") {
                    Store.open(current.id);
                }
            } else if (event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace) {
                if (Store.page == 1) {
                    // Back from what a search found is Home; from a category, the categories.
                    root.back-from-results();
                } else {
                    // Back from the apps goes up to the top bar, as on other TV stores.
                    root.enter-bar();
                }
            } else {
                return reject;
            }
            accept
        }

        // ---- top bar ----
        HorizontalLayout {
            x: margin;
            y: top;
            width: parent.width - 2 * margin;
            height: 28 * u;
            spacing: 10 * u;
            Image { width: 20 * u; height: 20 * u; y: 4 * u; source: @image-url("icons/logo.svg"); accessible-role: none; }
            Text { text: "Bilby"; color: Theme.text; font-size: 14 * u; font-weight: 700; vertical-alignment: center; }
            Rectangle { width: 14 * u; }
            TvTab {
                u: root.u;
                text: @tr("Home");
                current: Store.page == 0 && !Store.details-open && !root.cats-open;
                focused: root.zone == 1 && root.tab == 0 && !search.has-focus;
            }
            TvTab {
                u: root.u;
                text: Store.updates-count > 0 ? @tr("Library  ·  {n} update" | "Library  ·  {n} updates" % Store.updates-count) : @tr("Library");
                current: root.on-library;
                focused: root.zone == 1 && root.tab == 1 && !search.has-focus;
                attention: Store.updates-count > 0;
            }
            if root.has-cats : TvTab {
                u: root.u;
                text: @tr("Categories");
                current: root.cats-open && (Store.page == 0 || Store.page == 1) && !Store.details-open;
                focused: root.zone == 1 && root.tab == 5 && !search.has-focus;
            }
            Rectangle { horizontal-stretch: 1; }
            TvTab {
                u: root.u;
                text: @tr("Settings");
                current: root.on-settings;
                focused: root.zone == 1 && root.tab == 3 && !search.has-focus;
            }
            // The device, its updates, and the way back to the desktop layout.
            TvTab {
                u: root.u;
                text: Store.device-name + (Store.system-state == 3 ? "  ·  " + Store.system-headline : "");
                current: root.on-system;
                focused: root.zone == 1 && root.tab == 4 && !search.has-focus;
                attention: Store.system-state == 3;
            }
        }

        // ---- search: the first thing on Home, wide and plain, one press above the apps ----
        Rectangle {
            property <bool> pointed: root.zone == 1 && root.tab == 2 && !Store.details-open;
            property <bool> shown: root.has-search && !Store.details-open;
            visible: self.shown;
            x: margin;
            y: 64 * u;
            width: parent.width - 2 * margin;
            height: 38 * u;
            border-radius: 19 * u;
            background: search.has-focus || self.pointed ? Theme.surface-2 : Theme.surface;
            border-width: search.has-focus || self.pointed ? 2 * u : 0.5 * u;
            border-color: search.has-focus || self.pointed ? white : Theme.stroke;
            accessible-role: button;
            accessible-label: @tr("Search");
            animate background, border-color { duration: Theme.quick; }
            TouchArea {
                clicked => {
                    root.tab = 2;
                    root.activate-tab();
                }
            }
            Image {
                x: 16 * u;
                source: @image-url("icons/search.svg");
                colorize: search.has-focus || parent.pointed ? Theme.text : Theme.text-dim;
                width: 16 * u;
                height: 16 * u;
            }
            if search.text == "" : Text {
                x: 44 * u;
                text: root.osk ? @tr("Pick letters, then choose search") : search.has-focus ? @tr("Type a name, then press OK") : parent.pointed ? @tr("Press OK for the keyboard") : @tr("Search for apps and games");
                color: Theme.text-dim;
                font-size: 15 * u;
                vertical-alignment: center;
            }
            search := TextInput {
                x: 44 * u;
                width: parent.width - 60 * u;
                height: 100%;
                text <=> Store.query;
                color: Theme.text;
                font-size: 15 * u;
                single-line: true;
                vertical-alignment: center;
                accepted => {
                    root.cats-open = false;
                    Store.search(self.text);
                    root.cur-row = 0;
                    root.cur-col = 0;
                    root.zone = 0;
                    scope.focus();
                }
            }
        }

        // ---- this TV: what it runs and whether it is up to date ----
        if root.on-system : FadeIn {
            VerticalLayout {
                x: margin;
                y: 70 * u;
                width: 400 * u;
                spacing: 12 * u;
                alignment: start;
                Text { text: Store.system-name; color: Theme.text; font-size: 30 * u; font-weight: 800; wrap: word-wrap; }
                Text { text: Store.system-tagline; color: Theme.text-dim; font-size: 12 * u; overflow: elide; }
                if Store.system-supported : Text {
                    text: Store.system-headline;
                    color: Store.system-state == 2 && !Store.system-restart ? Theme.ok : Store.system-state == 5 ? Theme.bad : Store.system-state == 3 || Store.system-restart ? Theme.warn : Theme.text;
                    font-size: 20 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if Store.system-detail != "" : Text { text: Store.system-detail; color: Theme.text-dim; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-restart : Text { text: @tr("Restart this TV to finish updating."); color: Theme.warn; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-note != "" : Text { text: Store.system-note; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                if Store.system-state == 4 : VerticalLayout {
                    spacing: 5 * u;
                    Rectangle {
                        height: 6 * u;
                        border-radius: 3 * u;
                        background: Theme.surface-2;
                        accessible-role: progress-indicator;
                        accessible-label: @tr("Installing updates");
                        accessible-value: round(Store.system-progress * 100) + "%";
                        clip: true;
                        // How far is not always known (a whole new image of the system
                        // says only that it is being fetched): then a band travels across.
                        property <bool> unknown: Store.system-progress <= 0.01;
                        property <float> t: mod(animation-tick() / 1.3s, 1.0);
                        Rectangle {
                            x: parent.unknown ? parent.width * (parent.t * 1.4 - 0.4) : 0;
                            width: parent.unknown ? parent.width * 0.4 : parent.width * max(0.02, min(1, Store.system-progress));
                            border-radius: 3 * u;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: (Store.system-progress <= 0.01 ? "" : round(Store.system-progress * 100) + "%" + (Store.system-step != "" ? "  ·  " : "")) + Store.system-step;
                        color: Theme.text-dim;
                        font-size: 11.5 * u;
                        overflow: elide;
                    }
                }
                if Store.system-state == 4 : Text {
                    text: @tr("You may be asked for your password. Keep the TV on until this finishes.");
                    color: Theme.text-dim;
                    font-size: 12 * u;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12 * u;
                    alignment: start;
                    padding-top: 6 * u;
                    if root.sys-can-update && !root.sys-working : TvButton {
                        u: root.u;
                        text: @tr("Update now");
                        primary: true;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 0 && root.sys-act == 0;
                        clicked => { Store.system-update(); }
                    }
                    if root.sys-can-restart && !root.sys-working : TvButton {
                        u: root.u;
                        text: @tr("Restart now");
                        primary: true;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 0 && root.sys-act == 0;
                        clicked => { Store.system-restart-now(); }
                    }
                    if Store.system-supported && !root.sys-working : TvButton {
                        u: root.u;
                        text: @tr("Check again");
                        primary: !root.sys-lead;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 0 && root.sys-act == (root.sys-lead ? 1 : 0);
                        clicked => { Store.system-check(); }
                    }
                    TvButton {
                        u: root.u;
                        text: @tr("Desktop layout");
                        primary: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 0 && root.sys-act == root.sys-last;
                        clicked => { Store.set-interface(1); }
                    }
                }
                if Store.system-updates.length > 0 : VerticalLayout {
                    spacing: 3 * u;
                    padding-top: 8 * u;
                    Text { text: @tr("Waiting to be installed"); color: Theme.text; font-size: 13 * u; font-weight: 700; }
                    for update[i] in Store.system-updates : Text {
                        visible: i < 6;
                        height: i < 6 ? self.preferred-height : 0;
                        text: update.name + "   " + update.change;
                        color: Theme.text-dim;
                        font-size: 12 * u;
                        overflow: elide;
                    }
                    if Store.system-updates.length > 6 : Text { text: @tr("and {} more", Store.system-updates.length - 6); color: Theme.text-dim; font-size: 12 * u; }
                }
            }
            VerticalLayout {
                x: margin + 432 * u;
                y: 70 * u;
                width: parent.width - 2 * margin - 432 * u;
                spacing: 7 * u;
                alignment: start;
                Text { text: @tr("Information"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                for fact in Store.system-facts : HorizontalLayout {
                    spacing: 12 * u;
                    accessible-role: text;
                    accessible-label: fact.name + ": " + fact.value;
                    Text { width: 130 * u; text: fact.name; color: Theme.text-dim; font-size: 12 * u; }
                    Text { horizontal-stretch: 1; text: fact.value; color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                }
            }
        }

        // ---- settings: one list, top to bottom, the focused row always in view ----
        if root.on-settings : FadeIn {
            Text { x: margin; y: 70 * u; text: @tr("Settings"); color: Theme.text; font-size: 36 * u; font-weight: 800; }
            Text {
                x: margin;
                y: 124 * u;
                width: 330 * u;
                text: @tr("Up and Down move through the list. OK changes the highlighted setting. Left is the list of sections.");
                color: Theme.text-dim;
                font-size: 13 * u;
                wrap: word-wrap;
            }
            // The sections, to jump between: the one the highlight is in is marked.
            VerticalLayout {
                x: margin - 8 * u;
                y: 190 * u;
                width: 300 * u;
                spacing: 4 * u;
                alignment: start;
                for name[i] in root.set-names : Rectangle {
                    property <bool> pointed: root.set-nav && root.zone == 0 && i == root.set-at;
                    property <bool> here: i == root.set-in;
                    height: 30 * u;
                    border-radius: 8 * u;
                    background: self.pointed ? Theme.surface-2 : transparent;
                    border-width: self.pointed ? 2 * u : 0;
                    border-color: white;
                    accessible-role: button;
                    accessible-label: name;
                    accessible-action-default => {
                        root.sys-row = root.set-starts[i];
                        root.set-nav = false;
                    }
                    TouchArea {
                        clicked => {
                            root.sys-row = root.set-starts[i];
                            root.set-nav = false;
                            root.zone = 0;
                            scope.focus();
                        }
                    }
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: 3 * u;
                        height: 16 * u;
                        border-radius: 1.5 * u;
                        background: parent.here ? Theme.accent : transparent;
                    }
                    Text {
                        x: 12 * u;
                        width: parent.width - 20 * u;
                        height: parent.height;
                        text: name;
                        color: parent.here || parent.pointed ? Theme.text : Theme.text-dim;
                        font-size: 14 * u;
                        font-weight: parent.here ? 700 : 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle {
                x: margin + 380 * u;
                y: 70 * u;
                width: parent.width - self.x - margin;
                height: parent.height - self.y - 24 * u;
                clip: true;
                VerticalLayout {
                    x: 4 * u;
                    // Moved so that the highlighted row is in the middle of what is shown,
                    // stopping at the list's two ends. It goes by where the row really
                    // is: counting rows left the headings out, and the last section
                    // ended up below the screen.
                    y: -max(0px, min(TvSeen.y + TvSeen.height / 2 - parent.height / 2, self.min-height - parent.height));
                    width: parent.width - 8 * u;
                    height: self.preferred-height;
                    spacing: 7 * u;
                    alignment: start;
                    animate y { duration: Theme.smooth; easing: ease-out; }
                    Text { text: @tr("General"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Ratings and reviews");
                        on: Store.show-ratings;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 1;
                        clicked => { Store.set-ratings(!Store.show-ratings); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Check for updates when Bilby opens");
                        on: Store.check-updates-on-start;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 2;
                        clicked => { Store.set-check-on-start(!Store.check-updates-on-start); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Offer test versions of apps");
                        on: Store.include-prereleases;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 3;
                        clicked => { Store.set-prereleases(!Store.include-prereleases); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Use the desktop layout, for a mouse and keyboard");
                        value: @tr("Switch");
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 4;
                        clicked => { Store.set-interface(1); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Recommend the apps everyone knows, on Home and in searches");
                        on: Store.show-essentials;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 5;
                        clicked => { Store.set-essentials(!Store.show-essentials); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Sounds: a quiet tick as you move about");
                        on: Store.sounds;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 6;
                        clicked => { Store.set-sounds(!Store.sounds); }
                    }
                    TvSetting {
                        u: root.u;
                        label: @tr("Kind of app to offer first when there is a choice");
                        value: Store.prefer-kind == 1 ? @tr("Flatpak") : Store.prefer-kind == 2 ? @tr("AppImage") : Store.prefer-kind == 3 ? @tr("System packages") : @tr("Automatic");
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 7;
                        clicked => { Store.set-prefer-kind(Store.prefer-kind >= 3 ? 0 : Store.prefer-kind + 1); }
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Family and adult content"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Family mode: nothing for adults is shown anywhere");
                        on: Store.family-mode;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 8;
                        clicked => { Store.set-family-mode(!Store.family-mode); }
                    }
                    TvSetting {
                        u: root.u;
                        label: Store.family-mode ? @tr("Adult content on Home (off in Family mode)") : @tr("Adult content on Home, covered until chosen");
                        on: Store.adult-on-home && !Store.family-mode;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 9;
                    }
                    TvSetting {
                        u: root.u;
                        label: Store.family-mode ? @tr("Adult content uncovered (off in Family mode)") : @tr("Show adult content uncovered, with no question");
                        on: Store.adult-uncovered && !Store.family-mode;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 10;
                    }
                    TvSetting {
                        u: root.u;
                        label: Store.has-pin ? @tr("A PIN guards these settings and adult content") : @tr("Set a PIN to guard these settings and adult content");
                        value: Store.has-pin ? @tr("Change") : @tr("Set a PIN");
                        on: Store.has-pin;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 11;
                    }
                    TvSetting {
                        u: root.u;
                        label: Store.has-pin ? @tr("Ask for the PIN to install or remove apps") : @tr("Ask for the PIN to install or remove apps (set a PIN first)");
                        on: Store.pin-for-installs;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 12;
                    }
                    TvSetting {
                        u: root.u;
                        label: Store.has-pin ? @tr("Remove the PIN") : @tr("No PIN is set");
                        value: Store.has-pin ? @tr("Remove") : "—";
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 13;
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("This store"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: Store.store-update != "" ? @tr("Bilby {0} is available. You have {1}", Store.store-update, Store.app-version) : "Bilby " + Store.app-version;
                        value: Store.store-update != "" ? @tr("Update") : @tr("Check for updates");
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 14;
                        clicked => { Store.check-store-update(); }
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Accounts"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: Store.has-token ? @tr("Signed in to GitHub") : Store.signin-state != 0 ? @tr("Signing in to GitHub…") : @tr("Sign in to GitHub for more searches an hour");
                        value: Store.has-token ? @tr("Sign out") : Store.signin-state != 0 ? @tr("Cancel") : @tr("Sign in");
                        on: Store.has-token;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 15;
                    }
                    // The code to enter at GitHub, on a phone or computer.
                    if Store.signin-state == 2 : VerticalLayout {
                        padding-left: 10 * u;
                        spacing: 4 * u;
                        Text { text: @tr("On your phone or computer, open github.com/login/device and enter:"); color: Theme.text; font-size: 12 * u; wrap: word-wrap; }
                        Text {
                            text: Store.signin-code;
                            color: Theme.text;
                            font-size: 30 * u;
                            font-weight: 800;
                            letter-spacing: 3 * u;
                            accessible-label: @tr("Sign-in code {}", Store.signin-code);
                        }
                    }
                    if root.steam-rows > 0 : TvSetting {
                        u: root.u;
                        label: Store.steam-signed-in ? @tr("Signed in to Steam  ·  {}", Store.steam-summary) : Store.steam-state == 3 ? @tr("Scan the code with the Steam app on your phone") : Store.steam-state != 0 ? @tr("Sign in on Steam's page in Longboard, then share your library") : @tr("Sign in to Steam with a QR code, to see what you own");
                        value: Store.steam-state != 0 ? @tr("Cancel") : Store.steam-signed-in ? @tr("Sign out") : @tr("Show code");
                        on: Store.steam-signed-in;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 16;
                    }
                    if root.steam-rows > 1 : TvSetting {
                        u: root.u;
                        label: @tr("Or sign in to Steam in a browser (Longboard)");
                        value: @tr("Open");
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == 17;
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Where apps come from"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    for source[i] in Store.sources : TvSetting {
                        u: root.u;
                        label: source.label;
                        on: source.on;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.src-first + i;
                        clicked => { Store.set-source(source.id, !source.on); }
                    }
                    Rectangle { height: 4 * u; }
                    // In English as well, always: findable in a language one cannot read.
                    Text { text: @tr("Language") == "Language" ? "Language" : @tr("Language") + "  ·  Language"; color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Press OK for the next language");
                        value: Store.language-name;
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.lang-row;
                        clicked => { Store.next-language(); }
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Country for prices"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Press Left or Right for another country");
                        value: Store.country-name;
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.country-row;
                        clicked => { Store.step-country(true); }
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Other devices"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Also show apps that do not run on this device");
                        on: Store.show-everything;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.all-row;
                        clicked => { Store.set-show-everything(!Store.show-everything); }
                    }
                    if Store.windows-possible : TvSetting {
                        u: root.u;
                        label: @tr("Offer Windows apps, set up to run here through Proton");
                        on: Store.windows-apps;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.win-row;
                        clicked => { Store.set-windows-apps(!Store.windows-apps); }
                    }
                    if root.proton-row > 0 : TvSetting {
                        u: root.u;
                        label: @tr("Proton version for Windows apps");
                        value: Store.windows-proton == 1 ? @tr("GE-Proton") : @tr("Standard");
                        on: false;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.proton-row;
                        clicked => { Store.set-windows-proton(1 - Store.windows-proton); }
                    }
                    Rectangle { height: 4 * u; }
                    Text { text: @tr("Updates"); color: Theme.text; font-size: 14 * u; font-weight: 700; }
                    TvSetting {
                        u: root.u;
                        label: @tr("Update apps automatically");
                        on: Store.auto-update;
                        focused: root.zone == 0 && !root.set-nav && root.sys-row == root.auto-row;
                        clicked => { Store.set-auto-update(!Store.auto-update); }
                    }
                    Rectangle { height: 8 * u; }
                }
            }
            // Signing in to Steam with a code: the whole screen, so a phone across the
            // room can read it. Back or OK stops.
            if Store.steam-state == 3 : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                background: Theme.bg;
                TouchArea { }
                HorizontalLayout {
                    alignment: center;
                    spacing: 40 * u;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 280 * u;
                            height: 280 * u;
                            border-radius: 14 * u;
                            background: white;
                            accessible-role: AccessibleRole.image;
                            accessible-label: @tr("QR code to scan with the Steam app");
                            Image {
                                width: 256 * u;
                                height: 256 * u;
                                source: Store.steam-qr;
                                image-rendering: pixelated;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 10 * u;
                        width: 380 * u;
                        Text { text: @tr("Sign in to Steam"); color: Theme.text; font-size: 30 * u; font-weight: 800; }
                        Text { text: @tr("Open the Steam app on your phone, scan this code and approve the sign-in there."); color: Theme.text; font-size: 15 * u; wrap: word-wrap; }
                        Text { text: Store.steam-qr-scanned ? @tr("Scanned. Approve it in the Steam app.") : @tr("Waiting for the Steam app…"); color: Theme.accent; font-size: 15 * u; font-weight: 700; }
                        Text { text: @tr("Steam gives Bilby a key to your account. Bilby uses it once to read what you own, then throws it away."); color: Theme.text-dim; font-size: 12 * u; wrap: word-wrap; }
                        Text { text: @tr("Press Back to stop."); color: Theme.text-dim; font-size: 12 * u; }
                    }
                }
            }
        }

        // ---- home: the focused app in large type, rows of apps below ----
        // ---- categories: every kind of app there is, on a page of their own ----
        if root.on-cats : FadeIn {
            Text {
                x: margin;
                y: 70 * u;
                text: @tr("Categories");
                color: Theme.text;
                font-size: 30 * u;
                font-weight: 800;
            }
            Rectangle {
                y: 122 * u;
                height: parent.height - self.y;
                clip: true;
                Rectangle {
                    // Rows below the fifth push the page up, so the one pointed at is on screen.
                    y: 8 * u - max(0, floor(root.cat-at / 4) - 4) * 74 * u;
                    animate y { duration: 220ms; easing: ease-out; }
                    for kind[i] in Store.tv-categories : TvKind {
                        x: margin + Math.mod(i, 4) * (tile-w + tile-gap);
                        y: floor(i / 4) * 74 * u;
                        width: tile-w;
                        height: 58 * u;
                        u: root.u;
                        kind: kind;
                        focused: root.zone == 0 && i == root.cat-at;
                        clicked => { root.open-category(i); }
                    }
                }
            }
        }

        if !Store.details-open && !root.on-system && !root.on-settings && !root.on-cats : FadeIn {
            VerticalLayout {
                x: margin;
                y: (root.has-search ? 110 : 74) * u;
                width: 520 * u;
                height: (root.has-search ? 106 : 140) * u;
                spacing: 5 * u;
                alignment: start;
                Text { text: current.name; color: Theme.text; font-size: (root.has-search ? 28 : 36) * u; font-weight: 800; overflow: elide; }
                Text { text: current.summary; color: Theme.text; font-size: 14 * u; wrap: word-wrap; }
                Text {
                    text: current.id == "" ? "" : (current.has-update ? @tr("Update available") + "  ·  " : current.installed ? @tr("Installed") + "  ·  " : "") + (current.rating != "" ? "★ " + current.rating + " (" + current.rating-count + ")  ·  " : current.headline != "" ? current.headline + "  ·  " : "") + current.author;
                    color: current.has-update || current.installed ? Theme.accent : Theme.text-dim;
                    font-size: 12 * u;
                }
                if rows.length == 0 && Store.searching : Busy {
                    width: 360 * u;
                    height: 4 * u;
                }
                if rows.length == 0 : Text {
                    text: Store.searching ? @tr("Searching…") : root.on-library ? @tr("Apps you install with Bilby show up here, and so do your favourites.") : @tr("Nothing for this TV yet. Press Up to search.");
                    wrap: word-wrap;
                    color: Theme.text-dim;
                    font-size: 14 * u;
                }
            }
            // The library's own buttons, beside the focused app.
            if root.lib-has-actions : HorizontalLayout {
                x: margin + 548 * u;
                y: 78 * u;
                spacing: 12 * u;
                alignment: start;
                if root.lib-can-update-all : TvButton {
                    u: root.u;
                    text: @tr("Update all");
                    primary: true;
                    focused: root.zone == 2 && root.lib-act == 0;
                    clicked => { Store.update-all(); }
                }
                TvButton {
                    u: root.u;
                    text: Store.checking-updates ? @tr("Checking…") : @tr("Check for updates");
                    primary: !root.lib-can-update-all;
                    focused: root.zone == 2 && root.lib-act == (root.lib-can-update-all ? 1 : 0);
                    clicked => { Store.check-updates(); }
                }
            }
            // A search that failed says why (GitHub's allowance used up, no connection)
            // in place of the note about what was found.
            if (Store.search-note != "" || Store.search-error != "") && !root.on-library : Text {
                x: margin;
                y: 218 * u;
                width: parent.width - 2 * margin;
                text: Store.search-error != "" && !Store.searching ? Store.search-error : Store.search-note;
                color: Store.search-error != "" && !Store.searching ? Theme.warn : Theme.text-dim;
                font-size: 12 * u;
                overflow: elide;
            }
            Rectangle {
                y: 240 * u;
                height: parent.height - self.y;
                clip: true;
                Rectangle {
                    y: 4 * u - root.cur-row * row-h;
                    height: rows.length * row-h;
                    animate y { duration: 220ms; easing: ease-out; }
                    for section[r] in rows : Rectangle {
                        property <int> n: section.apps.length;
                        // Keep the focused tile in view: scroll once it passes the third column.
                        property <int> shift: r == root.cur-row ? max(0, root.cur-col - 2) : 0;
                        y: r * row-h;
                        height: row-h;
                        opacity: r < root.cur-row ? 0 : 1;
                        animate opacity { duration: 160ms; }
                        Text {
                            x: margin;
                            y: 0;
                            height: 20 * u;
                            text: section.title;
                            color: r == root.cur-row ? Theme.text : Theme.text-dim;
                            font-size: 13 * u;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            x: margin - shift * (tile-w + tile-gap);
                            y: 28 * u;
                            height: tile-h;
                            width: n * (tile-w + tile-gap);
                            animate x { duration: 200ms; easing: ease-out; }
                            for app[c] in section.apps : TvTile {
                                x: c * (tile-w + tile-gap);
                                width: tile-w;
                                height: tile-h;
                                u: root.u;
                                app: app;
                                // Only the tiles on or beside the screen are drawn. A long
                                // row would otherwise be drawn in full, most of it far off
                                // to the right, which is slow and, past some seventy
                                // tiles, further than the software renderer can count.
                                visible: c >= shift - 3 && c <= shift + 8;
                                focused: root.zone == 0 && r == root.cur-row && c == root.cur-col && !search.has-focus;
                                clicked => {
                                    root.cur-row = r;
                                    root.cur-col = c;
                                    root.zone = 0;
                                    scope.focus();
                                    Store.open(app.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- app page: what it is and one button on the left, pictures on the right ----
        if Store.details-open : FadeIn {
          page := Rectangle {
            x: 0;
            y: 66 * u;
            width: parent.width;
            height: parent.height - self.y;
            clip: true;
            // How far down each section starts, so the one highlighted is brought up.
            property <length> head-h: head.preferred-height + 14 * u;
            property <length> pics-h: root.has-pics ? 156 * u : 0;
            property <length> about-h: root.has-about ? 158 * u : 0;
            property <length> revs-h: root.has-reviews ? 176 * u : root.can-review ? 50 * u : 0;
            property <length> wanted: root.sec == 0 || root.files ? 0 : (root.sec == 1 ? self.head-h : root.sec == 2 ? self.head-h + self.pics-h : root.sec == 3 ? self.head-h + self.pics-h + self.about-h : self.head-h + self.pics-h + self.about-h + self.revs-h) - 56 * u;
            property <length> shift: max(0, min(self.wanted, column.preferred-height - self.height + 20 * u));
           column := VerticalLayout {
            x: margin;
            y: 4 * u - page.shift;
            width: parent.width - 2 * margin;
            height: self.preferred-height;
            spacing: 14 * u;
            alignment: start;
            animate y { duration: Theme.smooth; easing: ease-out; }
            head := VerticalLayout {
                // Narrower beside the open list of choices, so nothing runs under it.
                width: root.files ? 440 * u : 760 * u;
                spacing: 9 * u;
                alignment: start;
                HorizontalLayout {
                    spacing: 14 * u;
                    alignment: start;
                    AppIcon { initials: Store.app.initials; tint: Store.app.tint; icon: Store.app.icon; size: 60 * u; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2 * u;
                        Text { text: Store.app.name; color: Theme.text; font-size: 28 * u; font-weight: 800; overflow: elide; }
                        Text { text: Store.app.author + (Store.app.verified ? "  ✓ " + @tr("verified") : ""); color: Theme.text-dim; font-size: 12 * u; overflow: elide; }
                    }
                }
                Text { text: Store.app.summary; color: Theme.text; font-size: 14 * u; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 24 * u;
                    alignment: start;
                    if Store.app.rating != "" : TvStat { u: root.u; value: "★ " + Store.app.rating; caption: Store.app.rating-count; }
                    if Store.app.price != "" : TvStat { u: root.u; value: Store.app.price; caption: @tr("on {}", Store.app.source); }
                    if Store.app.downloads != "" : TvStat { u: root.u; value: Store.app.downloads; caption: Store.app.downloads-note; }
                    // The row has room for four: with a rating and downloads, the source's own count waits.
                    if Store.app.popularity != "" && !(Store.app.rating != "" && Store.app.downloads != "") : TvStat { u: root.u; value: Store.app.popularity; caption: @tr("on {}", Store.app.source); }
                    if Store.options.length > 0 && Store.options[0].size != "" : TvStat { u: root.u; value: Store.options[0].size; caption: @tr("download"); }
                    if Store.release-age != "" : TvStat { u: root.u; value: Store.release-age; caption: @tr("last updated"); }
                }
                Text {
                    text: root.remove-armed ? @tr("Press OK again to remove {} from this TV", Store.app.name) : Store.details-loading ? @tr("Checking what works on this TV…") : Store.details-error != "" ? @tr("{}  Press OK to try again.", Store.details-error) : Store.unavailable != "" ? Store.unavailable : Store.install-state == 1 ? @tr("Downloading…  {}%", round(Store.install-progress * 100)) : Store.install-state >= 2 ? Store.install-message : root.outside ? (Store.outside-change != "" ? @tr("Update available  ·  {}", Store.outside-change) : @tr("Update available")) : root.is-update ? @tr("Update available: you have {}", Store.installed-version) : Store.installed-version == "installed" ? @tr("Installed") : Store.installed-version != "" ? @tr("Installed  ·  {}", Store.installed-version) : Store.is-website ? @tr("Opens in Longboard, driven with your remote") : Store.options.length > 0 && Store.options[0].verified ? @tr("Bilby checks the download is the genuine file") : "";
                    color: Store.details-error != "" || Store.install-state == 3 ? Theme.bad : Store.unavailable != "" || root.remove-armed ? Theme.warn : Store.install-state == 1 ? Theme.accent : Theme.ok;
                    font-size: 12 * u;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if Store.warning != "" : Text { text: Store.warning; color: Theme.warn; font-size: 12 * u; wrap: word-wrap; }
                if Store.need-note != "" : Text { text: Store.need-note; color: Theme.warn; font-size: 12 * u; wrap: word-wrap; }
                if !Store.details-loading : HorizontalLayout {
                    padding-top: 4 * u;
                    spacing: 8 * u;
                    alignment: start;
                    if root.main-action != "" || Store.details-error != "" : TvButton {
                        u: root.u;
                        text: Store.details-error != "" ? @tr("Try again") : root.main-action;
                        progress: root.busy ? Store.install-progress : -1;
                        primary: true;
                        focused: root.act == 0 && !root.files && !root.reading && root.sec == 0 && root.zone != 1;
                        clicked => {
                            root.act = 0;
                            root.press-main();
                        }
                    }
                    TvButton {
                        u: root.u;
                        text: Store.is-favourite ? @tr("★  In favourites") : @tr("☆  Favourite");
                        focused: (root.act == 1 || (root.act == 0 && root.main-action == "" && Store.details-error == "")) && !root.files && !root.reading && root.sec == 0 && root.zone != 1;
                        clicked => {
                            root.act = 1;
                            Store.toggle-favourite();
                        }
                    }
                    // The list it opens holds the other ways to use the service and the
                    // other sources, then this release's files. A website has no files,
                    // and still has the button when there is another way to use it.
                    if root.has-files : TvButton {
                        u: root.u;
                        text: root.choices == 0 ? @tr("Versions and files") : root.nfiles == 0 && Store.app-family.length > 0 ? @tr("Other ways to use {}", Store.app-family-name) : @tr("More choices");
                        focused: root.act == 2 && !root.files && !root.reading && root.sec == 0 && root.zone != 1;
                        clicked => {
                            root.act = 2;
                            root.opt = 0;
                            root.reading = false;
                            root.files = true;
                        }
                    }
                    if root.has-helper : TvButton {
                        u: root.u;
                        text: Store.helper-label;
                        focused: root.act == root.helper-idx && !root.files && !root.reading && root.sec == 0 && root.zone != 1;
                        clicked => {
                            root.act = root.helper-idx;
                            Store.open(Store.helper-id);
                        }
                    }
                    if root.removable : TvButton {
                        u: root.u;
                        text: root.remove-armed ? @tr("Confirm") : Store.in-library ? @tr("Remove") : @tr("Uninstall");
                        focused: root.act == root.remove-idx && !root.files && !root.reading && root.sec == 0 && root.zone != 1;
                        clicked => {
                            root.act = root.remove-idx;
                            if (root.remove-armed) {
                                root.remove-armed = false;
                                Store.remove-from-library(Store.app.id);
                            } else {
                                root.remove-armed = true;
                            }
                        }
                    }
                }
            }

            // ---- pictures: a row of small ones; OK shows the highlighted one large ----
            if root.has-pics && !root.files : VerticalLayout {
                spacing: 8 * u;
                Text { text: @tr("Pictures"); color: root.sec == 1 ? Theme.text : Theme.text-dim; font-size: 13 * u; font-weight: 700; }
                Rectangle {
                    height: 118 * u;
                    clip: true;
                    Rectangle {
                        x: -max(0, root.pic - 3) * 212 * u;
                        width: Store.screenshots.length * 212 * u;
                        animate x { duration: Theme.smooth; easing: ease-out; }
                        for shot[i] in Store.screenshots : Rectangle {
                            property <bool> focused: root.sec == 1 && root.pic == i;
                            x: i * 212 * u + 3 * u;
                            y: 3 * u;
                            width: 200 * u;
                            height: 112 * u;
                            border-radius: 8 * u;
                            clip: true;
                            background: Theme.surface;
                            accessible-role: button;
                            accessible-label: @tr("Picture {0} of {1}", i + 1, Store.screenshots.length);
                            accessible-action-default => {
                                root.sec = 1;
                                root.pic = i;
                                root.viewer = true;
                            }
                            Image { width: parent.width; height: parent.height; source: shot; image-fit: cover; }
                            Rectangle { border-radius: 8 * u; border-width: parent.focused ? 3 * u : 0.5 * u; border-color: parent.focused ? white : Theme.stroke; }
                            TouchArea {
                                clicked => {
                                    root.sec = 1;
                                    root.pic = i;
                                    root.viewer = true;
                                }
                            }
                        }
                    }
                }
            }
            // ---- the description: a few lines; OK opens it to read and follow links ----
            if root.has-about && !root.files : Rectangle {
                property <bool> focused: root.sec == 2;
                // As tall as its words, up to five lines of them.
                height: about-box.height + 48 * u;
                border-radius: 10 * u;
                background: self.focused ? Theme.surface-2 : Theme.surface;
                border-width: self.focused ? 2 * u : 0.5 * u;
                border-color: self.focused ? white : Theme.stroke;
                accessible-role: button;
                accessible-label: @tr("Description");
                accessible-action-default => {
                    root.sec = 2;
                    root.about-scroll = 0;
                    root.link = 0;
                    root.about-open = true;
                }
                TouchArea {
                    clicked => {
                        root.sec = 2;
                        root.about-scroll = 0;
                        root.link = 0;
                        root.about-open = true;
                    }
                }
                Text { x: 14 * u; y: 10 * u; text: @tr("About"); color: Theme.text; font-size: 13 * u; font-weight: 700; }
                Text {
                    x: parent.width - self.width - 14 * u;
                    y: 10 * u;
                    text: Store.about-links.length > 0 ? @tr("{n} link" | "{n} links" % Store.about-links.length) + "   ›" : "›";
                    color: parent.focused ? Theme.accent : Theme.text-dim;
                    font-size: 12 * u;
                    font-weight: 600;
                }
                about-box := Rectangle {
                    about-line := Text { text: "X"; font-size: 13 * u; visible: false; }
                    x: 14 * u;
                    y: 34 * u;
                    width: parent.width - 28 * u;
                    height: min(about-words.preferred-height, floor(100 * u / about-line.preferred-height) * about-line.preferred-height);
                    clip: true;
                    about-words := Text {
                        y: 0;
                        width: parent.width;
                        text: Store.about != "" ? Store.about : Store.notes;
                        color: Theme.text;
                        font-size: 13 * u;
                        wrap: word-wrap;
                        vertical-alignment: TextVerticalAlignment.top;
                    }
                }
            }
            // ---- reviews: a row of them; OK reads the highlighted one in full ----
            if (root.has-reviews || root.can-review) && !root.files : VerticalLayout {
                spacing: 8 * u;
                HorizontalLayout {
                    alignment: start;
                    spacing: 14 * u;
                    Text { text: @tr("Reviews") + (Store.app.rating != "" ? "   ★ " + Store.app.rating + "   " + Store.app.rating-count : ""); color: root.sec == 3 ? Theme.text : Theme.text-dim; font-size: 13 * u; font-weight: 700; vertical-alignment: center; }
                    if root.can-review : TvButton {
                        u: root.u;
                        text: @tr("Write a review");
                        focused: root.on-write && !root.writing && root.zone != 1;
                        accessible-role: button;
                        accessible-label: self.text;
                        accessible-action-default => { root.w-open(); }
                        clicked => { root.w-open(); }
                    }
                }
                if root.has-reviews : Rectangle {
                    height: 138 * u;
                    clip: true;
                    Rectangle {
                        x: -max(0, root.rev - 2) * 292 * u;
                        width: Store.reviews.length * 292 * u;
                        animate x { duration: Theme.smooth; easing: ease-out; }
                        for review[i] in Store.reviews : Rectangle {
                            property <bool> focused: root.sec == 3 && root.rev == i;
                            x: i * 292 * u + 3 * u;
                            y: 3 * u;
                            width: 280 * u;
                            height: 132 * u;
                            border-radius: 10 * u;
                            background: self.focused ? Theme.surface-2 : Theme.surface;
                            border-width: self.focused ? 2 * u : 0.5 * u;
                            border-color: self.focused ? white : Theme.stroke;
                            clip: true;
                            accessible-role: button;
                            accessible-label: @tr("Review: {}", review.title);
                            accessible-action-default => {
                                root.sec = 3;
                                root.rev = i;
                                root.reading = true;
                            }
                            TouchArea {
                                clicked => {
                                    root.sec = 3;
