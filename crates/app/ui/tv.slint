                    color: Store.details-error != "" || Store.install-state == 3 ? Theme.bad : Store.unavailable != "" || root.remove-armed ? Theme.warn : Store.install-state == 1 ? Theme.accent : Theme.ok;
                    font-size: 12 * u;
