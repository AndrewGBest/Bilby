                                clicked => {
                                    root.sec = 3;
                                    root.rev = i;
                                    root.reading = true;
                                }
                            }
                            VerticalLayout {
                                padding: 12 * u;
                                spacing: 4 * u;
                                alignment: start;
                                Text { text: review.stars; color: Theme.warn; font-size: 12 * u; }
                                Text { text: review.title; color: Theme.text; font-size: 13 * u; font-weight: 700; overflow: elide; }
                                Rectangle {
                                    height: 52 * u;
                                    clip: true;
                                    Text { y: 0; width: parent.width; text: review.text; color: Theme.text; font-size: 12 * u; wrap: word-wrap; vertical-alignment: TextVerticalAlignment.top; }
                                }
                                Text { text: review.meta; color: Theme.text-dim; font-size: 11 * u; overflow: elide; }
                            }
                        }
                    }
                }
            }
