                if Store.app.author != "" && Store.app.author != Store.app.source : TvFact { u: root.u; name: "Made by"; value: Store.app.author + (Store.app.verified ? " (confirmed by " + Store.app.source + ")" : ""); }
                if Store.app.price != "" : TvFact { u: root.u; name: "Price"; value: Store.app.price + " on " + Store.app.source; }
                if Store.app.downloads != "" : TvFact { u: root.u; name: "Downloads"; value: Store.app.downloads + " " + Store.app.downloads-note; }
                if Store.app.popularity != "" : TvFact { u: root.u; name: "Popularity"; value: Store.app.popularity + " on " + Store.app.source; }
                if Store.app.version != "" : TvFact { u: root.u; name: "Version"; value: Store.app.version; }
                if Store.release-date != "" : TvFact { u: root.u; name: "Released"; value: Store.release-date; }
                if Store.license != "" : TvFact { u: root.u; name: "Licence"; value: Store.license; }
                if Store.options.length > 0 : TvFact { u: root.u; name: "Works on"; value: Store.platform-title; }
                if Store.options.length > 0 : TvFact { u: root.u; name: "Kind of file"; value: Store.options[0].label; }
