# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,toml}]
indent_size = 2

# The translations are written by scripts/i18n.py with one space of indent.
[crates/app/i18n/*.json]
indent_size = 1

[*.md]
max_line_length = 90
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.po]
trim_trailing_whitespace = false
